                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L",
                "fixed_version": "1.78",
                "purls": [
                  "pkg:maven/org.bouncycastle/bcprov-jdk15on@1.70"
