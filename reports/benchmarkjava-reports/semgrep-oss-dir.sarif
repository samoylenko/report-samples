epth mechanisms such as the `sameSite` cookie flag can help prevent CSRF. For more information, see: [Cross-site request forgery prevention](https://cheatsheetseries.owasp.org/cheatsheets/Cross- Site_Request_Forgery_Prevention_Cheat_Sheet.html)"},"properties":{},"ruleId":"java.servlets.security.audit.cookie-missing-samesite.cookie-missing-samesite"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java:54 to src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java:73"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'request.getCookies()' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java:54'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java"},"region":{"endColumn":70,"endLine":54,"message":{"text":"Source: 'request.getCookies()' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java:54'"},"snippet":{"text":"request.getCookies()"},"startColumn":50,"startLine":54}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'theCookies' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java:54'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java"},"region":{"endColumn":47,"endLine":54,"message":{"text":"Propagator : 'theCookies' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java:54'"},"snippet":{"text":"theCookies"},"startColumn":37,"startLine":54}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'theCookie' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java:58'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java"},"region":{"endColumn":53,"endLine":58,"message":{"text":"Propagator : 'theCookie' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01000.java:58'"},"