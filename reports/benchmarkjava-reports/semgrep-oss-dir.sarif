ssage":{"text":"Detected a potential path traversal. A malicious actor could control the location of this file, to include going backwards in the directory with '../'. To address this, ensure that user-controlled variables in file paths are sanitized. You may also consider using a utility method such as org.apache.commons.io.FilenameUtils.getName(...) to only retrieve the file name from the path."},"properties":{},"ruleId":"java.lang.security.httpservlet-path-traversal.httpservlet-path-traversal"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java:59 to src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java:67"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'theCookie.getValue()' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java:59'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java"},"region":{"endColumn":76,"endLine":59,"message":{"text":"Source: 'theCookie.getValue()' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java:59'"},"snippet":{"text":"theCookie.getValue()"},"startColumn":56,"startLine":59}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'param' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java:59'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java"},"region":{"endColumn":26,"endLine":59,"message":{"text":"Propagator : 'param' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java:59'"},"snippet":{"text":"param"},"startColumn":21,"startLine":59}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'bar' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java:65'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00949.java"},"region":{"endColumn":19,"end