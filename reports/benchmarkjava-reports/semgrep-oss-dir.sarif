writing files. To prevent this vulnerability, validate and sanitize any input that is used to create references to file paths. Also, enforce strict file access controls. For example, choose privileges allowing public-facing applications to access only the required files. In Java, you may also consider using a utility method such as `org.apache.commons.io.FilenameUtils.getName(...)` to only retrieve the file name from the path."},"properties":{},"ruleId":"java.servlets.security.httpservlet-path-traversal-deepsemgrep.httpservlet-path-traversal-deepsemgrep"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01034.java:35 to src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01034.java:72"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'request' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01034.java:35'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01034.java"},"region":{"endColumn":23,"endLine":35,"message":{"text":"Source: 'request' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01034.java:35'"},"snippet":{"text":"request"},"startColumn":16,"startLine":35}}},"nestingLevel":0},{"location":{"message":{"text":"Sink: 'fos = null;' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01034.java:72'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01034.java"},"region":{"endColumn":31,"endLine":72,"message":{"text":"Sink: 'fos = null;' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01034.java:72'"},"snippet":{"text":"                    fos = null;"},"startColumn":21,"startLine":72}}},"nestingLevel":1}]}]}],"fingerprints":{"matchBasedId/v1":"0bd79004a92103fed136ace4805a97113d66e8ad3cc55f58596ff1ae2d5adea2d11b0ea4185f7e5fe722701ab50b1b5450d67ae28aa0ffe95f12cfc30b7d6636_1"},"locations":[{"physicalLocation":{"artifactLocation":{"