er hash function applications."},"properties":{},"ruleId":"java.lang.security.audit.crypto.use-of-sha1.use-of-sha1"},{"fingerprints":{"matchBasedId/v1":"014d384247cdcbe0a27e0eff75d14a081e54bdc5ff1650a70cd4771a0984f14534a492f21f6437e072aa784a01217acf124bb9ee72b6ef6b1b02eed2371cba43_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01911.java","uriBaseId":"%SRCROOT%"},"region":{"endColumn":77,"endLine":61,"snippet":{"text":"                md = java.security.MessageDigest.getInstance(\"SHA1\", \"SUN\");"},"startColumn":17,"startLine":61}}}],"message":{"text":"Detected SHA1 hash algorithm which is considered insecure. SHA1 is not collision resistant and is therefore not suitable as a cryptographic signature. Instead, use PBKDF2 for password hashing or SHA256 or SHA512 for other hash function applications."},"properties":{},"ruleId":"java.lang.security.audit.crypto.use-of-sha1.use-of-sha1"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01914.java:45 to src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01914.java:57"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'request.getHeader(\"Referer\")' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01914.java:45'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01914.java"},"region":{"endColumn":49,"endLine":45,"message":{"text":"Source: 'request.getHeader(\"Referer\")' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01914.java:45'"},"snippet":{"text":"request.getHeader(\"Referer\")"},"startColumn":21,"startLine":45}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'param' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01914.java:45'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01914.java"},"region"