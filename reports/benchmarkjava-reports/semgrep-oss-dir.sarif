eges allowing public-facing applications to access only the required files. In Java, you may also consider using a utility method such as `org.apache.commons.io.FilenameUtils.getName(...)` to only retrieve the file name from the path."},"properties":{},"ruleId":"java.servlets.security.httpservlet-path-traversal.httpservlet-path-traversal"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java:44 to src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java:57"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'request.getParameterMap()' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java:44'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java"},"region":{"endColumn":72,"endLine":44,"message":{"text":"Source: 'request.getParameterMap()' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java:44'"},"snippet":{"text":"request.getParameterMap()"},"startColumn":47,"startLine":44}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'map' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java:44'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java"},"region":{"endColumn":44,"endLine":44,"message":{"text":"Propagator : 'map' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java:44'"},"snippet":{"text":"map"},"startColumn":41,"startLine":44}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'values' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java:47'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java"},"region":{"endColumn":28,"endLine":47,"message":{"text":"Propagator : 'values' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00028.java:47'"},"snippet":{"text":"valu