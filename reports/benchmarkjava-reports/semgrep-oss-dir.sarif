f73cb45ba74b3b01d83db0d8043185e6305aa78eaaab05ec3539ed4dd96c40feceb78491ee674af867fa_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java","uriBaseId":"%SRCROOT%"},"region":{"endColumn":40,"endLine":42,"snippet":{"text":"        response.addCookie(userCookie);"},"startColumn":9,"startLine":42}}}],"message":{"text":"A cookie was detected without setting the 'HttpOnly' flag. The 'HttpOnly' flag for cookies instructs the browser to forbid client-side scripts from reading the cookie. Set the 'HttpOnly' flag by calling 'cookie.setHttpOnly(true);'"},"properties":{},"ruleId":"java.lang.security.audit.cookie-missing-httponly.cookie-missing-httponly"},{"fingerprints":{"matchBasedId/v1":"198707f1daea3f895f714495240fba17a70e51915c74c8fbbb7d9ab1e9386bd05beb227858fcdbe1e762d959e5392a10e5bb6eed27a8bcec842a33efa69f0cf9_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java","uriBaseId":"%SRCROOT%"},"region":{"endColumn":40,"endLine":42,"snippet":{"text":"        response.addCookie(userCookie);"},"startColumn":9,"startLine":42}}}],"message":{"text":"A cookie was detected without setting the 'HttpOnly' flag. The 'HttpOnly' flag for cookies instructs the browser to forbid client-side scripts from reading the cookie. Set the 'HttpOnly' flag by calling 'cookie.setHttpOnly(true);'"},"properties":{},"ruleId":"java.servlets.security.audit.cookie-missing-httponly.cookie-missing-httponly"},{"fingerprints":{"matchBasedId/v1":"126decc57e1136b34340d88ebb0dcd266d737ddbde11ec78c09bd8c6b907a5ae63c92c8647d2beedac36517e566703c68af05d299a8aeaf9f531ee6234ab6843_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java","uriBaseId":"%SRCROOT%"},"region":{"endColumn":40,"endLine":42,"snippet":{"text":"        response.addCookie(userCookie);"},"startColumn":9,"startLine":42}}}],"message":{"text":"The application does not appear to verify inbound requests which can lead to a Cross-site request forgery (CSRF) vulnerability. If the application uses cookie-based authentication, an attacker can trick users into sending authenticated HTTP requests without their knowledge from any arbitrary domain they visit. To prevent this vulnerability start by identifying if the framework or library leveraged has built-in features or offers plugins for CSRF protection. CSRF tokens should be unique and securely random. The `Synchronizer Token` or `Double Submit Cookie` patterns with defense-in- depth mechanisms such as the `sameSite` cookie flag can help prevent CSRF. For more information, see: [Cross-site request forgery prevention](https://cheatsheetseries.owasp.org/cheatsheets/Cross- Site_Request_Forgery_Prevention_Cheat_Sheet.html)"},"properties":{},"ruleId":"java.servlets.security.audit.cookie-missing-samesite.cookie-missing-samesite"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java:59 to src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java:72"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'theCookie.getValue()' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java:59'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java"},"region":{"endColumn":76,"endLine":59,"message":{"text":"Source: 'theCookie.getValue()' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java:59'"},"snippet":{"text":"theCookie.getValue()"},"startColumn":56,"startLine":59}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'param' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java:59'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest01838.java"},"region":{"endColumn":26,"endLine":59,"message"