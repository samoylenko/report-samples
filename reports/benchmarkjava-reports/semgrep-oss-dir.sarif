 a utility method such as `org.apache.commons.io.FilenameUtils.getName(...)` to only retrieve the file name from the path."},"properties":{},"ruleId":"java.servlets.security.httpservlet-path-traversal-deepsemgrep.httpservlet-path-traversal-deepsemgrep"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02027.java:35 to src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02027.java:55"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'request' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02027.java:35'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02027.java"},"region":{"endColumn":23,"endLine":35,"message":{"text":"Source: 'request' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02027.java:35'"},"snippet":{"text":"request"},"startColumn":16,"startLine":35}}},"nestingLevel":0},{"location":{"message":{"text":"Sink: 'java.io.File fileTarget =\n                new java.io.File(org.owasp.benchmark.helpers.Utils.TESTFILES_DIR, bar);' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02027.java:55'"},"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02027.java"},"region":{"endColumn":87,"endLine":56,"message":{"text":"Sink: 'java.io.File fileTarget =\n                new java.io.File(org.owasp.benchmark.helpers.Utils.TESTFILES_DIR, bar);' @ 'src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02027.java:55'"},"snippet":{"text":"        java.io.File fileTarget =\n                new java.io.File(org.owasp.benchmark.helpers.Utils.TESTFILES_DIR, bar);"},"startColumn":22,"startLine":55}}},"nestingLevel":1}]}]}],"fingerprints":{"matchBasedId/v1":"e3b1c8de1ccb742550886c36475f0d66d57e48b7d0312a1ec7eb8ae2214393fc2a3ff61d4e8708db627b28ba83d8bb50062e81b813b24a6c5202ec57306f9375_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/m