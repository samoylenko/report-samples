            {
              "id": "CVE-2023-28321",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-28321"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2023-28321?s=debian&n=curl&ns=debian&t=deb&osn=debian&osv=11&vr=%3C7.74.0-1.3%2Bdeb11u9",
              "help": {
                "text": "An improper certificate validation vulnerability exists in curl <v8.1.0 in the way it supports matching of wildcard patterns when listed as \"Subject Alternative Name\" in TLS server certificates. curl can be built to use its own name matching function for TLS rather than one provided by a TLS library. This private wildcard matching function would match IDN (International Domain Name) hosts incorrectly and could as a result accept patterns that otherwise should mismatch. IDN hostnames are converted to puny code before used for certificate checks. Puny coded names always start with `xn--` and should not be allowed to pattern match, but the wildcard check in curl could still check for `x*`, which would match even though the IDN name most likely contained nothing even resembling an `x`.\n\n---\n- curl 7.88.1-10 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1036239)\n[bullseye] - curl 7.74.0-1.3+deb11u9\nhttps://curl.se/docs/CVE-2023-28321.html\nIntroduced by: https://github.com/curl/curl/commit/9631fa740708b1890197fad01e25b34b7e8eb80e (curl-7_12_0)\nFixed by: https://github.com/curl/curl/commit/199f2d440d8659b42670c1b796220792b01a97bf (curl-8_1_0)\n",
                "markdown": "> An improper certificate validation vulnerability exists in curl <v8.1.0 in the way it supports matching of wildcard patterns when listed as \"Subject Alternative Name\" in TLS server certificates. curl can be built to use its own name matching function for TLS rather than one provided by a TLS library. This private wildcard matching function would match IDN (International Domain Name) hosts incorrectly and could as a result accept patterns that otherwise should mismatch. IDN hostnames are converted to puny code before used for certificate checks. Puny coded names always start with `xn--` and should not be allowed to pattern match, but the wildcard check in curl could still check for `x*`, which would match even though the IDN name most likely contained nothing even resembling an `x`.\n\n---\n- curl 7.88.1-10 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1036239)\n[bullseye] - curl 7.74.0-1.3+deb11u9\nhttps://curl.se/docs/CVE-2023-28321.html\nIntroduced by: https://github.com/curl/curl/commit/9631fa740708b1890197fad01e25b34b7e8eb80e (curl-7_12_0)\nFixed by: https://github.com/curl/curl/commit/199f2d440d8659b42670c1b796220792b01a97bf (curl-8_1_0)\n\n|                                                                                                          |\n|Package         pkg:deb/debian/curl@7.74.0-1.3%2Bdeb11u7?os_distro=bullseye&os_name=debian&os_version=11  |\n|Affected range  <7.74.0-1.3+deb11u9                                                                       |\n|Fixed version   7.74.0-1.3+deb11u9                                                                        |\n"
              },
              "properties": {
                "affected_version": "<7.74.0-1.3+deb11u9",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "7.74.0-1.3+deb11u9",
                "purls": [
                  "pkg:deb/debian/curl@7.74.0-1.3%2Bdeb11u7?os_distro=bullseye&os_name=debian&os_version=11"
                ],
                "security-severity": "5.9",
                "tags": [
