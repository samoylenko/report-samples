            {
              "id": "CVE-2024-50349",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2024-50349"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2024-50349?s=debian&n=git&ns=debian&t=deb&osn=debian&osv=11&vr=%3C1%3A2.30.2-1%2Bdeb11u4",
              "help": {
                "text": "Git is a fast, scalable, distributed revision control system with an unusually rich command set that provides both high-level operations and full access to internals. When Git asks for credentials via a terminal prompt (i.e. without using any credential helper), it prints out the host name for which the user is expected to provide a username and/or a password. At this stage, any URL-encoded parts have been decoded already, and are printed verbatim. This allows attackers to craft URLs that contain ANSI escape sequences that the terminal interpret to confuse users e.g. into providing passwords for trusted Git hosting sites when in fact they are then sent to untrusted sites that are under the attacker's control. This issue has been patch via commits `7725b81` and `c903985` which are included in release versions v2.48.1, v2.47.2, v2.46.3, v2.45.3, v2.44.3, v2.43.6, v2.42.4, v2.41.3, and v2.40.4. Users are advised to upgrade. Users unable to upgrade should avoid cloning from untrusted URLs, especially recursive clones.\n\n---\n- git 1:2.47.2-0.1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1093042)\nhttps://www.openwall.com/lists/oss-security/2025/01/14/4\nFixed by: https://github.com/git/git/commit/c903985bf7e772e2d08275c1a95c8a55ab011577 (v2.40.4)\nFixed by: https://github.com/git/git/commit/7725b8100ffbbff2750ee4d61a0fcc1f53a086e8 (v2.40.4)\n",
                "markdown": "> Git is a fast, scalable, distributed revision control system with an unusually rich command set that provides both high-level operations and full access to internals. When Git asks for credentials via a terminal prompt (i.e. without using any credential helper), it prints out the host name for which the user is expected to provide a username and/or a password. At this stage, any URL-encoded parts have been decoded already, and are printed verbatim. This allows attackers to craft URLs that contain ANSI escape sequences that the terminal interpret to confuse users e.g. into providing passwords for trusted Git hosting sites when in fact they are then sent to untrusted sites that are under the attacker's control. This issue has been patch via commits `7725b81` and `c903985` which are included in release versions v2.48.1, v2.47.2, v2.46.3, v2.45.3, v2.44.3, v2.43.6, v2.42.4, v2.41.3, and v2.40.4. Users are advised to upgrade. Users unable to upgrade should avoid cloning from untrusted URLs, especially recursive clones.\n\n---\n- git 1:2.47.2-0.1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1093042)\nhttps://www.openwall.com/lists/oss-security/2025/01/14/4\nFixed by: https://github.com/git/git/commit/c903985bf7e772e2d08275c1a95c8a55ab011577 (v2.40.4)\nFixed by: https://github.com/git/git/commit/7725b8100ffbbff2750ee4d61a0fcc1f53a086e8 (v2.40.4)\n\n|                                                                                                           |\n|Package         pkg:deb/debian/git@1%3A2.30.2-1%2Bdeb11u2?os_distro=bullseye&os_name=debian&os_version=11  |\n|Affected range  <1:2.30.2-1+deb11u4                                                                        |\n|Fixed version   1:2.30.2-1+deb11u4                                                                         |\n"
              },
              "properties": {
                "affected_version": "<1:2.30.2-1+deb11u4",
                "cvssV3_severity": "LOW",
                "fixed_version": "1:2.30.2-1+deb11u4",
                "purls": [
                  "pkg:deb/debian/git@1%3A2.30.2-1%2Bdeb11u2?os_distro=bullseye&os_name=debian&os_version=11"
