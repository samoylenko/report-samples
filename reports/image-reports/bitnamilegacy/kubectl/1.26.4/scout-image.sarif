            {
              "id": "CVE-2025-48384",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2025-48384"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2025-48384?s=debian&n=git&ns=debian&t=deb&osn=debian&osv=11&vr=%3C1%3A2.30.2-1%2Bdeb11u5",
              "help": {
                "text": "Git is a fast, scalable, distributed revision control system with an unusually rich command set that provides both high-level operations and full access to internals. When reading a config value, Git strips any trailing carriage return and line feed (CRLF). When writing a config entry, values with a trailing CR are not quoted, causing the CR to be lost when the config is later read. When initializing a submodule, if the submodule path contains a trailing CR, the altered path is read resulting in the submodule being checked out to an incorrect location. If a symlink exists that points the altered path to the submodule hooks directory, and the submodule contains an executable post-checkout hook, the script may be unintentionally executed after checkout. This vulnerability is fixed in v2.43.7, v2.44.4, v2.45.4, v2.46.4, v2.47.3, v2.48.2, v2.49.1, and v2.50.1.\n\n---\n- git 1:2.50.1-0.1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1108983)\n[trixie] - git 1:2.47.3-0+deb13u1\n[bookworm] - git 1:2.39.5-0+deb12u3\nhttps://github.com/git/git/security/advisories/GHSA-vwqx-4fm8-6qc9\nhttps://lore.kernel.org/git/xmqq5xg2wrd1.fsf@gitster.g/\nFixed by: https://github.com/git/git/commit/05e9cd64ee23bbadcea6bcffd6660ed02b8eab89 (2.43.7)\n",
                "markdown": "> Git is a fast, scalable, distributed revision control system with an unusually rich command set that provides both high-level operations and full access to internals. When reading a config value, Git strips any trailing carriage return and line feed (CRLF). When writing a config entry, values with a trailing CR are not quoted, causing the CR to be lost when the config is later read. When initializing a submodule, if the submodule path contains a trailing CR, the altered path is read resulting in the submodule being checked out to an incorrect location. If a symlink exists that points the altered path to the submodule hooks directory, and the submodule contains an executable post-checkout hook, the script may be unintentionally executed after checkout. This vulnerability is fixed in v2.43.7, v2.44.4, v2.45.4, v2.46.4, v2.47.3, v2.48.2, v2.49.1, and v2.50.1.\n\n---\n- git 1:2.50.1-0.1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1108983)\n[trixie] - git 1:2.47.3-0+deb13u1\n[bookworm] - git 1:2.39.5-0+deb12u3\nhttps://github.com/git/git/security/advisories/GHSA-vwqx-4fm8-6qc9\nhttps://lore.kernel.org/git/xmqq5xg2wrd1.fsf@gitster.g/\nFixed by: https://github.com/git/git/commit/05e9cd64ee23bbadcea6bcffd6660ed02b8eab89 (2.43.7)\n\n|                                                                                                           |\n|Package         pkg:deb/debian/git@1%3A2.30.2-1%2Bdeb11u2?os_distro=bullseye&os_name=debian&os_version=11  |\n|Affected range  <1:2.30.2-1+deb11u5                                                                        |\n|Fixed version   1:2.30.2-1+deb11u5                                                                         |\n"
              },
              "properties": {
                "affected_version": "<1:2.30.2-1+deb11u5",
                "cvssV3_severity": "HIGH",
                "fixed_version": "1:2.30.2-1+deb11u5",
