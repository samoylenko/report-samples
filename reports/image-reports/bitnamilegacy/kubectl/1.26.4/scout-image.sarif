                ],
                "security-severity": "7.5",
                "tags": [
                  "HIGH"
                ]
              }
            },
            {
              "id": "CVE-2024-0553",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2024-0553"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2024-0553?s=debian&n=gnutls28&ns=debian&t=deb&osn=debian&osv=11&vr=%3C3.7.1-5%2Bdeb11u5",
              "help": {
                "text": "A vulnerability was found in GnuTLS. The response times to malformed ciphertexts in RSA-PSK ClientKeyExchange differ from the response times of ciphertexts with correct PKCS#1 v1.5 padding. This issue may allow a remote attacker to perform a timing side-channel attack in the RSA-PSK key exchange, potentially leading to the leakage of sensitive data. CVE-2024-0553 is designated as an incomplete resolution for CVE-2023-5981.\n\n---\n- gnutls28 3.8.3-1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1061046)\n[bookworm] - gnutls28 3.7.9-2+deb12u2\n[bullseye] - gnutls28 3.7.1-5+deb11u5\nhttps://gitlab.com/gnutls/gnutls/-/issues/1522\nhttps://gnutls.org/security-new.html#GNUTLS-SA-2024-01-14\nhttps://gitlab.com/gnutls/gnutls/-/commit/40dbbd8de499668590e8af51a15799fbc430595e (3.8.3)\nhttps://lists.gnupg.org/pipermail/gnutls-help/2024-January/004841.html\nIssue exists because of incomplete fix for CVE-2023-5981\n",
                "markdown": "> A vulnerability was found in GnuTLS. The response times to malformed ciphertexts in RSA-PSK ClientKeyExchange differ from the response times of ciphertexts with correct PKCS#1 v1.5 padding. This issue may allow a remote attacker to perform a timing side-channel attack in the RSA-PSK key exchange, potentially leading to the leakage of sensitive data. CVE-2024-0553 is designated as an incomplete resolution for CVE-2023-5981.\n\n---\n- gnutls28 3.8.3-1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1061046)\n[bookworm] - gnutls28 3.7.9-2+deb12u2\n[bullseye] - gnutls28 3.7.1-5+deb11u5\nhttps://gitlab.com/gnutls/gnutls/-/issues/1522\nhttps://gnutls.org/security-new.html#GNUTLS-SA-2024-01-14\nhttps://gitlab.com/gnutls/gnutls/-/commit/40dbbd8de499668590e8af51a15799fbc430595e (3.8.3)\nhttps://lists.gnupg.org/pipermail/gnutls-help/2024-January/004841.html\nIssue exists because of incomplete fix for CVE-2023-5981\n\n|                                                                                                           |\n|Package         pkg:deb/debian/gnutls28@3.7.1-5%2Bdeb11u3?os_distro=bullseye&os_name=debian&os_version=11  |\n|Affected range  <3.7.1-5+deb11u5                                                                           |\n|Fixed version   3.7.1-5+deb11u5                                                                            |\n"
              },
              "properties": {
                "affected_version": "<3.7.1-5+deb11u5",
                "cvssV3_severity": "HIGH",
                "fixed_version": "3.7.1-5+deb11u5",
                "purls": [
                  "pkg:deb/debian/gnutls28@3.7.1-5%2Bdeb11u3?os_distro=bullseye&os_name=debian&os_version=11"
                ],
                "security-severity": "7.5",
                "tags": [
                  "HIGH"
