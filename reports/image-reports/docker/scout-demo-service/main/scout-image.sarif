                "markdown": "> \n\n|                                                                                 |\n|Package         pkg:apk/alpine/busybox@1.33.1-r3?os_name=alpine&os_version=3.14  |\n|Affected range  <1.33.1-r7                                                       |\n|Fixed version   1.33.1-r7                                                        |\n"
