            {
              "id": "CVE-2021-42379",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2021-42379"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2021-42379?s=alpine&n=busybox&ns=alpine&t=apk&osn=alpine&osv=3.14&vr=%3C1.33.1-r6",
