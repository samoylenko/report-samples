              }
            },
            {
              "id": "CVE-2023-44487-stdlib",
              "name": "GoModuleMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2023-44487 high vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "The HTTP/2 protocol allows a denial of service (server resource consumption) because request cancellation can reset many streams quickly, as exploited in the wild in August through October 2023."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-44487\nSeverity: high\nPackage: stdlib\nVersion: go1.17.7\nFix Version: 1.20.10,1.21.3\nType: go-module\nLocation: /opt/cni/bin/istio-cni\nData Namespace: nvd:cpe\nLink: [CVE-2023-44487](https://nvd.nist.gov/vuln/detail/CVE-2023-44487)",
                "markdown": "**Vulnerability CVE-2023-44487**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | stdlib  | go1.17.7  | 1.20.10,1.21.3  | go-module  | /opt/cni/bin/istio-cni  | nvd:cpe  | [CVE-2023-44487](https://nvd.nist.gov/vuln/detail/CVE-2023-44487)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:golang/stdlib@1.17.7"
                ],
                "security-severity": "7.5"
              }
            },
