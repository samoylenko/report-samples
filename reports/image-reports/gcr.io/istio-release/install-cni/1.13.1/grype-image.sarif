            {
              "id": "CVE-2023-45289-stdlib",
              "name": "GoModuleMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2023-45289 medium vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "When following an HTTP redirect to a domain which is not a subdomain match or exact match of the initial domain, an http.Client does not forward sensitive headers such as \"Authorization\" or \"Cookie\". For example, a redirect from foo.com to www.foo.com will forward the Authorization header, but a redirect to bar.com will not. A maliciously crafted HTTP redirect could cause sensitive headers to be unexpectedly forwarded."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-45289\nSeverity: medium\nPackage: stdlib\nVersion: go1.17.7\nFix Version: 1.21.8,1.21.8,1.22.1,1.22.1\nType: go-module\nLocation: /opt/cni/bin/istio-cni\nData Namespace: nvd:cpe\nLink: [CVE-2023-45289](https://nvd.nist.gov/vuln/detail/CVE-2023-45289)",
                "markdown": "**Vulnerability CVE-2023-45289**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | stdlib  | go1.17.7  | 1.21.8,1.21.8,1.22.1,1.22.1  | go-module  | /opt/cni/bin/istio-cni  | nvd:cpe  | [CVE-2023-45289](https://nvd.nist.gov/vuln/detail/CVE-2023-45289)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:golang/stdlib@1.17.7"
                ],
