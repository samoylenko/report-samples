            {
              "id": "CVE-2025-30157-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2025-30157 high vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "Envoy is a cloud-native high-performance edge/middle/service proxy. Prior to 1.33.1, 1.32.4, 1.31.6, and 1.30.10, Envoy's ext_proc HTTP filter is at risk of crashing if a local reply is sent to the external server due to the filter's life time issue. A known situation is the failure of a websocket handshake will trigger a local reply leading to the crash of Envoy. This vulnerability is fixed in 1.33.1, 1.32.4, 1.31.6, and 1.30.10."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2025-30157\nSeverity: high\nPackage: envoy\nVersion: 1.21.0\nFix Version: 1.30.10,1.31.6,1.32.4,1.33.1\nType: binary\nLocation: /usr/local/bin/envoy\nData Namespace: nvd:cpe\nLink: [CVE-2025-30157](https://nvd.nist.gov/vuln/detail/CVE-2025-30157)",
