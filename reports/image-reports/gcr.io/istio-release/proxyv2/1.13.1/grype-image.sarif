            {
              "id": "CVE-2022-41717-stdlib",
              "name": "GoModuleMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2022-41717 medium vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "An attacker can cause excessive memory growth in a Go server accepting HTTP/2 requests. HTTP/2 server connections contain a cache of HTTP header keys sent by the client. While the total number of entries in this cache is capped, an attacker sending very large keys can cause the server to allocate approximately 64 MiB per open connection."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2022-41717\nSeverity: medium\nPackage: stdlib\nVersion: go1.17.7\nFix Version: 1.18.9,1.19.4\nType: go-module\nLocation: /usr/local/bin/pilot-agent\nData Namespace: nvd:cpe\nLink: [CVE-2022-41717](https://nvd.nist.gov/vuln/detail/CVE-2022-41717)",
