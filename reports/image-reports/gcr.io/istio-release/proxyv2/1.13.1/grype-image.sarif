            {
              "id": "CVE-2022-29226-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2022-29226 critical vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "Envoy is a cloud-native high-performance proxy. In versions prior to 1.22.1 the OAuth filter implementation does not include a mechanism for validating access tokens, so by design when the HMAC signed cookie is missing a full authentication flow should be triggered. However, the current implementation assumes that access tokens are always validated thus allowing access in the presence of any access token attached to the request. Users are advised to upgrade. There is no known workaround for this issue."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2022-29226\nSeverity: critical\nPackage: envoy\nVersion: 1.21.0\nFix Version: 1.22.1\nType: binary\nLocation: /usr/local/bin/envoy\nData Namespace: nvd:cpe\nLink: [CVE-2022-29226](https://nvd.nist.gov/vuln/detail/CVE-2022-29226)",
