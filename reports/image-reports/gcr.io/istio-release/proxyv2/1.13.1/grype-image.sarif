            {
              "id": "CVE-2024-34362-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2024-34362 medium vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "Envoy is a cloud-native, open source edge and service proxy. There is a use-after-free in `HttpConnectionManager` (HCM) with `EnvoyQuicServerStream` that can crash Envoy. An attacker can exploit this vulnerability by sending a request without `FIN`, then a `RESET_STREAM` frame, and then after receiving the response, closing the connection."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-34362\nSeverity: medium\nPackage: envoy\nVersion: 1.21.0\nFix Version: 1.27.6,1.28.4,1.29.5,1.30.2\nType: binary\nLocation: /usr/local/bin/envoy\nData Namespace: nvd:cpe\nLink: [CVE-2024-34362](https://nvd.nist.gov/vuln/detail/CVE-2024-34362)",
