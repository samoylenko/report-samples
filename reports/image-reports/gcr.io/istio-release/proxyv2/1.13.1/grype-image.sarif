            {
              "id": "CVE-2021-43824-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2021-43824 high vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "Envoy is an open source edge and service proxy, designed for cloud-native applications. In affected versions a crafted request crashes Envoy when a CONNECT request is sent to JWT filter configured with regex match. This provides a denial of service attack vector. The only workaround is to not use regex in the JWT filter. Users are advised to upgrade."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2021-43824\nSeverity: high\nPackage: envoy\nVersion: 1.21.0\nFix Version: 1.18.6,1.19.3,1.20.2,1.21.1\nType: binary\nLocation: /usr/local/bin/envoy\nData Namespace: nvd:cpe\nLink: [CVE-2021-43824](https://nvd.nist.gov/vuln/detail/CVE-2021-43824)",
