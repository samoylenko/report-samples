          "rules": [
            {
              "id": "CVE-2023-44487-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2023-44487 high vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "The HTTP/2 protocol allows a denial of service (server resource consumption) because request cancellation can reset many streams quickly, as exploited in the wild in August through October 2023."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-44487\nSeverity: high\nPackage: envoy\nVersion: 1.21.0\nFix Version: 1.24.12,1.25.11,1.26.6,1.27.2\nType: binary\nLocation: /usr/local/bin/envoy\nData Namespace: nvd:cpe\nLink: [CVE-2023-44487](https://nvd.nist.gov/vuln/detail/CVE-2023-44487)",
                "markdown": "**Vulnerability CVE-2023-44487**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | envoy  | 1.21.0  | 1.24.12,1.25.11,1.26.6,1.27.2  | binary  | /usr/local/bin/envoy  | nvd:cpe  | [CVE-2023-44487](https://nvd.nist.gov/vuln/detail/CVE-2023-44487)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:generic/envoy@1.21.0"
                ],
                "security-severity": "7.5"
              }
            },
            {
