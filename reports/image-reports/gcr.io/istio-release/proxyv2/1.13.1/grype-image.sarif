            {
              "id": "CVE-2025-46821-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2025-46821 medium vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "Envoy is a cloud-native edge/middle/service proxy. Prior to versions 1.34.1, 1.33.3, 1.32.6, and 1.31.8, Envoy's URI template matcher incorrectly excludes the `*` character from a set of valid characters in the URI path. As a result URI path containing the `*` character will not match a URI template expressions. This can result in bypass of RBAC rules when configured using the `uri_template` permissions. This vulnerability is fixed in Envoy versions v1.34.1, v1.33.3, v1.32.6, v1.31.8. As a workaround, configure additional RBAC permissions using `url_path` with `safe_regex` expression."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2025-46821\nSeverity: medium\nPackage: envoy\nVersion: 1.21.0\nFix Version: 1.31.8,1.32.6,1.33.3,1.34.1\nType: binary\nLocation: /usr/local/bin/envoy\nData Namespace: nvd:cpe\nLink: [CVE-2025-46821](https://nvd.nist.gov/vuln/detail/CVE-2025-46821)",
                "markdown": "**Vulnerability CVE-2025-46821**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | envoy  | 1.21.0  | 1.31.8,1.32.6,1.33.3,1.34.1  | binary  | /usr/local/bin/envoy  | nvd:cpe  | [CVE-2025-46821](https://nvd.nist.gov/vuln/detail/CVE-2025-46821)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:generic/envoy@1.21.0"
                ],
                "security-severity": "5.3"
              }
            },
