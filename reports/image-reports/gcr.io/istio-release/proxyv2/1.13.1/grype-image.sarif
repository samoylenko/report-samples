            {
              "id": "CVE-2022-29225-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2022-29225 high vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "Envoy is a cloud-native high-performance proxy. In versions prior to 1.22.1 secompressors accumulate decompressed data into an intermediate buffer before overwriting the body in the decode/encodeBody. This may allow an attacker to zip bomb the decompressor by sending a small highly compressed payload. Maliciously constructed zip files may exhaust system memory and cause a denial of service. Users are advised to upgrade. Users unable to upgrade may consider disabling decompression."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2022-29225\nSeverity: high\nPackage: envoy\nVersion: 1.21.0\nFix Version: 1.22.1\nType: binary\nLocation: /usr/local/bin/envoy\nData Namespace: nvd:cpe\nLink: [CVE-2022-29225](https://nvd.nist.gov/vuln/detail/CVE-2022-29225)",
