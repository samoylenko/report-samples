              }
            },
            {
              "id": "CVE-2021-43825-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2021-43825 high vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "Envoy is an open source edge and service proxy, designed for cloud-native applications. Sending a locally generated response must stop further processing of request or response data. Envoy tracks the amount of buffered request and response data and aborts the request if the amount of buffered data is over the limit by sending 413 or 500 responses. However when the buffer overflows while response is processed by the filter chain the operation may not be aborted correctly and result in accessing a freed memory block. If this happens Envoy will crash resulting in a denial of service."
              },
              "helpUri": "https://github.com/anchore/grype",
