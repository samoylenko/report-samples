            {
              "id": "CVE-2021-43826-envoy",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2021-43826 high vulnerability for envoy package"
              },
              "fullDescription": {
                "text": "Envoy is an open source edge and service proxy, designed for cloud-native applications. In affected versions of Envoy a crash occurs when configured for :ref:`upstream tunneling \u003cenvoy_v3_api_field_extensions.filters.network.tcp_proxy.v3.TcpProxy.tunneling_config\u003e` and the downstream connection disconnects while the the upstream connection or http/2 stream is still being established. There are no workarounds for this issue. Users are advised to upgrade."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2021-43826\nSeverity: high\nPackage: envoy\nVersion: 1.21.0\nFix Version: 1.18.6,1.19.3,1.20.2,1.21.1\nType: binary\nLocation: /usr/local/bin/envoy\nData Namespace: nvd:cpe\nLink: [CVE-2021-43826](https://nvd.nist.gov/vuln/detail/CVE-2021-43826)",
