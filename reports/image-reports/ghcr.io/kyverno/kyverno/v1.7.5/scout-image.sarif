                "affected_version": "<=1.8.4",
                "cvssV3": 5.8,
                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:N/A:N",
                "fixed_version": "1.8.5",
