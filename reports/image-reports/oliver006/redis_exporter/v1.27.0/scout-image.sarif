            {
              "id": "CVE-2024-34155",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2024-34155"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2024-34155?s=golang&n=stdlib&t=golang&vr=%3C1.22.7",
              "help": {
                "text": "Calling any of the Parse functions on Go source code which contains deeply nested literals can cause a panic due to stack exhaustion.\n",
                "markdown": "> Calling any of the Parse functions on Go source code which contains deeply nested literals can cause a panic due to stack exhaustion.\n\n|                                        |\n|Package         pkg:golang/stdlib@1.17  |\n|Affected range  <1.22.7                 |\n|Fixed version   1.22.7                  |\n"
              },
