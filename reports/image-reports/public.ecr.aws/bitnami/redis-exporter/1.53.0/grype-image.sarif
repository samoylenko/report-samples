    {
      "tool": {
        "driver": {
          "name": "grype",
          "version": "0.110.0",
          "informationUri": "https://github.com/anchore/grype",
          "rules": [
            {
              "id": "CVE-2023-4911-libc-bin",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-4911 high vulnerability for libc-bin package"
              },
              "fullDescription": {
                "text": "A buffer overflow was discovered in the GNU C Library's dynamic loader ld.so while processing the GLIBC_TUNABLES environment variable. This issue could allow a local attacker to use maliciously crafted GLIBC_TUNABLES environment variables when launching binaries with SUID permission to execute code with elevated privileges."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-4911\nSeverity: high\nPackage: libc-bin\nVersion: 2.31-13+deb11u6\nFix Version: 2.31-13+deb11u7\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2023-4911](https://security-tracker.debian.org/tracker/CVE-2023-4911)",
                "markdown": "**Vulnerability CVE-2023-4911**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | libc-bin  | 2.31-13+deb11u6  | 2.31-13+deb11u7  | deb  | /var/lib/dpkg/status  | debian:distro:debian:11  | [CVE-2023-4911](https://security-tracker.debian.org/tracker/CVE-2023-4911)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libc-bin@2.31-13%2Bdeb11u6?arch=amd64\u0026distro=debian-11\u0026upstream=glibc"
                ],
                "security-severity": "7.8"
              }
            },
            {
