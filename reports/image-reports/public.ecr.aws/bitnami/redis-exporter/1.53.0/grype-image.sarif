            {
              "id": "CVE-2024-2961-libc-bin",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-2961 high vulnerability for libc-bin package"
              },
              "fullDescription": {
                "text": "The iconv() function in the GNU C Library versions 2.39 and older may overflow the output buffer passed to it by up to 4 bytes when converting strings to the ISO-2022-CN-EXT character set, which may be used to crash an application or overwrite a neighbouring variable."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-2961\nSeverity: high\nPackage: libc-bin\nVersion: 2.31-13+deb11u6\nFix Version: 2.31-13+deb11u9\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2024-2961](https://security-tracker.debian.org/tracker/CVE-2024-2961)",
