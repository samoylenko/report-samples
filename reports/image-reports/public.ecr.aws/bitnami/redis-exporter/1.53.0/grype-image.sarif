            {
              "id": "CVE-2024-12243-libgnutls30",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-12243 medium vulnerability for libgnutls30 package"
              },
              "fullDescription": {
                "text": "A flaw was found in GnuTLS, which relies on libtasn1 for ASN.1 data processing. Due to an inefficient algorithm in libtasn1, decoding certain DER-encoded certificate data can take excessive time, leading to increased resource consumption. This flaw allows a remote attacker to send a specially crafted certificate, causing GnuTLS to become unresponsive or slow, resulting in a denial-of-service condition."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-12243\nSeverity: medium\nPackage: libgnutls30\nVersion: 3.7.1-5+deb11u3\nFix Version: 3.7.1-5+deb11u7\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2024-12243](https://security-tracker.debian.org/tracker/CVE-2024-12243)",
