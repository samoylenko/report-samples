            {
              "id": "CVE-2021-29923-stdlib",
              "name": "GoModuleMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2021-29923 high vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "Go before 1.17 does not properly consider extraneous zero characters at the beginning of an IP address octet, which (in some situations) allows attackers to bypass access control that is based on IP addresses, because of unexpected octal interpretation. This affects net.ParseIP and net.ParseCIDR."
              },
              "helpUri": "https://github.com/anchore/grype",
