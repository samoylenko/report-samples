            {
              "id": "CVE-2025-32988",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2025-32988"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2025-32988?s=ubuntu&n=gnutls28&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C3.7.3-4ubuntu1.7",
              "help": {
                "text": "A flaw was found in GnuTLS. A double-free vulnerability exists in GnuTLS due to incorrect ownership handling in the export logic of Subject Alternative Name (SAN) entries containing an otherName. If the type-id OID is invalid or malformed, GnuTLS will call asn1_delete_structure() on an ASN.1 node it does not own, leading to a double-free condition when the parent function or caller later attempts to free the same structure.  This vulnerability can be triggered using only public GnuTLS APIs and may result in denial of service or memory corruption, depending on allocator behavior.\n",
                "markdown": "> A flaw was found in GnuTLS. A double-free vulnerability exists in GnuTLS due to incorrect ownership handling in the export logic of Subject Alternative Name (SAN) entries containing an otherName. If the type-id OID is invalid or malformed, GnuTLS will call asn1_delete_structure() on an ASN.1 node it does not own, leading to a double-free condition when the parent function or caller later attempts to free the same structure.  This vulnerability can be triggered using only public GnuTLS APIs and may result in denial of service or memory corruption, depending on allocator behavior.\n\n|                                                                                                                                                                       |\n|Package                                                                        pkg:deb/ubuntu/gnutls28@3.7.3-4ubuntu1?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range                                                                 <3.7.3-4ubuntu1.7                                                                       |\n|Fixed version                                                                  3.7.3-4ubuntu1.7                                                                        |\n|[[CVSS Score 8.2] [CVSS Vector CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:H]]                                                                                          |\n"
              },
              "properties": {
                "affected_version": "<3.7.3-4ubuntu1.7",
                "cvssV3": 8.2,
                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:H",
                "fixed_version": "3.7.3-4ubuntu1.7",
                "purls": [
                  "pkg:deb/ubuntu/gnutls28@3.7.3-4ubuntu1?os_distro=jammy&os_name=ubuntu&os_version=22.04"
                ],
