                "fixed_version": "7.81.0-1ubuntu1.23",
                "purls": [
                  "pkg:deb/ubuntu/curl@7.81.0-1ubuntu1.3?os_distro=jammy&os_name=ubuntu&os_version=22.04"
                ],
                "security-severity": "3.1",
                "tags": [
                  "LOW"
                ]
              }
            },
            {
              "id": "CVE-2025-14524",
