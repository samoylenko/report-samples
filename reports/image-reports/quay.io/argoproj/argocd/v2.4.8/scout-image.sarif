            {
              "id": "CVE-2026-3784",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-3784"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-3784?s=ubuntu&n=curl&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C7.81.0-1ubuntu1.23",
              "help": {
                "text": "curl would wrongly reuse an existing HTTP proxy connection doing CONNECT to a server, even if the new request uses different credentials for the HTTP proxy. The proper behavior is to create or use a separate connection.\n",
                "markdown": "> curl would wrongly reuse an existing HTTP proxy connection doing CONNECT to a server, even if the new request uses different credentials for the HTTP proxy. The proper behavior is to create or use a separate connection.\n\n|                                                                                                       |\n|Package         pkg:deb/ubuntu/curl@7.81.0-1ubuntu1.3?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range  <7.81.0-1ubuntu1.23                                                                    |\n|Fixed version   7.81.0-1ubuntu1.23                                                                     |\n"
              },
              "properties": {
                "affected_version": "<7.81.0-1ubuntu1.23",
                "cvssV3_severity": "LOW",
                "fixed_version": "7.81.0-1ubuntu1.23",
                "purls": [
                  "pkg:deb/ubuntu/curl@7.81.0-1ubuntu1.3?os_distro=jammy&os_name=ubuntu&os_version=22.04"
