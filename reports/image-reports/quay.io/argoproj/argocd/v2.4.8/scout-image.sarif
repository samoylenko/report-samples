            {
              "id": "CVE-2023-6918",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-6918"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2023-6918?s=ubuntu&n=libssh&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C0.9.6-2ubuntu0.22.04.3",
              "help": {
                "text": "A flaw was found in the libssh implements abstract layer for message digest (MD) operations implemented by different supported crypto backends. The return values from these were not properly checked, which could cause low-memory situations failures, NULL dereferences, crashes, or usage of the uninitialized memory as an input for the KDF. In this case, non-matching keys will result in decryption/integrity failures, terminating the connection.\n",
                "markdown": "> A flaw was found in the libssh implements abstract layer for message digest (MD) operations implemented by different supported crypto backends. The return values from these were not properly checked, which could cause low-memory situations failures, NULL dereferences, crashes, or usage of the uninitialized memory as an input for the KDF. In this case, non-matching keys will result in decryption/integrity failures, terminating the connection.\n\n|                                                                                                                                                                    |\n|Package                                                                        pkg:deb/ubuntu/libssh@0.9.6-2build1?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range                                                                 <0.9.6-2ubuntu0.22.04.3                                                              |\n|Fixed version                                                                  0.9.6-2ubuntu0.22.04.3                                                               |\n|[[CVSS Score 5.3] [CVSS Vector CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L]]                                                                                       |\n"
              },
              "properties": {
                "affected_version": "<0.9.6-2ubuntu0.22.04.3",
                "cvssV3": 5.3,
                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L",
                "fixed_version": "0.9.6-2ubuntu0.22.04.3",
                "purls": [
                  "pkg:deb/ubuntu/libssh@0.9.6-2build1?os_distro=jammy&os_name=ubuntu&os_version=22.04"
                ],
