                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H",
                "fixed_version": "1.56.3",
                "purls": [
                  "pkg:golang/google.golang.org/grpc@1.43.0",
                  "pkg:golang/google.golang.org/grpc@1.45.0"
                ],
                "security-severity": "7.5",
