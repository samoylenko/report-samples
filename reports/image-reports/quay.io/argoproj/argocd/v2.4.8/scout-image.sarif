                "cvssV3": 9.8,
                "cvssV3_severity": "HIGH",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
                "fixed_version": "1.6.0-2ubuntu0.1",
                "purls": [
                  "pkg:deb/ubuntu/libksba@1.6.0-2build1?os_distro=jammy&os_name=ubuntu&os_version=22.04"
                ],
