            {
              "id": "CVE-2025-15224",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2025-15224"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2025-15224?s=ubuntu&n=curl&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C7.81.0-1ubuntu1.22",
              "help": {
                "text": "When doing SSH-based transfers using either SCP or SFTP, and asked to do public key authentication, curl would wrongly still ask and authenticate using a locally running SSH agent.\n",
