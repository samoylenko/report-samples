            {
              "id": "CVE-2023-0217",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-0217"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2023-0217?s=ubuntu&n=openssl&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C3.0.2-0ubuntu1.8",
              "help": {
                "text": "An invalid pointer dereference on read can be triggered when an application tries to check a malformed DSA public key by the EVP_PKEY_public_check() function. This will most likely lead to an application crash. This function can be called on public keys supplied from untrusted sources which could allow an attacker to cause a denial of service attack.  The TLS implementation in OpenSSL does not call this function but applications might call the function if there are additional security requirements imposed by standards such as FIPS 140-3.\n",
                "markdown": "> An invalid pointer dereference on read can be triggered when an application tries to check a malformed DSA public key by the EVP_PKEY_public_check() function. This will most likely lead to an application crash. This function can be called on public keys supplied from untrusted sources which could allow an attacker to cause a denial of service attack.  The TLS implementation in OpenSSL does not call this function but applications might call the function if there are additional security requirements imposed by standards such as FIPS 140-3.\n\n|                                                                                                                                                                        |\n|Package                                                                        pkg:deb/ubuntu/openssl@3.0.2-0ubuntu1.6?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range                                                                 <3.0.2-0ubuntu1.8                                                                        |\n|Fixed version                                                                  3.0.2-0ubuntu1.8                                                                         |\n|[[CVSS Score 7.5] [CVSS Vector CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H]]                                                                                           |\n"
              },
              "properties": {
                "affected_version": "<3.0.2-0ubuntu1.8",
                "cvssV3": 7.5,
                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H",
                "fixed_version": "3.0.2-0ubuntu1.8",
                "purls": [
                  "pkg:deb/ubuntu/openssl@3.0.2-0ubuntu1.6?os_distro=jammy&os_name=ubuntu&os_version=22.04"
