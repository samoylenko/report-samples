            {
              "id": "CVE-2025-48386",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2025-48386"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2025-48386?s=ubuntu&n=git&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C1%3A2.34.1-1ubuntu1.13",
              "help": {
                "text": "Git is a fast, scalable, distributed revision control system with an unusually rich command set that provides both high-level operations and full access to internals. The wincred credential helper uses a static buffer (target) as a unique key for storing and comparing against internal storage. This credential helper does not properly bounds check the available space remaining in the buffer before appending to it with wcsncat(), leading to potential buffer overflows. This vulnerability is fixed in v2.43.7, v2.44.4, v2.45.4, v2.46.4, v2.47.3, v2.48.2, v2.49.1, and v2.50.1.\n",
                "markdown": "> Git is a fast, scalable, distributed revision control system with an unusually rich command set that provides both high-level operations and full access to internals. The wincred credential helper uses a static buffer (target) as a unique key for storing and comparing against internal storage. This credential helper does not properly bounds check the available space remaining in the buffer before appending to it with wcsncat(), leading to potential buffer overflows. This vulnerability is fixed in v2.43.7, v2.44.4, v2.45.4, v2.46.4, v2.47.3, v2.48.2, v2.49.1, and v2.50.1.\n\n|                                                                                                          |\n|Package         pkg:deb/ubuntu/git@1%3A2.34.1-1ubuntu1.4?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range  <1:2.34.1-1ubuntu1.13                                                                     |\n|Fixed version   1:2.34.1-1ubuntu1.13                                                                      |\n"
              },
              "properties": {
                "affected_version": "<1:2.34.1-1ubuntu1.13",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "1:2.34.1-1ubuntu1.13",
                "purls": [
