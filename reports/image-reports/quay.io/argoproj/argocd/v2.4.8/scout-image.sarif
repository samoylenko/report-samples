            {
              "id": "CVE-2023-3138",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-3138"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2023-3138?s=ubuntu&n=libx11&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C2%3A1.7.5-1ubuntu0.2",
              "help": {
                "text": "A vulnerability was found in libX11. The security flaw occurs because the functions in src/InitExt.c in libX11 do not check that the values provided for the Request, Event, or Error IDs are within the bounds of the arrays that those functions write to, using those IDs as array indexes. They trust that they were called with values provided by an Xserver adhering to the bounds specified in the X11 protocol, as all X servers provided by X.Org do. As the protocol only specifies a single byte for these values, an out-of-bounds value provided by a malicious server (or a malicious proxy-in-the-middle) can only overwrite other portions of the Display structure and not write outside the bounds of the Display structure itself, possibly causing the client to crash with this memory corruption.\n",
                "markdown": "> A vulnerability was found in libX11. The security flaw occurs because the functions in src/InitExt.c in libX11 do not check that the values provided for the Request, Event, or Error IDs are within the bounds of the arrays that those functions write to, using those IDs as array indexes. They trust that they were called with values provided by an Xserver adhering to the bounds specified in the X11 protocol, as all X servers provided by X.Org do. As the protocol only specifies a single byte for these values, an out-of-bounds value provided by a malicious server (or a malicious proxy-in-the-middle) can only overwrite other portions of the Display structure and not write outside the bounds of the Display structure itself, possibly causing the client to crash with this memory corruption.\n\n|                                                                                                                                                                  |\n|Package                                                                        pkg:deb/ubuntu/libx11@2%3A1.7.5-1?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range                                                                 <2:1.7.5-1ubuntu0.2                                                                |\n|Fixed version                                                                  2:1.7.5-1ubuntu0.2                                                                 |\n|[[CVSS Score 7.5] [CVSS Vector CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H]]                                                                                     |\n"
              },
              "properties": {
                "affected_version": "<2:1.7.5-1ubuntu0.2",
                "cvssV3": 7.5,
                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H",
                "fixed_version": "2:1.7.5-1ubuntu0.2",
                "purls": [
