                "cvssV3_severity": "LOW",
                "fixed_version": "0.9.6-2ubuntu0.22.04.6",
                "purls": [
                  "pkg:deb/ubuntu/libssh@0.9.6-2build1?os_distro=jammy&os_name=ubuntu&os_version=22.04"
                ],
                "security-severity": "3.1",
                "tags": [
                  "LOW"
