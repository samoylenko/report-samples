            {
              "id": "CVE-2022-46663",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2022-46663"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2022-46663?s=ubuntu&n=less&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C590-1ubuntu0.22.04.1",
              "help": {
                "text": "In GNU Less before 609, crafted data can result in \"less -R\" not filtering ANSI escape sequences sent to the terminal.\n",
