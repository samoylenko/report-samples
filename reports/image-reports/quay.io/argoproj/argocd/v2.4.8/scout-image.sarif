            {
              "id": "CVE-2022-3996",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2022-3996"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2022-3996?s=ubuntu&n=openssl&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C3.0.2-0ubuntu1.9",
              "help": {
                "text": "If an X.509 certificate contains a malformed policy constraint and policy processing is enabled, then a write lock will be taken twice recursively.  On some operating systems (most widely: Windows) this results in a denial of service when the affected process hangs.  Policy processing being enabled on a publicly facing server is not considered to be a common setup.  Policy processing is enabled by passing the `-policy' argument to the command line utilities or by calling the `X509_VERIFY_PARAM_set1_policies()' function.  Update (31 March 2023): The description of the policy processing enablement was corrected based on CVE-2023-0466.\n",
                "markdown": "> If an X.509 certificate contains a malformed policy constraint and policy processing is enabled, then a write lock will be taken twice recursively.  On some operating systems (most widely: Windows) this results in a denial of service when the affected process hangs.  Policy processing being enabled on a publicly facing server is not considered to be a common setup.  Policy processing is enabled by passing the `-policy' argument to the command line utilities or by calling the `X509_VERIFY_PARAM_set1_policies()' function.  Update (31 March 2023): The description of the policy processing enablement was corrected based on CVE-2023-0466.\n\n|                                                                                                                                                                        |\n|Package                                                                        pkg:deb/ubuntu/openssl@3.0.2-0ubuntu1.6?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range                                                                 <3.0.2-0ubuntu1.9                                                                        |\n|Fixed version                                                                  3.0.2-0ubuntu1.9                                                                         |\n|[[CVSS Score 7.5] [CVSS Vector CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H]]                                                                                           |\n"
              },
              "properties": {
                "affected_version": "<3.0.2-0ubuntu1.9",
                "cvssV3": 7.5,
                "cvssV3_severity": "LOW",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H",
