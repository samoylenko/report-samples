            {
              "id": "CVE-2023-27535",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-27535"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2023-27535?s=ubuntu&n=curl&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C7.81.0-1ubuntu1.10",
              "help": {
                "text": "An authentication bypass vulnerability exists in libcurl <8.0.0 in the FTP connection reuse feature that can result in wrong credentials being used during subsequent transfers. Previously created connections are kept in a connection pool for reuse if they match the current setup. However, certain FTP settings such as CURLOPT_FTP_ACCOUNT, CURLOPT_FTP_ALTERNATIVE_TO_USER, CURLOPT_FTP_SSL_CCC, and CURLOPT_USE_SSL were not included in the configuration match checks, causing them to match too easily. This could lead to libcurl using the wrong credentials when performing a transfer, potentially allowing unauthorized access to sensitive information.\n",
                "markdown": "> An authentication bypass vulnerability exists in libcurl <8.0.0 in the FTP connection reuse feature that can result in wrong credentials being used during subsequent transfers. Previously created connections are kept in a connection pool for reuse if they match the current setup. However, certain FTP settings such as CURLOPT_FTP_ACCOUNT, CURLOPT_FTP_ALTERNATIVE_TO_USER, CURLOPT_FTP_SSL_CCC, and CURLOPT_USE_SSL were not included in the configuration match checks, causing them to match too easily. This could lead to libcurl using the wrong credentials when performing a transfer, potentially allowing unauthorized access to sensitive information.\n\n|                                                                                                                                                                      |\n|Package                                                                        pkg:deb/ubuntu/curl@7.81.0-1ubuntu1.3?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range                                                                 <7.81.0-1ubuntu1.10                                                                    |\n|Fixed version                                                                  7.81.0-1ubuntu1.10                                                                     |\n|[[CVSS Score 5.9] [CVSS Vector CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:N/A:N]]                                                                                         |\n"
              },
              "properties": {
                "affected_version": "<7.81.0-1ubuntu1.10",
                "cvssV3": 5.9,
                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:N/A:N",
                "fixed_version": "7.81.0-1ubuntu1.10",
                "purls": [
                  "pkg:deb/ubuntu/curl@7.81.0-1ubuntu1.3?os_distro=jammy&os_name=ubuntu&os_version=22.04"
