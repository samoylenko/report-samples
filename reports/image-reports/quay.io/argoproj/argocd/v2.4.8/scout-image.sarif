            {
              "id": "CVE-2024-32020",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2024-32020"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2024-32020?s=ubuntu&n=git&ns=ubuntu&t=deb&osn=ubuntu&osv=22.04&vr=%3C1%3A2.34.1-1ubuntu1.11",
              "help": {
                "text": "Git is a revision control system. Prior to versions 2.45.1, 2.44.1, 2.43.4, 2.42.2, 2.41.1, 2.40.2, and 2.39.4, local clones may end up hardlinking files into the target repository's object database when source and target repository reside on the same disk. If the source repository is owned by a different user, then those hardlinked files may be rewritten at any point in time by the untrusted user. Cloning local repositories will cause Git to either copy or hardlink files of the source repository into the target repository. This significantly speeds up such local clones compared to doing a \"proper\" clone and saves both disk space and compute time. When cloning a repository located on the same disk that is owned by a different user than the current user we also end up creating such hardlinks. These files will continue to be owned and controlled by the potentially-untrusted user and can be rewritten by them at will in the future. The problem has been patched in versions 2.45.1, 2.44.1, 2.43.4, 2.42.2, 2.41.1, 2.40.2, and 2.39.4.\n",
                "markdown": "> Git is a revision control system. Prior to versions 2.45.1, 2.44.1, 2.43.4, 2.42.2, 2.41.1, 2.40.2, and 2.39.4, local clones may end up hardlinking files into the target repository's object database when source and target repository reside on the same disk. If the source repository is owned by a different user, then those hardlinked files may be rewritten at any point in time by the untrusted user. Cloning local repositories will cause Git to either copy or hardlink files of the source repository into the target repository. This significantly speeds up such local clones compared to doing a \"proper\" clone and saves both disk space and compute time. When cloning a repository located on the same disk that is owned by a different user than the current user we also end up creating such hardlinks. These files will continue to be owned and controlled by the potentially-untrusted user and can be rewritten by them at will in the future. The problem has been patched in versions 2.45.1, 2.44.1, 2.43.4, 2.42.2, 2.41.1, 2.40.2, and 2.39.4.\n\n|                                                                                                                                                                         |\n|Package                                                                        pkg:deb/ubuntu/git@1%3A2.34.1-1ubuntu1.4?os_distro=jammy&os_name=ubuntu&os_version=22.04  |\n|Affected range                                                                 <1:2.34.1-1ubuntu1.11                                                                     |\n|Fixed version                                                                  1:2.34.1-1ubuntu1.11                                                                      |\n|[[CVSS Score 3.3] [CVSS Vector CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:L/A:N]]                                                                                            |\n"
              },
              "properties": {
                "affected_version": "<1:2.34.1-1ubuntu1.11",
                "cvssV3": 3.3,
                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:L/A:N",
                "fixed_version": "1:2.34.1-1ubuntu1.11",
                "purls": [
