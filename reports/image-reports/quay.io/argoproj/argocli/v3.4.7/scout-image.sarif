            {
              "id": "CVE-2025-22873",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2025-22873"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2025-22873?s=golang&n=stdlib&t=golang&vr=%3C1.23.9",
              "help": {
                "text": "It was possible to improperly access the parent directory of an os.Root by opening a filename ending in \"../\". For example, Root.Open(\"../\") would open the parent directory of the Root. This escape only permits opening the parent directory itself, not ancestors of the parent or files contained within the parent.\n",
                "markdown": "> It was possible to improperly access the parent directory of an os.Root by opening a filename ending in \"../\". For example, Root.Open(\"../\") would open the parent directory of the Root. This escape only permits opening the parent directory itself, not ancestors of the parent or files contained within the parent.\n\n|                                          |\n|Package         pkg:golang/stdlib@1.19.8  |\n|Affected range  <1.23.9                   |\n|Fixed version   1.23.9                    |\n"
              },
              "properties": {
                "affected_version": "<1.23.9",
                "cvssV3_severity": "LOW",
                "fixed_version": "1.23.9",
