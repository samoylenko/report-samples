            {
              "id": "CVE-2023-24539-stdlib",
              "name": "GoModuleMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2023-24539 high vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "Angle brackets (\u003c\u003e) are not considered dangerous characters when inserted into CSS contexts. Templates containing multiple actions separated by a '/' character can result in unexpectedly closing the CSS context and allowing for injection of unexpected HTML, if executed with untrusted input."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-24539\nSeverity: high\nPackage: stdlib\nVersion: go1.19.7\nFix Version: 1.19.9,1.20.4\nType: go-module\nLocation: /usr/bin/check-status\nData Namespace: nvd:cpe\nLink: [CVE-2023-24539](https://nvd.nist.gov/vuln/detail/CVE-2023-24539)",
