            {
              "id": "CVE-2025-22871",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2025-22871"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2025-22871?s=golang&n=stdlib&t=golang&vr=%3C1.23.8",
              "help": {
                "text": "The net/http package improperly accepts a bare LF as a line terminator in chunked data chunk-size lines. This can permit request smuggling if a net/http server is used in conjunction with a server that incorrectly accepts a bare LF as part of a chunk-ext.\n",
                "markdown": "> The net/http package improperly accepts a bare LF as a line terminator in chunked data chunk-size lines. This can permit request smuggling if a net/http server is used in conjunction with a server that incorrectly accepts a bare LF as part of a chunk-ext.\n\n|                                          |\n|Package         pkg:golang/stdlib@1.19.7  |\n|Affected range  <1.23.8                   |\n|Fixed version   1.23.8                    |\n"
              },
              "properties": {
                "affected_version": "<1.23.8",
                "cvssV3_severity": "CRITICAL",
                "fixed_version": "1.23.8",
                "purls": [
