            {
              "id": "CVE-2023-4813",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-4813: Use After Free"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2023-4813?s=redhat&n=glibc&ns=redhat&t=rpm&osn=redhatlinux&osv=8&vr=%3C2.28-225.el8_8.6",
              "help": {
                "text": "A flaw has been identified in glibc. In an uncommon situation, the gaih_inet function may use memory that has been freed, resulting in an application crash. This issue is only exploitable when the getaddrinfo function is called and the hosts database in /etc/nsswitch.conf is configured with SUCCESS=continue or SUCCESS=merge.\n",
                "markdown": "> A flaw has been identified in glibc. In an uncommon situation, the gaih_inet function may use memory that has been freed, resulting in an application crash. This issue is only exploitable when the getaddrinfo function is called and the hosts database in /etc/nsswitch.conf is configured with SUCCESS=continue or SUCCESS=merge.\n\n|                                                                                                                                                   |\n|Package                                                                        pkg:rpm/redhat/glibc@2.28-211.el8?os_name=redhatlinux&os_version=8  |\n|Affected range                                                                 <2.28-225.el8_8.6                                                   |\n|Fixed version                                                                  2.28-225.el8_8.6                                                    |\n|[[CVSS Score 5.9] [CVSS Vector CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H]]                                                                      |\n"
              },
              "properties": {
                "affected_version": "<2.28-225.el8_8.6",
                "cvssV3": 5.9,
                "cvssV3_severity": "MEDIUM",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H",
                "fixed_version": "2.28-225.el8_8.6",
