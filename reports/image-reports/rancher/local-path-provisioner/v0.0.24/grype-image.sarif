            {
              "id": "CVE-2026-32283-stdlib",
              "name": "GoModuleMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-32283 low vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "If one side of the TLS connection sends multiple key update messages post-handshake in a single record, the connection can deadlock, causing uncontrolled consumption of resources. This can lead to a denial of service. This only affects TLS 1.3."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2026-32283\nSeverity: low\nPackage: stdlib\nVersion: go1.17.13\nFix Version: 1.25.9,1.26.2\nType: go-module\nLocation: /usr/bin/local-path-provisioner\nData Namespace: nvd:cpe\nLink: [CVE-2026-32283](https://nvd.nist.gov/vuln/detail/CVE-2026-32283)",
