            {
              "id": "CVE-2026-32281-stdlib",
              "name": "GoModuleMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-32281 low vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "Validating certificate chains which use policies is unexpectedly inefficient when certificates in the chain contain a very large number of policy mappings, possibly causing denial of service. This only affects validation of otherwise trusted certificate chains, issued by a root CA in the VerifyOptions.Roots CertPool, or in the system certificate pool."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2026-32281\nSeverity: low\nPackage: stdlib\nVersion: go1.17.13\nFix Version: 1.25.9,1.26.2\nType: go-module\nLocation: /usr/bin/local-path-provisioner\nData Namespace: nvd:cpe\nLink: [CVE-2026-32281](https://nvd.nist.gov/vuln/detail/CVE-2026-32281)",
