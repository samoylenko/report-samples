            },
            {
              "id": "CVE-2025-22873-stdlib",
              "name": "GoModuleMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2025-22873 low vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "It was possible to improperly access the parent directory of an os.Root by opening a filename ending in \"../\". For example, Root.Open(\"../\") would open the parent directory of the Root. This escape only permits opening the parent directory itself, not ancestors of the parent or files contained within the parent."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2025-22873\nSeverity: low\nPackage: stdlib\nVersion: go1.17.13\nFix Version: 1.23.9,1.24.3\nType: go-module\nLocation: /usr/bin/local-path-provisioner\nData Namespace: nvd:cpe\nLink: [CVE-2025-22873](https://nvd.nist.gov/vuln/detail/CVE-2025-22873)",
