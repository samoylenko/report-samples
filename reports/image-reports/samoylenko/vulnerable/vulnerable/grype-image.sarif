            {
              "id": "CVE-2021-20311-libmagickwand-6.q16-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2021-20311 low vulnerability for libmagickwand-6.q16-dev package"
              },
              "fullDescription": {
                "text": "A flaw was found in ImageMagick in versions before 7.0.11, where a division by zero in sRGBTransformImage() in the MagickCore/colorspace.c may trigger undefined behavior via a crafted image file that is submitted by an attacker processed by an application using ImageMagick. The highest threat from this vulnerability is to system availability."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2021-20311\nSeverity: low\nPackage: libmagickwand-6.q16-dev\nVersion: 8:6.9.10.23+dfsg-2.1+deb10u5\nFix Version: \nType: deb\nLocation: /usr/share/doc/libmagickwand-6.q16-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2021-20311](https://security-tracker.debian.org/tracker/CVE-2021-20311)",
