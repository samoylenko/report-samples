            {
              "id": "CVE-2018-5727-libopenjp2-7",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2018-5727 low vulnerability for libopenjp2-7 package"
              },
              "fullDescription": {
