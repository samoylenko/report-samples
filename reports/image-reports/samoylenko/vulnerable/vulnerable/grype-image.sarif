            {
              "id": "CVE-2024-0450-python3.7",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2024-0450 medium vulnerability for python3.7 package"
              },
              "fullDescription": {
                "text": "An issue was found in the CPython `zipfile` module affecting versions 3.12.1, 3.11.7, 3.10.13, 3.9.18, and 3.8.18 and prior.  The zipfile module is vulnerable to “quoted-overlap” zip-bombs which exploit the zip format to create a zip-bomb with a high compression ratio. The fixed versions of CPython makes the zipfile module reject zip archives which overlap entries in the archive."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-0450\nSeverity: medium\nPackage: python3.7\nVersion: 3.7.3-2+deb10u5\nFix Version: 3.7.3-2+deb10u7\nType: deb\nLocation: /usr/share/doc/python3.7/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2024-0450](https://security-tracker.debian.org/tracker/CVE-2024-0450)",
