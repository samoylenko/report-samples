            {
              "id": "CVE-2021-20311-imagemagick",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2021-20311 low vulnerability for imagemagick package"
              },
              "fullDescription": {
