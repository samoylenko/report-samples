              }
            },
            {
              "id": "CVE-2023-5870-libpq-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-5870 medium vulnerability for libpq-dev package"
              },
              "fullDescription": {
                "text": "A flaw was found in PostgreSQL involving the pg_cancel_backend role that signals background workers, including the logical replication launcher, autovacuum workers, and the autovacuum launcher. Successful exploitation requires a non-core extension with a less-resilient background worker and would affect that specific background worker only. This issue may allow a remote high privileged user to launch a denial of service (DoS) attack."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-5870\nSeverity: medium\nPackage: libpq-dev\nVersion: 11.20-0+deb10u1\nFix Version: 11.22-0+deb10u1\nType: deb\nLocation: /usr/share/doc/libpq-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2023-5870](https://security-tracker.debian.org/tracker/CVE-2023-5870)",
