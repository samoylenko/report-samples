              },
              "properties": {
                "purls": [
                  "pkg:generic/node@16.20.2"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "CVE-2024-27982-node",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2024-27982 medium vulnerability for node package"
              },
              "fullDescription": {
                "text": "The team has identified a critical vulnerability in the http server of the most recent version of Node, where malformed headers can lead to HTTP request smuggling. Specifically, if a space is placed before a content-length header, it is not interpreted correctly, enabling attackers to smuggle in a second request within the body of the first."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-27982\nSeverity: medium\nPackage: node\nVersion: 16.20.2\nFix Version: 18.20.1,20.12.1,21.7.2\nType: binary\nLocation: /usr/local/bin/node\nData Namespace: nvd:cpe\nLink: [CVE-2024-27982](https://nvd.nist.gov/vuln/detail/CVE-2024-27982)",
