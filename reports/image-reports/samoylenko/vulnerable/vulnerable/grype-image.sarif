            {
              "id": "CVE-2020-27752-imagemagick",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2020-27752 high vulnerability for imagemagick package"
              },
              "fullDescription": {
                "text": "A flaw was found in ImageMagick in MagickCore/quantum-private.h. An attacker who submits a crafted file that is processed by ImageMagick could trigger a heap buffer overflow. This would most likely lead to an impact to application availability, but could potentially lead to an impact to data integrity as well. This flaw affects ImageMagick versions prior to 7.0.9-0."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2020-27752\nSeverity: high\nPackage: imagemagick\nVersion: 8:6.9.10.23+dfsg-2.1+deb10u5\nFix Version: \nType: deb\nLocation: /usr/share/doc/imagemagick/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2020-27752](https://security-tracker.debian.org/tracker/CVE-2020-27752)",
