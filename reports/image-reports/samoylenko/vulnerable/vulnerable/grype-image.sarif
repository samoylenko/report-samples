            {
              "id": "CVE-2017-9117-libtiff-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2017-9117 low vulnerability for libtiff-dev package"
              },
              "fullDescription": {
