              "help": {
                "text": "Vulnerability CVE-2023-52623\nSeverity: medium\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: 4.19.316-1\nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2023-52623](https://security-tracker.debian.org/tracker/CVE-2023-52623)",
