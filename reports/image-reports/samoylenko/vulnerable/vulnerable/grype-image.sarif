            {
              "id": "CVE-2019-14250-binutils",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2019-14250 low vulnerability for binutils package"
              },
              "fullDescription": {
                "text": "An issue was discovered in GNU libiberty, as distributed in GNU Binutils 2.32. simple_object_elf_match in simple-object-elf.c does not check for a zero shstrndx value, leading to an integer overflow and resultant heap-based buffer overflow."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2019-14250\nSeverity: low\nPackage: binutils\nVersion: 2.31.1-16\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:10\nLink: [CVE-2019-14250](https://security-tracker.debian.org/tracker/CVE-2019-14250)",
