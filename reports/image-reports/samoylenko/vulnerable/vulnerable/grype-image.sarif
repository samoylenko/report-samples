              },
              "properties": {
                "security-severity": "4.4"
              }
            },
            {
              "id": "CVE-2024-26751-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-26751 medium vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  ARM: ep93xx: Add terminator to gpiod_lookup_table  Without the terminator, if a con_id is passed to gpio_find() that does not exist in the lookup table the function will not stop looping correctly, and eventually cause an oops."
              },
