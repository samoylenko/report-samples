            {
              "id": "CVE-2023-4641-login",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-4641 medium vulnerability for login package"
              },
              "fullDescription": {
                "text": "A flaw was found in shadow-utils. When asking for a new password, shadow-utils asks the password twice. If the password fails on the second attempt, shadow-utils fails in cleaning the buffer used to store the first entry. This may allow an attacker with enough access to retrieve the password from the memory."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-4641\nSeverity: medium\nPackage: login\nVersion: 1:4.5-1.1\nFix Version: \nType: deb\nLocation: /usr/share/doc/login/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2023-4641](https://security-tracker.debian.org/tracker/CVE-2023-4641)",
