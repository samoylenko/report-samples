              "id": "CVE-2019-1387-git-man",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2019-1387 high vulnerability for git-man package"
              },
              "fullDescription": {
                "text": "An issue was found in Git before v2.24.1, v2.23.1, v2.22.2, v2.21.1, v2.20.2, v2.19.3, v2.18.2, v2.17.3, v2.16.6, v2.15.4, and v2.14.6. Recursive clones are currently affected by a vulnerability that is caused by too-lax validation of submodule names, allowing very targeted attacks via remote code execution in recursive clones."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2019-1387\nSeverity: high\nPackage: git-man\nVersion: 1:2.20.1-2+deb10u8\nFix Version: 1:2.20.1-2+deb10u9\nType: deb\nLocation: /usr/share/doc/git-man/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2019-1387](https://security-tracker.debian.org/tracker/CVE-2019-1387)",
