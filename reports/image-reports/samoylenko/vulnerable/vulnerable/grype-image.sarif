              }
            },
            {
              "id": "CVE-2024-27402-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-27402 medium vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  phonet/pep: fix racy skb_queue_empty() use  The receive queues are protected by their respective spin-lock, not the socket lock. This could lead to skb_peek() unexpectedly returning NULL or a pointer to an already dequeued socket buffer."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-27402\nSeverity: medium\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: \nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2024-27402](https://security-tracker.debian.org/tracker/CVE-2024-27402)",
