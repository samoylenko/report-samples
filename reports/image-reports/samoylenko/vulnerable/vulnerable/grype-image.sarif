            {
              "id": "CVE-2023-52805-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-52805 high vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  jfs: fix array-index-out-of-bounds in diAlloc  Currently there is not check against the agno of the iag while allocating new inodes to avoid fragmentation problem. Added the check which is required."
              },
              "helpUri": "https://github.com/anchore/grype",
