            {
              "id": "CVE-2019-12972-binutils-common",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2019-12972 low vulnerability for binutils-common package"
              },
              "fullDescription": {
                "text": "An issue was discovered in the Binary File Descriptor (BFD) library (aka libbfd), as distributed in GNU Binutils 2.32. There is a heap-based buffer over-read in _bfd_doprnt in bfd.c because elf_object_p in elfcode.h mishandles an e_shstrndx section of type SHT_GROUP by omitting a trailing '\\0' character."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2019-12972\nSeverity: low\nPackage: binutils-common\nVersion: 2.31.1-16\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:10\nLink: [CVE-2019-12972](https://security-tracker.debian.org/tracker/CVE-2019-12972)",
