              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2018-17360 low vulnerability for binutils-common package"
              },
              "fullDescription": {
                "text": "An issue was discovered in the Binary File Descriptor (BFD) library (aka libbfd), as distributed in GNU Binutils 2.31. a heap-based buffer over-read in bfd_getl32 in libbfd.c allows an attacker to cause a denial of service through a crafted PE file. This vulnerability can be triggered by the executable objdump."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2018-17360\nSeverity: low\nPackage: binutils-common\nVersion: 2.31.1-16\nFix Version: \nType: deb\nLocation: /usr/share/doc/binutils-common/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2018-17360](https://security-tracker.debian.org/tracker/CVE-2018-17360)",
