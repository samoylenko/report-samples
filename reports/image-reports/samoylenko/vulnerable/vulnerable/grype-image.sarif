{
  "version": "2.1.0",
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "grype",
          "version": "0.110.0",
          "informationUri": "https://github.com/anchore/grype",
          "rules": [
            {
              "id": "CVE-2023-4863-libwebp-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-4863 high vulnerability for libwebp-dev package"
              },
              "fullDescription": {
                "text": "Heap buffer overflow in libwebp in Google Chrome prior to 116.0.5845.187 and libwebp 1.3.2 allowed a remote attacker to perform an out of bounds memory write via a crafted HTML page. (Chromium security severity: Critical)"
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-4863\nSeverity: high\nPackage: libwebp-dev\nVersion: 0.6.1-2+deb10u2\nFix Version: 0.6.1-2+deb10u3\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:10\nLink: [CVE-2023-4863](https://security-tracker.debian.org/tracker/CVE-2023-4863)",
                "markdown": "**Vulnerability CVE-2023-4863**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | libwebp-dev  | 0.6.1-2+deb10u2  | 0.6.1-2+deb10u3  | deb  | /var/lib/dpkg/status  | debian:distro:debian:10  | [CVE-2023-4863](https://security-tracker.debian.org/tracker/CVE-2023-4863)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libwebp-dev@0.6.1-2%2Bdeb10u2?arch=amd64\u0026distro=debian-10\u0026upstream=libwebp"
                ],
                "security-severity": "8.8"
              }
            },
