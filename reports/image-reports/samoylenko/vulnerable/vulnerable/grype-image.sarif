              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CVE-2021-47116-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2021-47116 medium vulnerability for linux-libc-dev package"
