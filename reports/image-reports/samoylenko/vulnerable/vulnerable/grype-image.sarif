              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CVE-2024-35815-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-35815 medium vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  fs/aio: Check IOCB_AIO_RW before the struct aio_kiocb conversion  The first kiocb_set_cancel_fn() argument may point at a struct kiocb that is not embedded inside struct aio_kiocb. With the current code, depending on the compiler, the req-\u003eki_ctx read happens either before the IOCB_AIO_RW test or after that test. Move the req-\u003eki_ctx read such that it is guaranteed that the IOCB_AIO_RW test happens first."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-35815\nSeverity: medium\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: 4.19.316-1\nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2024-35815](https://security-tracker.debian.org/tracker/CVE-2024-35815)",
