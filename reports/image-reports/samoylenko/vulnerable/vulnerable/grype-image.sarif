            {
              "id": "CVE-2023-40283-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-40283 high vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "An issue was discovered in l2cap_sock_release in net/bluetooth/l2cap_sock.c in the Linux kernel before 6.4.10. There is a use-after-free because the children of an sk are mishandled."
              },
              "helpUri": "https://github.com/anchore/grype",
