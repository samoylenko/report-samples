            {
              "id": "CVE-2018-18484-binutils",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2018-18484 low vulnerability for binutils package"
              },
              "fullDescription": {
                "text": "An issue was discovered in cp-demangle.c in GNU libiberty, as distributed in GNU Binutils 2.31. Stack Exhaustion occurs in the C++ demangling functions provided by libiberty, and there is a stack consumption problem caused by recursive stack frames: cplus_demangle_type, d_bare_function_type, d_function_type."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2018-18484\nSeverity: low\nPackage: binutils\nVersion: 2.31.1-16\nFix Version: \nType: deb\nLocation: /usr/share/doc/binutils/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2018-18484](https://security-tracker.debian.org/tracker/CVE-2018-18484)",
