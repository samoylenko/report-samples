            {
              "id": "CVE-2021-20304-libopenexr-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2021-20304 low vulnerability for libopenexr-dev package"
              },
              "fullDescription": {
                "text": "A flaw was found in OpenEXR's hufDecode functionality. This flaw allows an attacker who can pass a crafted file to be processed by OpenEXR, to trigger an undefined right shift error. The highest threat from this vulnerability is to system availability."
