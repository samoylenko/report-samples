              }
            },
            {
              "id": "CVE-2024-26779-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-26779 medium vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  wifi: mac80211: fix race condition on enabling fast-xmit  fast-xmit must only be enabled after the sta has been uploaded to the driver, otherwise it could end up passing the not-yet-uploaded sta via drv_tx calls to the driver, leading to potential crashes because of uninitialized drv_priv data. Add a missing sta-\u003euploaded check and re-check fast xmit after inserting a sta."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-26779\nSeverity: medium\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: 4.19.316-1\nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2024-26779](https://security-tracker.debian.org/tracker/CVE-2024-26779)",
