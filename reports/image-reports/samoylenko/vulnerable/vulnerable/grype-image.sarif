            {
              "id": "CVE-2024-35837-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-35837 medium vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  net: mvpp2: clear BM pool before initialization  Register value persist after booting the kernel using kexec which results in kernel panic. Thus clear the BM pool registers before initialisation to fix the issue."
              },
