              "help": {
                "text": "Vulnerability CVE-2024-35967\nSeverity: high\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: \nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2024-35967](https://security-tracker.debian.org/tracker/CVE-2024-35967)",
