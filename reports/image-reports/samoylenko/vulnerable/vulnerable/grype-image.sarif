            {
              "id": "CVE-2022-1122-libopenjp2-7",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2022-1122 medium vulnerability for libopenjp2-7 package"
              },
              "fullDescription": {
                "text": "A flaw was found in the opj2_decompress program in openjpeg2 2.4.0 in the way it handles an input directory with a large number of files. When it fails to allocate a buffer to store the filenames of the input directory, it calls free() on an uninitialized pointer, leading to a segmentation fault and a denial of service."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2022-1122\nSeverity: medium\nPackage: libopenjp2-7\nVersion: 2.3.0-2+deb10u2\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:10\nLink: [CVE-2022-1122](https://security-tracker.debian.org/tracker/CVE-2022-1122)",
