              },
              "properties": {
                "security-severity": "7.8"
              }
            },
            {
              "id": "CVE-2023-5868-libpq-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-5868 medium vulnerability for libpq-dev package"
              },
              "fullDescription": {
                "text": "A memory disclosure vulnerability was found in PostgreSQL that allows remote users to access sensitive information by exploiting certain aggregate function calls with 'unknown'-type arguments. Handling 'unknown'-type values from string literals without type designation can disclose bytes, potentially revealing notable and confidential information. This issue exists due to excessive data output in aggregate function calls, enabling remote users to read some portion of system memory."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-5868\nSeverity: medium\nPackage: libpq-dev\nVersion: 11.20-0+deb10u1\nFix Version: 11.22-0+deb10u1\nType: deb\nLocation: /usr/share/doc/libpq-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2023-5868](https://security-tracker.debian.org/tracker/CVE-2023-5868)",
