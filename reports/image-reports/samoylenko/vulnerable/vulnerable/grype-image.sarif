              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "CVE-2023-52525-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-52525 high vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  wifi: mwifiex: Fix oob check condition in mwifiex_process_rx_packet  Only skip the code path trying to access the rfc1042 headers when the buffer is too small, so the driver can still process packets without rfc1042 headers."
              },
              "helpUri": "https://github.com/anchore/grype",
