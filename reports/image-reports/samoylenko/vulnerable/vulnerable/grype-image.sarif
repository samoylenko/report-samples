              }
            },
            {
              "id": "CVE-2024-27403-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-27403 medium vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  netfilter: nft_flow_offload: reset dst in route object after setting up flow  dst is transferred to the flow object, route object does not own it anymore.  Reset dst in route object, otherwise if flow_offload_add() fails, error path releases dst twice, leading to a refcount underflow."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-27403\nSeverity: medium\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: \nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2024-27403](https://security-tracker.debian.org/tracker/CVE-2024-27403)",
                "markdown": "**Vulnerability CVE-2024-27403**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | linux-libc-dev  | 4.19.289-2  |   | deb  | /usr/share/doc/linux-libc-dev/copyright  | debian:distro:debian:10  | [CVE-2024-27403](https://security-tracker.debian.org/tracker/CVE-2024-27403)  |\n"
              },
