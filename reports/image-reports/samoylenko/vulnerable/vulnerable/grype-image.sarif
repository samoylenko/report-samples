            {
              "id": "CVE-2022-48622-gir1.2-gdkpixbuf-2.0",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2022-48622 high vulnerability for gir1.2-gdkpixbuf-2.0 package"
              },
              "fullDescription": {
                "text": "In GNOME GdkPixbuf (aka gdk-pixbuf) through 2.42.10, the ANI (Windows animated cursor) decoder encounters heap memory corruption (in ani_load_chunk in io-ani.c) when parsing chunks in a crafted .ani file. A crafted file could allow an attacker to overwrite heap metadata, leading to a denial of service or code execution attack. This occurs in gdk_pixbuf_set_option() in gdk-pixbuf.c."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2022-48622\nSeverity: high\nPackage: gir1.2-gdkpixbuf-2.0\nVersion: 2.38.1+dfsg-1\nFix Version: \nType: deb\nLocation: /usr/share/doc/gir1.2-gdkpixbuf-2.0/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2022-48622](https://security-tracker.debian.org/tracker/CVE-2022-48622)",
