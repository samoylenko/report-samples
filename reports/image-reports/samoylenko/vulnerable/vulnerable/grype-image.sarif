              }
            },
            {
              "id": "CVE-2021-47348-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2021-47348 critical vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  drm/amd/display: Avoid HDCP over-read and corruption  Instead of reading the desired 5 bytes of the actual target field, the code was reading 8. This could result in a corrupted value if the trailing 3 bytes were non-zero, so instead use an appropriately sized and zero-initialized bounce buffer, and read only 5 bytes before casting to u64."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2021-47348\nSeverity: critical\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: \nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2021-47348](https://security-tracker.debian.org/tracker/CVE-2021-47348)",
