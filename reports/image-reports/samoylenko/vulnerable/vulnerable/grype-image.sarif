            {
              "id": "CVE-2019-17498-libssh2-1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2019-17498 high vulnerability for libssh2-1 package"
              },
              "fullDescription": {
                "text": "In libssh2 v1.9.0 and earlier versions, the SSH_MSG_DISCONNECT logic in packet.c has an integer overflow in a bounds check, enabling an attacker to specify an arbitrary (out-of-bounds) offset for a subsequent memory read. A crafted SSH server may be able to disclose sensitive information or cause a denial of service condition on the client system when a user connects to the server."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2019-17498\nSeverity: high\nPackage: libssh2-1\nVersion: 1.8.0-2.1\nFix Version: 1.8.0-2.1+deb10u1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:10\nLink: [CVE-2019-17498](https://security-tracker.debian.org/tracker/CVE-2019-17498)",
