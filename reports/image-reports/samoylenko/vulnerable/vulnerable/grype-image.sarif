            {
              "id": "CVE-2018-12698-binutils",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2018-12698 low vulnerability for binutils package"
              },
              "fullDescription": {
                "text": "demangle_template in cplus-dem.c in GNU libiberty, as distributed in GNU Binutils 2.30, allows attackers to trigger excessive memory consumption (aka OOM) during the \"Create an array for saving the template argument values\" XNEWVEC call. This can occur during execution of objdump."
              },
              "helpUri": "https://github.com/anchore/grype",
