{
  "version": "2.1.0",
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "grype",
          "version": "0.74.4",
          "informationUri": "https://github.com/anchore/grype",
          "rules": [
            {
              "id": "CVE-2004-0230-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2004-0230 low vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "TCP, when using a large Window Size, makes it easier for remote attackers to guess sequence numbers and cause a denial of service (connection loss) to persistent TCP connections by repeatedly injecting a TCP RST packet, especially in protocols that use long-lived connections, such as BGP."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2004-0230\nSeverity: low\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: \nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2004-0230](https://security-tracker.debian.org/tracker/CVE-2004-0230)",
                "markdown": "**Vulnerability CVE-2004-0230**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| low  | linux-libc-dev  | 4.19.289-2  |   | deb  | /usr/share/doc/linux-libc-dev/copyright  | debian:distro:debian:10  | [CVE-2004-0230](https://security-tracker.debian.org/tracker/CVE-2004-0230)  |\n"
              },
              "properties": {
                "security-severity": "5.0"
              }
            },
            {
              "id": "CVE-2005-0406-imagemagick",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2005-0406 low vulnerability for imagemagick package"
              },
              "fullDescription": {
                "text": "A design flaw in image processing software that modifies JPEG images might not modify the original EXIF thumbnail, which could lead to an information leak of potentially sensitive visual information that had been removed from the main JPEG image."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2005-0406\nSeverity: low\nPackage: imagemagick\nVersion: 8:6.9.10.23+dfsg-2.1+deb10u5\nFix Version: \nType: deb\nLocation: /usr/share/doc/imagemagick/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2005-0406](https://security-tracker.debian.org/tracker/CVE-2005-0406)",
