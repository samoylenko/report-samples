            {
              "id": "CVE-2023-5869-libpq-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-5869 high vulnerability for libpq-dev package"
              },
              "fullDescription": {
                "text": "A flaw was found in PostgreSQL that allows authenticated database users to execute arbitrary code through missing overflow checks during SQL array value modification. This issue exists due to an integer overflow during array modification where a remote user can trigger the overflow by providing specially crafted data. This enables the execution of arbitrary code on the target system, allowing users to write arbitrary bytes to memory and extensively read the server's memory."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-5869\nSeverity: high\nPackage: libpq-dev\nVersion: 11.20-0+deb10u1\nFix Version: 11.22-0+deb10u1\nType: deb\nLocation: /usr/share/doc/libpq-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2023-5869](https://security-tracker.debian.org/tracker/CVE-2023-5869)",
