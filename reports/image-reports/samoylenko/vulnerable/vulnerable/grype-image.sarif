            {
              "id": "CVE-2023-52593-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-52593 medium vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  wifi: wfx: fix possible NULL pointer dereference in wfx_set_mfp_ap()  Since 'ieee80211_beacon_get()' can return NULL, 'wfx_set_mfp_ap()' should check the return value before examining skb data. So convert the latter to return an appropriate error code and propagate it to return from 'wfx_start_ap()' as well. Compile tested only."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-52593\nSeverity: medium\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: \nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2023-52593](https://security-tracker.debian.org/tracker/CVE-2023-52593)",
