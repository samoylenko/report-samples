            {
              "id": "CVE-2022-48622-libgdk-pixbuf2.0-common",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2022-48622 high vulnerability for libgdk-pixbuf2.0-common package"
              },
              "fullDescription": {
                "text": "In GNOME GdkPixbuf (aka gdk-pixbuf) through 2.42.10, the ANI (Windows animated cursor) decoder encounters heap memory corruption (in ani_load_chunk in io-ani.c) when parsing chunks in a crafted .ani file. A crafted file could allow an attacker to overwrite heap metadata, leading to a denial of service or code execution attack. This occurs in gdk_pixbuf_set_option() in gdk-pixbuf.c."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2022-48622\nSeverity: high\nPackage: libgdk-pixbuf2.0-common\nVersion: 2.38.1+dfsg-1\nFix Version: \nType: deb\nLocation: /usr/share/doc/libgdk-pixbuf2.0-common/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2022-48622](https://security-tracker.debian.org/tracker/CVE-2022-48622)",
                "markdown": "**Vulnerability CVE-2022-48622**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | libgdk-pixbuf2.0-common  | 2.38.1+dfsg-1  |   | deb  | /usr/share/doc/libgdk-pixbuf2.0-common/copyright  | debian:distro:debian:10  | [CVE-2022-48622](https://security-tracker.debian.org/tracker/CVE-2022-48622)  |\n"
              },
              "properties": {
                "security-severity": "7.8"
              }
            },
