            {
              "id": "CVE-2021-46822-libjpeg62-turbo-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2021-46822 medium vulnerability for libjpeg62-turbo-dev package"
