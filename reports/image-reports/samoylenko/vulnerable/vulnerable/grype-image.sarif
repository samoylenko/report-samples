            {
              "id": "CVE-2018-20651-binutils",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2018-20651 low vulnerability for binutils package"
              },
              "fullDescription": {
                "text": "A NULL pointer dereference was discovered in elf_link_add_object_symbols in elflink.c in the Binary File Descriptor (BFD) library (aka libbfd), as distributed in GNU Binutils 2.31.1. This occurs for a crafted ET_DYN with no program headers. A specially crafted ELF file allows remote attackers to cause a denial of service, as demonstrated by ld."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2018-20651\nSeverity: low\nPackage: binutils\nVersion: 2.31.1-16\nFix Version: \nType: deb\nLocation: /usr/share/doc/binutils/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2018-20651](https://security-tracker.debian.org/tracker/CVE-2018-20651)",
