              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/bash@5.0-4?arch=amd64\u0026distro=debian-10"
                ],
                "security-severity": "7.8"
              }
            },
            {
              "id": "CVE-2007-3477-libwmf-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2007-3477 low vulnerability for libwmf-dev package"
              },
              "fullDescription": {
                "text": "The (a) imagearc and (b) imagefilledarc functions in GD Graphics Library (libgd) before 2.0.35 allow attackers to cause a denial of service (CPU consumption) via a large (1) start or (2) end angle degree value."
              },
              "helpUri": "https://github.com/anchore/grype",
