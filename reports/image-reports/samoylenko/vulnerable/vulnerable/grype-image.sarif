            {
              "id": "CVE-2024-26817-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2024-26817 medium vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  amdkfd: use calloc instead of kzalloc to avoid integer overflow  This uses calloc instead of doing the multiplication which might overflow."
              },
              "helpUri": "https://github.com/anchore/grype",
