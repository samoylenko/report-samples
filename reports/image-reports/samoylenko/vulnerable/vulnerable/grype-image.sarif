            {
              "id": "CVE-2023-52602-linux-libc-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-52602 high vulnerability for linux-libc-dev package"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  jfs: fix slab-out-of-bounds Read in dtSearch  Currently while searching for current page in the sorted entry table of the page there is a out of bound access. Added a bound check to fix the error.  Dave: Set return code to -EIO"
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2023-52602\nSeverity: high\nPackage: linux-libc-dev\nVersion: 4.19.289-2\nFix Version: 4.19.316-1\nType: deb\nLocation: /usr/share/doc/linux-libc-dev/copyright\nData Namespace: debian:distro:debian:10\nLink: [CVE-2023-52602](https://security-tracker.debian.org/tracker/CVE-2023-52602)",
