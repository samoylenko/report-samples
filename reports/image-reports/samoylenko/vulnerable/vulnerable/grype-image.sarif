            {
              "id": "CVE-2020-35494-binutils",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2020-35494 low vulnerability for binutils package"
              },
              "fullDescription": {
                "text": "There's a flaw in binutils /opcodes/tic4x-dis.c. An attacker who is able to submit a crafted input file to be processed by binutils could cause usage of uninitialized memory. The highest threat is to application availability with a lower threat to data confidentiality. This flaw affects binutils versions prior to 2.34."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
