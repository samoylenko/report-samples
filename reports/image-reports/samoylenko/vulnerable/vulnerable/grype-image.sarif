              "id": "CVE-2023-29491-libncurses-dev",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-29491 high vulnerability for libncurses-dev package"
              },
              "fullDescription": {
