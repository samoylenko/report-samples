                  "pkg:npm/brace-expansion@2.0.1"
                ],
                "security-severity": "1.3",
                "tags": [
                  "LOW"
                ]
              }
            },
            {
              "id": "CVE-2026-3449",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-3449: Incorrect Control Flow Scoping"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-3449?s=github&n=once&ns=%40tootallnate&t=npm&vr=%3C3.0.1",
              "help": {
                "text": "Versions of the package @tootallnate/once before 3.0.1 are vulnerable to Incorrect Control Flow Scoping in promise resolving when AbortSignal option is used. The Promise remains in a permanently pending state after the signal is aborted, causing any await or .then() usage to hang indefinitely. This can cause a control-flow leak that can lead to stalled requests, blocked workers, or degraded application availability.\n",
                "markdown": "> Versions of the package @tootallnate/once before 3.0.1 are vulnerable to Incorrect Control Flow Scoping in promise resolving when AbortSignal option is used. The Promise remains in a permanently pending state after the signal is aborted, causing any await or .then() usage to hang indefinitely. This can cause a control-flow leak that can lead to stalled requests, blocked workers, or degraded application availability.\n\n|                                                                                                                                         |\n|Package                                                                                               pkg:npm/%40tootallnate/once@2.0.0  |\n|Affected range                                                                                        <3.0.1                             |\n|Fixed version                                                                                         3.0.1                              |\n|[[CVSS Score 1.9] [CVSS Vector CVSS:4.0/AV:L/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N/E:P]]                                     |\n"
              },
              "properties": {
                "affected_version": "<3.0.1",
                "cvssV3": 1.9,
                "cvssV3_severity": "LOW",
                "cvssV3_vector": "CVSS:4.0/AV:L/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N/E:P",
                "fixed_version": "3.0.1",
                "purls": [
