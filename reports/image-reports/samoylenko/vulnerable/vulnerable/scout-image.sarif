                "cvssV3_severity": "HIGH",
                "cvssV3_vector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:N",
                "fixed_version": "7.5.8",
                "purls": [
                  "pkg:npm/tar@6.1.11"
