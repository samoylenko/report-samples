            {
              "id": "CVE-2023-21261",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-21261"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2023-21261?s=debian&n=freetype&ns=debian&t=deb&osn=debian&osv=10&vr=%3E%3D2.9.1-3%2Bdeb10u3",
              "help": {
                "text": "In ft_open_face_internal of ftobjs.c, there is a possible out of bounds read due to a missing bounds check. This could lead to remote information disclosure with no additional execution privileges needed. User interaction is not needed for exploitation.\n\n\n\n---\nREJECTED\n",
                "markdown": "> In ft_open_face_internal of ftobjs.c, there is a possible out of bounds read due to a missing bounds check. This could lead to remote information disclosure with no additional execution privileges needed. User interaction is not needed for exploitation.\n\n\n\n---\nREJECTED\n\n|                                                                                                         |\n|Package         pkg:deb/debian/freetype@2.9.1-3%2Bdeb10u3?os_distro=buster&os_name=debian&os_version=10  |\n|Affected range  >=2.9.1-3+deb10u3                                                                        |\n|Fixed version   not fixed                                                                                |\n"
              },
              "properties": {
                "affected_version": ">=2.9.1-3+deb10u3",
                "cvssV3_severity": "UNSPECIFIED",
                "fixed_version": "not fixed",
                "purls": [
                  "pkg:deb/debian/freetype@2.9.1-3%2Bdeb10u3?os_distro=buster&os_name=debian&os_version=10"
                ],
                "security-severity": "3.1",
                "tags": [
                  "UNSPECIFIED"
                ]
              }
            },
