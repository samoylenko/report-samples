            {
              "id": "CVE-2018-12123-node",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2018-12123 medium vulnerability for node package"
              },
              "fullDescription": {
                "text": "Node.js: All versions prior to Node.js 6.15.0, 8.14.0, 10.14.0 and 11.3.0: Hostname spoofing in URL parser for javascript protocol: If a Node.js application is using url.parse() to determine the URL hostname, that hostname can be spoofed by using a mixed case \"javascript:\" (e.g. \"javAscript:\") protocol (other protocols are not affected). If security decisions are made about the URL based on the hostname, they may be incorrect."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2018-12123\nSeverity: medium\nPackage: node\nVersion: 10.8.0\nFix Version: 10.14.0,11.3.0,6.15.0,8.14.0\nType: binary\nLocation: /usr/local/bin/node\nData Namespace: nvd:cpe\nLink: [CVE-2018-12123](https://nvd.nist.gov/vuln/detail/CVE-2018-12123)",
