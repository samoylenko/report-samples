                  "UNSPECIFIED"
                ]
              }
            },
            {
              "id": "GMS-2017-247",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "GMS-2017-247: OWASP Top Ten 2017 Category A9 - Using Components with Known Vulnerabilities"
              },
              "helpUri": "https://scout.docker.com/v/GMS-2017-247?s=gitlab&n=mime&t=npm&vr=%3C1.4.1",
              "help": {
                "text": "The mime module is vulnerable to regular expression denial of service when a mime lookup is performed on untrusted user input.\n",
                "markdown": "> The mime module is vulnerable to regular expression denial of service when a mime lookup is performed on untrusted user input.\n\n|                                     |\n|Package         pkg:npm/mime@1.2.11  |\n|Affected range  <1.4.1               |\n|Fixed version   1.4.1, 2.0.3         |\n"
              },
              "properties": {
