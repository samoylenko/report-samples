              }
            },
            {
              "id": "GMS-2017-323",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "GMS-2017-323: OWASP Top Ten 2017 Category A9 - Using Components with Known Vulnerabilities"
              },
              "helpUri": "https://scout.docker.com/v/GMS-2017-323?s=gitlab&n=st&t=npm&vr=%3C%3D1.2.1",
              "help": {
                "text": "An attacker is able to craft a request that results in an `HTTP ` (redirect) to an entirely different domain.\n",
                "markdown": "> An attacker is able to craft a request that results in an `HTTP ` (redirect) to an entirely different domain.\n\n|                                  |\n|Package         pkg:npm/st@0.2.4  |\n|Affected range  <=1.2.1           |\n|Fixed version   1.2.2             |\n"
              },
              "properties": {
