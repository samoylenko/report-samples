              "id": "CVE-2020-7656",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "jquery: Cross-site scripting (XSS) via \u003cscript\u003e HTML tags containing whitespaces"
              },
              "fullDescription": {
                "text": "jquery prior to 1.9.0 allows Cross-site Scripting attacks via the load method. The load method fails to recognize and remove \"\u003cscript\u003e\" HTML tags that contain a whitespace character, i.e: \"\u003c/script \u003e\", which results in the enclosed script logic to be executed."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2020-7656",
