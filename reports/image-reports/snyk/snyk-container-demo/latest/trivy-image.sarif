              "id": "CVE-2015-8839",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: ext4 filesystem page fault race condition with fallocate call."
              },
              "fullDescription": {
                "text": "Multiple race conditions in the ext4 filesystem implementation in the Linux kernel before 4.5 allow local users to cause a denial of service (disk corruption) by writing to a page that is associated with a different user's file after unsynchronized hole punching and page-fault handling."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2015-8839",
