            {
              "id": "GHSA-2mj8-pj3j-h362",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "Symlink reference outside of node_modules in bin-links"
              },
              "fullDescription": {
                "text": "Versions of `bin-links` prior to 1.1.5 are vulnerable to a Symlink reference outside of node_modules. It is possible to create symlinks to files outside of the`node_modules` folder through the `bin` field. This may allow attackers to access unauthorized files.\n\n\n## Recommendation\n\nUpgrade to version 1.1.5 or later."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://github.com/advisories/GHSA-2mj8-pj3j-h362",
