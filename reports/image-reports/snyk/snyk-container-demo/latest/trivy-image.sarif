            {
              "id": "CVE-2015-8952",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: mbcache code subject to softlockup DOS in cache management"
              },
              "fullDescription": {
                "text": "The mbcache feature in the ext2 and ext4 filesystem implementations in the Linux kernel before 4.6 mishandles xattr block caching, which allows local users to cause a denial of service (soft lockup) via filesystem operations in environments that use many attributes, as demonstrated by Ceph and Samba."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2015-8952",
              "help": {
