            {
              "id": "GHSA-2mvq-xp48-4c77",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "Denial of Service in subtext"
              },
              "fullDescription": {
                "text": "All versions of `subtext` are vulnerable to Denial of Service (DoS). The package fails to enforce the `maxBytes` configuration for payloads with chunked encoding that are written to the file system. This allows attackers to send requests with arbitrary payload sizes, which may exhaust system resources leading to Denial of Service.\n\n\n## Recommendation\n\nThis package is not actively maintained and has been moved to `@hapi/subtext` where version 6.1.2."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/advisories/GHSA-2mvq-xp48-4c77",
