{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Docker Scout",
          "informationUri": "https://docker.com/products/docker-scout",
          "name": "docker scout",
          "rules": [
            {
              "id": "GMS-2015-4",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "GMS-2015-4: OWASP Top Ten 2017 Category A9 - Using Components with Known Vulnerabilities"
              },
              "helpUri": "https://scout.docker.com/v/GMS-2015-4?s=gitlab&n=jsonwebtoken&t=npm&vr=%3C4.2.2",
              "help": {
                "text": "It is possible for an attacker to create his own signed token with any payload he wants and have it considered valid using the \"none\" algorithm.\n",
                "markdown": "> It is possible for an attacker to create his own signed token with any payload he wants and have it considered valid using the \"none\" algorithm.\n\n|                                            |\n|Package         pkg:npm/jsonwebtoken@0.1.0  |\n|Affected range  <4.2.2                      |\n|Fixed version   4.2.2                       |\n"
              },
              "properties": {
                "affected_version": "<4.2.2",
                "cvssV3_severity": "UNSPECIFIED",
                "fixed_version": "4.2.2",
                "purls": [
                  "pkg:npm/jsonwebtoken@0.1.0",
                  "pkg:npm/jsonwebtoken@0.4.0"
                ],
                "security-severity": "3.1",
                "tags": [
                  "UNSPECIFIED"
                ]
              }
            },
            {
              "id": "GMS-2016-17",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "GMS-2016-17: OWASP Top Ten 2017 Category A9 - Using Components with Known Vulnerabilities"
              },
              "helpUri": "https://scout.docker.com/v/GMS-2016-17?s=gitlab&n=sanitize-html&t=npm&vr=%3C1.11.4",
              "help": {
                "text": "sanitize-html is vulnerable to cross site scripting (XSS) in certain scenarios: If allowed at least one `nonTextTags`, the result is a potential XSS vulnerability.\n",
                "markdown": "> sanitize-html is vulnerable to cross site scripting (XSS) in certain scenarios: If allowed at least one `nonTextTags`, the result is a potential XSS vulnerability.\n\n|                                             |\n|Package         pkg:npm/sanitize-html@1.4.2  |\n|Affected range  <1.11.4                      |\n|Fixed version   1.11.4                       |\n"
              },
              "properties": {
                "affected_version": "<1.11.4",
