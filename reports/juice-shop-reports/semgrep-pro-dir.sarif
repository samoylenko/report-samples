locations":[{"physicalLocation":{"artifactLocation":{"uri":"server.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":97,"endLine":681,"snippet":{"text":"const uploadToMemory = multer({ storage: multer.memoryStorage(), limits: { fileSize: 200000 } })"},"startColumn":24,"startLine":681}}}],"message":{"text":"Affected versions of multer are vulnerable to Uncaught Exception. Multer does not handle malformed multipart upload requests correctly. A crafted request can trigger an unhandled error during file parsing, crashing the application and leading to a denial of service."},"properties":{"exposure":"reachable"},"ruleId":"ssc-3727c4eb-234c-19a7-635f-e375d4558b71"},{"fingerprints":{"matchBasedId/v1":"13456181664ae93d56fbe198e3901dfca6452940504f54fc42a065f409415777ecaea7f139759115501c2ab19190201a8896344fd0544e8831b1ecc85da63d2b_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"server.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":97,"endLine":681,"snippet":{"text":"const uploadToMemory = multer({ storage: multer.memoryStorage(), limits: { fileSize: 200000 } })"},"startColumn":24,"startLine":681}}}],"message":{"text":"Affected versions of multer are vulnerable to Uncaught Exception. The busboy-based multipart parser in Multer improperly handles certain malformed multipart/form-data requests, causing an unhandled exception that crashes the Node.js process and results in a Denial of Service."},"properties":{"exposure":"reachable"},"ruleId":"ssc-96b1c5a3-332a-817e-1379-715a73060a22"},{"fingerprints":{"matchBasedId/v1":"e41f41a14bf54ffdd80ea8c360024689b072a635acd29ec86438bb0802011a57ce922120a7c5ea5f6cdcc6943ec2202218ff6c53f480d862d6264c6045603f25_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"server.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":97,"endLine":681,"snippet":{"text":"const uploadToMemory = multer({ storage: multer.memoryStorage(), limits: { fileSize: 200000 } })"},"startColumn":24,"startLine":681}}}],"message":{"text":"Affected versions of multer are vulnerable to Uncaught Exception. A malicious actor can trigger a denial of service in Multer by submitting an upload request with an empty string for the file field name. This unhandled exception causes the process to crash when Multer attempts to process the request, creating a potentially serious availability issue."},"properties":{"exposure":"reachable"},"ruleId":"ssc-ddc75022-b0a6-5750-bfc6-1b80f123ba09"},{"fingerprints":{"matchBasedId/v1":"7b813e85f45675817ba9dfe473a4ad693afaec9062c6f659b91ba9196757e57563a3e03b3868f588b7121e1c547f5903c8dedbec438079a9682d814bc3a5e50d_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"server.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":3,"endLine":706,"snippet":{"text":"const uploadToDisk = multer({\n  storage: multer.diskStorage({\n    destination: (req: Request, file: any, cb: any) => {\n      const isValid = mimeTypeMap[file.mimetype]\n      let error: Error | null = new Error('Invalid mime type')\n      if (isValid) {\n        error = null\n      }\n      cb(error, path.resolve('frontend/dist/frontend/assets/public/images/uploads/'))\n    },\n    filename: (req: Request, file: any, cb: any) => {\n      const name = security.sanitizeFilename(file.originalname)\n        .toLowerCase()\n        .split(' ')\n        .join('-')\n      const ext = mimeTypeMap[file.mimetype]\n      cb(null, name + '-' + Date.now() + '.' + ext)\n    }\n  })\n})"},"startColumn":22,"startLine":687}}}],"message":{"text":"Affected versions of multer are vulnerable to Missing Release of Memory after Effective Lifetime. Multer improperly handles errors during file uploads: when an HTTP stream error occurs, it fails to close its internal streaming processor. Over time, this leaves unclosed streams that accumulate and exhaust memory and file descriptors, potentially leading to a denial of service scenario requiring manual intervention."},"properties":{"exposure":"reachable"},"ruleId":"ssc-1e5de89e-d770-cf32-0