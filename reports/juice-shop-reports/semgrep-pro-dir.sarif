ess-check-directory-listing.express-check-directory-listing"},{"fingerprints":{"matchBasedId/v1":"c2c7cc5931e16da7a7bc9e2fc1e98093f4c2df0159cda8677f10cd4747a7e125dbcf1faf73b825dc6d1908c737a9c354fc272b9f0bb4f3620c4a5909de3fd6be_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"server.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":109,"endLine":273,"snippet":{"text":"  app.use('/.well-known', serveIndexMiddleware, serveIndex('.well-known', { icons: true, view: 'details' }))"},"startColumn":3,"startLine":273}}}],"message":{"text":"Directory listing/indexing is enabled, which may lead to disclosure of sensitive directories and files. It is recommended to disable directory listing unless it is a public resource. If you need directory listing, ensure that sensitive files are inaccessible when querying the resource."},"properties":{},"ruleId":"javascript.express.security.audit.express-check-directory-listing.express-check-directory-listing"},{"fingerprints":{"matchBasedId/v1":"c2c7cc5931e16da7a7bc9e2fc1e98093f4c2df0159cda8677f10cd4747a7e125dbcf1faf73b825dc6d1908c737a9c354fc272b9f0bb4f3620c4a5909de3fd6be_2"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"server.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":115,"endLine":277,"snippet":{"text":"  app.use('/encryptionkeys', serveIndexMiddleware, serveIndex('encryptionkeys', { icons: true, view: 'details' }))"},"startColumn":3,"startLine":277}}}],"message":{"text":"Directory listing/indexing is enabled, which may lead to disclosure of sensitive directories and files. It is recommended to disable directory listing unless it is a public resource. If you need directory listing, ensure that sensitive files are inaccessible when querying the resource."},"properties":{},"ruleId":"javascript.express.security.audit.express-check-directory-listing.express-check-directory-listing"},{"fingerprints":{"matchBasedId/v1":"c2c7cc5931e16da7a7bc9e2fc1e98093f4c2df0159cda8677f10cd4747a7e125dbcf1faf73b825dc6d19