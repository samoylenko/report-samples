curity.ts:43'"},"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts"},"region":{"endColumn":62,"endLine":43,"message":{"text":"Source: ''md5'' @ 'lib/insecurity.ts:43'"},"snippet":{"text":"'md5'"},"startColumn":57,"startLine":43}}},"nestingLevel":0},{"location":{"message":{"text":"Sink: 'export const hash = (data: string) => crypto.createHash('md5').update(data).digest('hex')' @ 'lib/insecurity.ts:43'"},"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts"},"region":{"endColumn":62,"endLine":43,"message":{"text":"Sink: 'export const hash = (data: string) => crypto.createHash('md5').update(data).digest('hex')' @ 'lib/insecurity.ts:43'"},"snippet":{"text":"export const hash = (data: string) => crypto.createHash('md5').update(data).digest('hex')"},"startColumn":57,"startLine":43}}},"nestingLevel":1}]}]}],"fingerprints":{"matchBasedId/v1":"812786da92a1aad7a9b37716f3af91ec4e26116f7a2f09939f1f8522122dc7913c5f2f3aca178200a6ecad3d7a6dc0b0f2aa5331885867a5cae50f1acde3ebd1_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":62,"endLine":43,"snippet":{"text":"export const hash = (data: string) => crypto.createHash('md5').update(data).digest('hex')"},"startColumn":57,"startLine":43}}}],"message":{"text":"The use of a weak cryptographic algorithm (e.g., SHA-1 or MD5) has been identified. These algorithms are considered insecure due to vulnerabilities that make them susceptible to collision attacks, allowing attackers to compromise data integrity or security. Replace SHA-1 or MD5 with secure hashing algorithms, such as: SHA-256 or higher (e.g., SHA-3)."},"properties":{},"ruleId":"javascript.node-stdlib.cryptography.crypto-weak-algorithm.crypto-weak-algorithm"},{"fingerprints":{"matchBasedId/v1":"569e806f7e4276ac73f185c72e97867ad00c7577b6de01cb8ddf4d0baac7e4e87d2a1332921d7904bc42be66144ec687c33426d62ca235adbef07da7962cfc84_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":94,"endLine":44,"snippet":{"text":"export const hmac = (data: string) => crypto.createHmac('sha256', 'pa4qacea4VK9t9nGv7yZtwmj').update(data).digest('hex')"},"startColumn":39,"startLine":44}}}],"message":{"text":"Detected a hardcoded hmac key. Avoid hardcoding secrets and consider using an alternate option such as reading the secret from a config file or using an environment variable."},"properties":{},"ruleId":"javascript.lang.security.audit.hardcoded-hmac-key.hardcoded-hmac-key"},{"fingerprints":{"matchBasedId/v1":"c2c31a68326c707f414e8a4c5fd4d572e7bfcdc0b723baccec4a7eb53b69b81f8dafa6a57610383ade073e45e600c4c12829be2c130fe2b9a250f7a5a04cf895_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":77,"endLine":54,"snippet":{"text":"export const isAuthorized = () => expressJwt(({ secret: publicKey }) as any)"},"startColumn":35,"startLine":54}}}],"message":{"text":"Affected versions of express-jwt are vulnerable to Improper Authorization / Incorrect Authorization. An attacker can bypass signature verification and gain unauthorized access when using express-jwt without an explicit algorithms setting in combination with jwks-rsa. Because express-jwt doesn't require you to specify allowed algorithms, it will accept tokens signed with any (or no) algorithm fetched from the JWKS endpoint, allowing a maliciously crafted token to pass validation and bypass authorization."},"properties":{"exposure":"reachable"},"ruleId":"ssc-59e0e510-f61e-41df-9277-0554a7ca0963"},{"fingerprints":{"matchBasedId/v1":"c2c31a68326c707f414e8a4c5fd4d572e7bfcdc0b723baccec4a7eb53b69b81f8dafa6a57610383ade073e45e600c4c12829be2c130fe2b9a250f7a5a04cf895_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":79,"endLine":55,"snippet":{"text":"export const denyAll = () => expressJwt({ secret: '' + Math.random() } as any)"},"startColumn":30,"startLine":55}}}],"message":{"text":"Affected versions of express-jwt are vulnerable to Improper Authorization / Incorrect Authorization. An attacker can bypass signature verification and gain unauthorized access when using express-jwt without an explicit algorithms setting in combination with jwks-rsa. Because express-jwt doesn't require you to specify allowed algorithms, it will accept tokens signed with any (or no) algorithm fetched from the JWKS endpoint, allowing a maliciously crafted token to pass validation and bypass authorization."},"properties":{"exposure":"reachable"},"ruleId":"ssc-59e0e510-f61e-41df-9277-0554a7ca0963"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from lib/insecurity.ts:23 to lib/insecurity.ts:56"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'privateKey = '-----BEGIN RSA PRIVATE KEY-----\\r\\\\r\\n-----END RSA PRIVATE KEY-----'' @ 'lib/insecurity.ts:23'"},"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts"},"region":{"endColumn":902,"endLine":23,"message":{"text":"Source: 'privateKey = '-----BEGIN RSA PRIVATE KEY-----\\r\\\\r\\n-----END RSA PRIVATE KEY-----'' @ 'lib/insecurity.ts:23'"},"snippet":{"text":"privateKey = '-----BEGIN RSA PRIVATE KEY-----\\r\\\\r\\n-----END RSA PRIVATE KEY-----'"},"startColumn":7,"startLine":23}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'privateKey' @ 'lib/insecurity.ts:23'"},"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts"},"region":{"endColumn":17,"endLine":23,"message":{"text":"Propagator : 'privateKey' @ 'lib/insecurity.ts:23'"},"snippet":{"text":"privateKey"},"startColumn":7,"startLine":23}}},"nestingLevel":0},{"location":{"message":{"text":"Sink: 'export const authorize = (user = {}) => jwt.sign(user, privateKey, { expiresIn: '6h', algorithm: 'RS256' })' @ 'lib/insecurity.ts:56'"},"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts"},"region":{"endColumn":66,"endLine":56,"message":{"text":"Sink: 'export const authorize = (user = {}) => jwt.sign(user, privateKey, { expiresIn: '6h', algorithm: 'RS256' })' @ 'lib/insecurity.ts:56'"},"snippet":{"text":"export const authorize = (user = {}) => jwt.sign(user, privateKey, { expiresIn: '6h', algorithm: 'RS256' })"},"startColumn":56,"startLine":56}}},"nestingLevel":1}]}]}],"fingerprints":{"matchBasedId/v1":"a49b6df23d44cd84c24a0a46333b4f84c29344ebd6fc6983dc550cf5fbd28961e8d6e2ef41c00fc6ba2402f3d6970d98309fdad1dfcaa451c3046661ba13881a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":66,"endLine":56,"snippet":{"text":"export const authorize = (user = {}) => jwt.sign(user, privateKey, { expiresIn: '6h', algorithm: 'RS256' })"},"startColumn":56,"startLine":56}}}],"message":{"text":"A hard-coded credential was detected. It is not recommended to store credentials in source-code, as this risks secrets being leaked and used by either an internal or external malicious adversary. It is recommended to use environment variables to securely provide credentials or retrieve credentials from a secure vault or HSM (Hardware Security Module)."},"properties":{},"ruleId":"javascript.jsonwebtoken.security.jwt-hardcode.hardcoded-jwt-secret"},{"fingerprints":{"matchBasedId/v1":"a2b9325328efe099a0687d1639289dc9d6ec223e2aec8241fac03496b792613f24d26bd2072acd84b851171514e76141999f197a38404e38cd823938184c13b6_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":128,"endLine":57,"snippet":{"text":"export const verify = (token: string) => token ? (jws.verify as ((token: string, secret: string) => boolean))(token, publicKey) : false"},"startColumn":50,"startLine":57}}}],"message":{"text":"Affected versions of jws are vulnerable to Use of a Broken or Risky Cryptographic Algorithm. A malicious actor can tamper with the JWT's `alg` header and jws will honor that algorithm choice when verifying the token. By switching to an unsupported or weaker algorithm (e.g. \"none\" or swapping between HMAC/RSA modes), an attacker can modify any field in the JWT and still pass signature validation, resulting in a straightforward bearer‐token authentication bypass."},"properties":{"exposure":"reachable"},"ruleId":"ssc-d3651a24-fc58-7ecc-19b7-21ba3e3d2052"},{"fingerprints":{"matchBasedId/v1":"a1e4dcedae59774c4b163c7e95927b1c6fad2996d6b2f4435147fbb6f3a8fe1558559a37d1973cff764833f27b1c7b01dfb5eec27bb173342b90faf41f7914ca_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":68,"endLine":60,"snippet":{"text":"export const sanitizeHtml = (html: string) => sanitizeHtmlLib(html)"},"startColumn":47,"startLine":60}}}],"message":{"text":"Affected versions of sanitize-html are vulnerable to Inefficient Regular Expression Complexity. sanitize-html contains a vulnerability in its HTML comment removal logic that can lead to a Regular Expression Denial of Service (ReDoS). An attacker could supply crafted HTML input triggering excessive regex backtracking, potentially exhausting system resources during sanitization."},"properties":{"exposure":"reachable"},"ruleId":"ssc-7a62f16d-0da2-4e9c-978b-af50d6d8afda"},{"fingerprints":{"matchBasedId/v1":"569e806f7e4276ac73f185c72e97867ad00c7577b6de01cb8ddf4d0baac7e4e87d2a1332921d7904bc42be66144ec687c33426d62ca235adbef07da7962cfc84_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":55,"endLine":152,"snippet":{"text":"  const hmac = crypto.createHmac('sha256', privateKey)"},"startColumn":16,"startLine":152}}}],"message":{"text":"Detected a hardcoded hmac key. Avoid hardcoding secrets and consider using an alternate option such as reading the secret from a config file or using an environment variable."},"properties":{},"ruleId":"javascript.lang.security.audit.hardcoded-hmac-key.hardcoded-hmac-key"},{"fingerprints":{"matchBasedId/v1":"404af12296911ca203a259f0b17d8be8fe79a09530d8a297f0932e1250fbc7125e7fbdea08b1930e60233e852e57d739548839e772b6b95823264260efd443b1_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":7,"endLine":198,"snippet":{"text":"    jwt.verify(token, publicKey, (err: Error | null, decoded: any) => {\n      if (err === null) {\n        if (authenticatedUsers.get(token) === undefined) {\n          authenticatedUsers.put(token, decoded)\n          res.cookie('token', token)\n        }\n      }\n    })"},"startColumn":5,"startLine":191}}}],"message":{"text":"Affected versions of jsonwebtoken are vulnerable to Improper Authentication / Use Of A Broken Or Risky Cryptographic Algorithm / Improper Verification Of Cryptographic Signature. The lack of algorithm definition and a falsy secret or key in the `jwt.verify()` function can lead to signature validation bypass due to defaulting to the `none` algorithm for signature verification. Users are affected only if ALL of the following conditions are true for the `jwt.verify()` function: 1. A token with no signature is received. 2. No algorithms are specified. 3. A falsy (e.g., null, false, undefined) secret or key is passed."},"properties":{"exposure":"reachable"},"ruleId":"ssc-1803e88e-a31c-43e2-99d5-f0b14e50ba0e"},{"fingerprints":{"matchBasedId/v1":"a6cd38d673fe5a44fbe36429ad5c94e8b5b281119f34ae07e3bc776a547ba2d82f9782848ff1a164405ba0d50432a2ec6f07760dac1b449b97fbf5670e23ab78_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":7,"endLine":198,"snippet":{"text":"    jwt.verify(token, publicKey, (err: Error | null, decoded: any) => {\n      if (err === null) {\n        if (authenticatedUsers.get(token) === undefined) {\n          authenticatedUsers.put(token, decoded)\n          res.cookie('token', token)\n        }\n      }\n    })"},"startColumn":5,"startLine":191}}}],"message":{"text":"Affected version of jsonwebtoken are vulnerable to Improper Input Validation leading to a verification bypass vulnerability. This is a result of weak validation of the JWT algorithm type, occuring when an attacker is allowed to arbitrarily specify the JWT algorithm."},"properties":{"exposure":"reachable"},"ruleId":"ssc-e273f1fa-8f9b-44e0-82f3-c1011e9bd632"},{"fingerprints":{"matchBasedId/v1":"93e8603c07f085e671375ab429566580bd8338fce63ef6edcfd59cd236539e0cb222cc81fdf3cb3f481f67bd33cc790b75865376654e506f8ef437a2bacee1bc_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":195,"snippet":{"text":"          res.cookie('token', token)"},"startColumn":11,"startLine":195}}}],"message":{"text":"Having default cookie settings is insecure because they often lack critical security attributes, leaving cookies vulnerable to various attacks like CSRF or XSS. Always configure cookies with security attributes: `HttpOnly`, `Secure`, `SameSite`."},"properties":{},"ruleId":"javascript.express.web.cookies-default-express.cookies-default-express"},{"codeFlows":[{"message":{"text":"Untrusted dataflow from lib/insecurity.ts:189 to lib/insecurity.ts:195"},"threadFlows":[{"locations":[{"location":{"message":{"text":"Source: 'req.cookies' @ 'lib/insecurity.ts:189'"},"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts"},"region":{"endColumn":28,"endLine":189,"message":{"text":"Source: 'req.cookies' @ 'lib/insecurity.ts:189'"},"snippet":{"text":"req.cookies"},"startColumn":17,"startLine":189}}},"nestingLevel":0},{"location":{"message":{"text":"Propagator : 'token' @ 'lib/insecurity.ts:189'"},"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts"},"region":{"endColumn":14,"endLine":189,"message":{"text":"Propagator : 'token' @ 'lib/insecurity.ts:189'"},"snippet":{"text":"token"},"startColumn":9,"startLine":189}}},"nestingLevel":0},{"location":{"message":{"text":"Sink: 'res.cookie('token', token)' @ 'lib/insecurity.ts:195'"},"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts"},"region":{"endColumn":36,"endLine":195,"message":{"text":"Sink: 'res.cookie('token', token)' @ 'lib/insecurity.ts:195'"},"snippet":{"text":"          res.cookie('token', token)"},"startColumn":31,"startLine":195}}},"nestingLevel":1}]}]}],"fingerprints":{"matchBasedId/v1":"43d0ddbd97d16bbc9146f312a3a67cd593de0669c29a75542e6bfb5e406bdf4038da69fda244e19e0c7735c90c6b53179d007987a9cb1a5afa5e2723b97bb04e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/insecurity.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":36,"endLine":195,"snippet":{"text":"          res.cookie('token', token)"},"startColumn":31,"startLine":195}}}],"message":{"text":"Detected `req` argument which enters `res.cookie`, this can lead to session fixation vulnerabilities if an attacker can control the cookie value. This vulnerability can lead to unauthorized access to accounts, and in some esoteric cases, Cross-Site-Scripting (XSS). Users should not be able to influence cookies directly, for session cookies, they should be generated securely using an approved session management library. If the cookie does need to be set by a user, consider using an allow-list based approach to restrict the cookies which can be set."},"properties":{},"ruleId":"javascript.express.session-fixation.session-fixation"},{"fingerprints":{"matchBasedId/v1":"2fe55de96af3e117edd636c512047bbb15e1da1f559d7ce00cbac78a735d3150228c4e7ddfe23cec93eeac93fe913acc8722b8a63cfb7f5b0fd576d2526ebfaf_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/utils.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":44,"endLine":90,"snippet":{"text":"  const shaObj = new jsSHA('SHA-1', 'TEXT') // eslint-disable-line new-cap"},"startColumn":18,"startLine":90}}}],"message":{"text":"The SHA1 hashing algorithm is considered to be weak. If this is used in any sensitive operation such as password hashing, or is used to ensure data integrity (collision sensitive) then you should use a stronger hashing algorithm. For passwords, consider using `Argon2id`, `scrypt`, or `bcrypt`. For data integrity, consider using `SHA-256`."},"properties":{},"ruleId":"javascript.jssha.jssha-sha1.jssha-sha1"},{"fingerprints":{"matchBasedId/v1":"0cf9027c47e4786486fba143d467f68542eda99da7c5d984ac49fa5691c6c386f7d872e6df8fad8abb96594922dbb07c239fbfad22e8aa754b73371815c162c6_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"models/index.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":66,"endLine":30,"snippet":{"text":"const sequelize = new Sequelize('database', 'username', 'password', {"},"startColumn":58,"startLine":30}}}],"message":{"text":"A secret is hard-coded in the application. Secrets stored in source code, such as credentials, identifiers, and other types of sensitive data, can be leaked and used by internal or external malicious actors. Use environment variables to securely provide credentials and other secrets or retrieve them from a secure vault or Hardware Security Module (HSM)."},"properties":{},"ruleId":"javascript.sequelize.node-sequelize-hardcoded-secret-argument.node-sequelize-hardcoded-secret-argument"},{"fingerprints":{"matchBasedId/v1":"7eeb10db0d55515eeb8f9f632f8003e3ce8aa2f6d2b17239ecc3b0c238286fc27b3d7374503f88f1ac554845c46d56c79aa679d66e4fdaa3c6807030e0283b7b_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":2958,"snippet":{"text":"    \"node_modules/@tootallnate/once\": {"},"startColumn":1,"startLine":2958}}}],"message":{"text":"Affected versions of @tootallnate/once are vulnerable to Incorrect Control Flow Scoping."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-ef9393e8f3acf191d7ee8340cd04188efc8c7443"},{"fingerprints":{"matchBasedId/v1":"708834dfdb656f721009faa10cda8647ca439fde29f80f41fd0976ceb3a91957544946df21c58acc0a4e53f8ef4dc8b2fecbcdfa874430bb27ad1da8bab7aae3_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":5172,"snippet":{"text":"    \"node_modules/base64url\": {"},"startColumn":1,"startLine":5172}}}],"message":{"text":"Uninitialized Buffer allocation issue in base64url.encode for < 3.0.0. Please upgrade to version 3.0.0."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-8c2acbb0-c5dd-4180-bbf7-7bac48a8156a"},{"fingerprints":{"matchBasedId/v1":"4969f47db58556560486dbf431ed2c0c381de9726e2aa545b01761c3fdd6fe8cf00e18ad1584b6a1bd282e58f1ff8aea4996e00f3dcc5e498f1543b285af9bff_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":5371,"snippet":{"text":"    \"node_modules/braces\": {"},"startColumn":1,"startLine":5371}}}],"message":{"text":"Affected versions of braces are vulnerable to Excessive Platform Resource Consumption within a Loop / Uncontrolled Resource Consumption. The issue resides in `lib/parse.js`. If a malicious user sends imbalanced braces as input, this could lead to Memory Exhaustion."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-a958e8fa-d09b-ebe1-7d75-1e4136fbe2e9"},{"fingerprints":{"matchBasedId/v1":"7904a7f0cec4688afa8d9f9ab89de6854b149a8cef3b8770b204fa22a19c7bb84101cdee79628310ec69c3236f02582d95da5f5e0eae343476402cac5cd9ccd9_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":6929,"snippet":{"text":"    \"node_modules/crypto-js\": {"},"startColumn":1,"startLine":6929}}}],"message":{"text":"Affected versions of crypto-js are vulnerable to Use Of Weak Hash / Use Of Password Hash With Insufficient Computational Effort. The vulnerability in Crypto-js PBKDF2 is 1,000 times weaker than originally specified in 1993 and at least 1,300,000 times weaker than the current industry standard due to its default use of the insecure SHA1 hash algorithm and a single iteration, which poses a significant risk, potentially enabling attackers to create identical cryptographic signatures for known and unknown values when given control of a portion of the input, thereby impacting password protection and signature generation applications"},"properties":{"exposure":"unreachable"},"ruleId":"ssc-0ccd6fe9-299d-49ec-8ad2-d1139d0234ea"},{"fingerprints":{"matchBasedId/v1":"9fb26e3732706c5819c3c4df1025af4cbc1239877f90e3d71dfa08a8ea2fd37256586a35a816d806eb1c51202d0bf02449bc2978090a78ff397c6ffcfb836da0_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":7647,"snippet":{"text":"    \"node_modules/diff\": {"},"startColumn":1,"startLine":7647}}}],"message":{"text":"Affected versions of diff are vulnerable to Inefficient Regular Expression Complexity / Uncontrolled Resource Consumption."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-12b8a75ed474a41eb0ac2bf4c2ae96bb0d0489ba"},{"fingerprints":{"matchBasedId/v1":"6ab26778bcc8b2d0dc3f826100b95ec158acd81090b33f3f0f40ecea22848704b6678e8f43178eb0a35586528d922c313ca6b354f0e7bd13828de42b7f615a14_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":7982,"snippet":{"text":"    \"node_modules/engine.io\": {"},"startColumn":1,"startLine":7982}}}],"message":{"text":"engine.io versions 3.6.0 or 6.2.0 and earlier are vulnerable to an Uncaught Exception. A specially crafted HTTP request can trigger this uncaught exception and as a result will kill the Node.js process. The fix is available in versions 3.6.1 and 6.2.1"},"properties":{"exposure":"unreachable"},"ruleId":"ssc-6edc0f2e-785a-4b5a-817c-b15be7c2dd50"},{"fingerprints":{"matchBasedId/v1":"3cf00b934478ca8649ffcd15614451eb0b83de2bb126c643bad77e78bc27eb3bf1ecb994e2d29e045a269738facc4beb96ebb63938c9d0b3d0b95b4401f6fe9a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":8071,"snippet":{"text":"    \"node_modules/engine.io/node_modules/cookie\": {"},"startColumn":1,"startLine":8071}}}],"message":{"text":"Affected versions of cookie are vulnerable to Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-850b9dcb20685b9815262ddab1b91e691291c4a9"},{"fingerprints":{"matchBasedId/v1":"8f1ced4ab0bbe009f4be9beafb4e9baea5d4f0cbb24668b81247eff86a4afe9b009f873ddc6176f33fdb3c03f74d987e5334066b58ce84976d893e11abdf62fe_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":8097,"snippet":{"text":"    \"node_modules/engine.io/node_modules/ws\": {"},"startColumn":1,"startLine":8097}}}],"message":{"text":"Affected versions of ws are vulnerable to NULL Pointer Dereference. A request with a number of headers exceeding the `server.maxHeadersCount` threshold could be used to crash a ws server."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-05ec6d50-6068-8151-0449-0b9aa8e7d8f1"},{"fingerprints":{"matchBasedId/v1":"6288414bb55066f2ad78a4a5a63ab2a7d6cfe368f9bf2dc9c3a8c533a4593cf9028364fbb6162117cf96bf75fb2836ad37d3f2737038155221c8e319aa792ec2_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":9592,"snippet":{"text":"    \"node_modules/express-jwt/node_modules/jsonwebtoken\": {"},"startColumn":1,"startLine":9592}}}],"message":{"text":"Affected versions of jsonwebtoken are vulnerable to Improper Authentication. Insecure implementation of key retrieval function could lead to Forgeable Public/Private Tokens from RSA to HMAC."},"properties":{"exposure":"reachable"},"ruleId":"ssc-1676dcdc-09e4-4f68-8fa8-5ff232a5b53f"},{"fingerprints":{"matchBasedId/v1":"0c9de37da60e805d9fa1daa92fbbb542d5e978bed6c4ef390284b5ccb4616ecd6836988af199a803d14177a83d1d92bdd69c2adbc29d1c99cfa8221231257222_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":9592,"snippet":{"text":"    \"node_modules/express-jwt/node_modules/jsonwebtoken\": {"},"startColumn":1,"startLine":9592}}}],"message":{"text":"Affected versions of jsonwebtoken are vulnerable to Improper Authentication / Use Of A Broken Or Risky Cryptographic Algorithm / Improper Verification Of Cryptographic Signature. The lack of algorithm definition and a falsy secret or key in the `jwt.verify()` function can lead to signature validation bypass due to defaulting to the `none` algorithm for signature verification. Users are affected only if ALL of the following conditions are true for the `jwt.verify()` function: 1. A token with no signature is received. 2. No algorithms are specified. 3. A falsy (e.g., null, false, undefined) secret or key is passed."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-1803e88e-a31c-43e2-99d5-f0b14e50ba0e"},{"fingerprints":{"matchBasedId/v1":"989e37fdb39f93e7723302c937a60a17fde64f099638d33fda7f2a1a70baeef496cd82667638a97d3a9534ac0ae8ae54a5849b1603485219a6c1299dc283808a_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":9592,"snippet":{"text":"    \"node_modules/express-jwt/node_modules/jsonwebtoken\": {"},"startColumn":1,"startLine":9592}}}],"message":{"text":"Affected versions of jsonwebtoken are vulnerable to Use Of A Broken Or Risky Cryptographic Algorithm. The library could be misconfigured so that legacy, insecure key types are used for signature verification. For example, DSA keys could be used with the RS256 algorithm."},"properties":{"exposure":"reachable"},"ruleId":"ssc-30d12dd5-94ad-46fa-9d32-3d5477d86f3e"},{"fingerprints":{"matchBasedId/v1":"e5ef35691ca89548b763830ff19c058c2869815d277171787b8d67d035b3a1aaadd9c33a6921700e09d51e9b215d483b69b0c3c9a60005ac1ebf236ffae682e0_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":9592,"snippet":{"text":"    \"node_modules/express-jwt/node_modules/jsonwebtoken\": {"},"startColumn":1,"startLine":9592}}}],"message":{"text":"Affected version of jsonwebtoken are vulnerable to Improper Input Validation leading to a verification bypass vulnerability. This is a result of weak validation of the JWT algorithm type, occuring when an attacker is allowed to arbitrarily specify the JWT algorithm."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-e273f1fa-8f9b-44e0-82f3-c1011e9bd632"},{"fingerprints":{"matchBasedId/v1":"b62f9b1185d9c101b647f6582d08cafa5066d0876626fcebbfb102d97a16f80b561593d5a85b05b199ff3c03fb9043ea614e1b51cce829a66a139598bfa9e1ba_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":9603,"snippet":{"text":"    \"node_modules/express-jwt/node_modules/moment\": {"},"startColumn":1,"startLine":9603}}}],"message":{"text":"This vulnerability impacts npm (server) users of moment.js, especially if user provided locale string, eg fr is directly used to switch moment locale. This problem is patched in 2.29.2, and the patch can be applied to all affected versions (from 1.0.1 up until 2.29.1, inclusive)."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-23ec9966-e7e6-442b-8458-ef400508a970"},{"fingerprints":{"matchBasedId/v1":"12dcb5aad5eda40fd882c68f08281cce32b188a5651a62e8a6e2e08bb622e4b1c883655b71ae2eb38a054067546acf683f4d494a874747cedfb98f76a77a5b26_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":9603,"snippet":{"text":"    \"node_modules/express-jwt/node_modules/moment\": {"},"startColumn":1,"startLine":9603}}}],"message":{"text":"Affected versions of moment are vulnerable to Uncontrolled Resource Consumption. A low-severity regular-expression denial-of-service exists in Moment.js's date-string parser. The unanchored, unbounded regex used to recognize alphabetic or locale-specific date tokens can be tricked into catastrophic backtracking by a long, crafted input string. An attacker supplying such a string to `moment(<string>)` can cause high CPU usage and effectively DoS the host process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-30a9db12-fb6e-4dd4-85b8-cf268e95f2d6"},{"fingerprints":{"matchBasedId/v1":"43cfe898c24f48d577f84ad8890d1bb1b457fa2053bba3b3b76f2570d51142964e6de53886694c53c677570c7ef573662b985be1998fadb55537b98fbcfeb658_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":9603,"snippet":{"text":"    \"node_modules/express-jwt/node_modules/moment\": {"},"startColumn":1,"startLine":9603}}}],"message":{"text":"Affected versions of moment are vulnerable to Uncontrolled Resource Consumption. A low-severity regular-expression denial-of-service exists in Moment.js's date-string parser. The unanchored, unbounded regex used to recognize alphabetic or locale-specific date tokens can be tricked into catastrophic backtracking by a long, crafted input string. An attacker supplying such a string to `moment(<string>)` can cause high CPU usage and effectively DoS the host process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-4141e829-81a8-8dcd-77b9-c93ce9d6f915"},{"fingerprints":{"matchBasedId/v1":"dbd96dbf8298319e2c84f8cd4100a9e549305bb79a0d707b5269becb8e33d00e509f0567f158ab381f0233e55005376c009ba6bca5e4263229f8753501f0c422_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":9603,"snippet":{"text":"    \"node_modules/express-jwt/node_modules/moment\": {"},"startColumn":1,"startLine":9603}}}],"message":{"text":"Affected versions of moment are vulnerable to Uncontrolled Resource Consumption."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-469d9ed2b767e51d0e06ef9a2c126acfda07204a"},{"fingerprints":{"matchBasedId/v1":"d9fbfbab7deadd305939a22ad6e22ba8c093da2a1dadf1b21842a044da7ba72088cb0029e16d6d65d4f8f1c545f56b79cf0e817d2ce03ef164f99c95eda2de4f_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":10016,"snippet":{"text":"    \"node_modules/file-type\": {"},"startColumn":1,"startLine":10016}}}],"message":{"text":"Affected versions of file-type are vulnerable to Loop with Unreachable Exit Condition ('Infinite Loop')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-928e75621af96ab71429aa119e5d27dff027af38"},{"fingerprints":{"matchBasedId/v1":"68c9e91953cd30343e4d259992a27b6805e3161a4779507e29cad08d0244a6cdba4d7442b03c3306967303f0e148b997bf422b890b5715fa171dc26ad95e33e8_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":11102,"snippet":{"text":"    \"node_modules/got\": {"},"startColumn":1,"startLine":11102}}}],"message":{"text":"Affected versions of got are vulnerable to URL Redirection to Untrusted Site ('Open Redirect'). The vulnerability is the susceptibility to Open Redirect, stemming from the absence of verification for requested URLs, thereby enabling redirection of victims to a UNIX socket."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-344eb659-8205-4af4-a52a-803ac2d821d0"},{"fingerprints":{"matchBasedId/v1":"1b88dfd000042b8d3bafdc8bdb493cd61750f318bb20e097b48f6e9f2b974c64d07b4ad619137906ace3619f00d40b1bc816740ed87aa0f277361e622464065e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":11439,"snippet":{"text":"    \"node_modules/grunt-legacy-log/node_modules/lodash\": {"},"startColumn":1,"startLine":11439}}}],"message":{"text":"Affected versions of lodash, lodash-amd, lodash-es, and lodash.template are vulnerable to Improper Control of Generation of Code ('Code Injection'). The fix for CVE-2021-23337 added validation for the variable option in _.template but did not apply the same validation to options.imports key names. Both paths flow into the same Function() constructor sink. When an application passes untrusted input as options.imports key names, an attacker can inject default-parameter expressions — for example, a key such as x=process.getBuiltinModule(\"child_process\").execSync(\"curl attacker.com\") — that execute arbitrary code at template compile time. Additionally, _.template uses assignInWith to merge imports, which enumerates inherited properties via for..in; if Object.prototype has been polluted by any prior gadget, the polluted keys are silently absorbed into the imports object and passed to Function(). NOTE: The package `lodash.template` has been depreacted and the author suggested to use `eta` instead."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-013c16da-8fa9-440f-9ed4-482cb04a213a"},{"fingerprints":{"matchBasedId/v1":"b1f3471ab24014987b781cd541d350853669b7ce0a2a6fa3200a3b793a4b44cf5555d12617e8feed4a3358ccb73b005b97002a788886149cde6c6433cdee03e9_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":11439,"snippet":{"text":"    \"node_modules/grunt-legacy-log/node_modules/lodash\": {"},"startColumn":1,"startLine":11439}}}],"message":{"text":"Affected versions of lodash, lodash-amd, lodash-es, and lodash.template are vulnerable to Improper Control of Generation of Code ('Code Injection'). The fix for CVE-2021-23337 added validation for the variable option in _.template but did not apply the same validation to options.imports key names. Both paths flow into the same Function() constructor sink. When an application passes untrusted input as options.imports key names, an attacker can inject default-parameter expressions — for example, a key such as x=process.getBuiltinModule(\"child_process\").execSync(\"curl attacker.com\") — that execute arbitrary code at template compile time. Additionally, _.template uses assignInWith to merge imports, which enumerates inherited properties via for..in; if Object.prototype has been polluted by any prior gadget, the polluted keys are silently absorbed into the imports object and passed to Function(). NOTE: The package `lodash.template` has been depreacted and the author suggested to use `eta` instead."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-de7b6910-98c8-4dcd-bafb-32afb39a42d0"},{"fingerprints":{"matchBasedId/v1":"c28052800932b601f7e050b4494b88224d40c7ed0cc6fa3395f7864ffc37d1877c2ebc0dd123a99a6121e5a3a4c3a33844738a2c5b35e4185e1c49ac00356181_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":11439,"snippet":{"text":"    \"node_modules/grunt-legacy-log/node_modules/lodash\": {"},"startColumn":1,"startLine":11439}}}],"message":{"text":"Affected versions of lodash, lodash-amd, lodash-es, and lodash.unset are vulnerable to Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-c714e65ad7bc693bac224574cea006373f0e1c0a"},{"fingerprints":{"matchBasedId/v1":"fd19c3b1b920a08fd0a0d7e8e8788ed6253cc6f9659d1090739c7559a390f0c3340ded8d600d04cee500155bb72f5c5384bfa2b5cf25e002a27d5a56f4c338be_2"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":11622,"snippet":{"text":"    \"node_modules/grunt/node_modules/minimatch\": {"},"startColumn":1,"startLine":11622}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Regular Expression Complexity. `minimatch` is vulnerable to Regular Expression Denial of Service (ReDoS): if an attacker can supply a glob pattern containing many consecutive `*` wildcards followed by a literal that is absent from the target string, the generated `RegExp` (many repeated `[^/]*?` groups) can trigger exponential backtracking in V8, causing a single `minimatch()` call to consume excessive CPU and hang the process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-40d82dae-3e96-1f67-fcf3-417f7f234067"},{"fingerprints":{"matchBasedId/v1":"b58bce8e670e6eb7dcc1cad365c38e0731e5116d87473fdb2cc7b1ad7208b37073db9ae24b4aeec7c599362ae0f633a8a7851f89f3dc9b7acac5a45cbca4d1a5_2"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":11622,"snippet":{"text":"    \"node_modules/grunt/node_modules/minimatch\": {"},"startColumn":1,"startLine":11622}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Algorithmic Complexity. `minimatch()` can be forced into extreme CPU usage (event loop starvation / DoS) when matching non‑matching paths against attacker-controlled glob patterns containing multiple non-adjacent `**` (globstar) segments. In `matchOne()`, each globstar triggers unbounded recursive backtracking over all remaining path suffixes, with no memoization or budget limit, causing binomial/exponential growth in work and allowing small crafted patterns to stall a Node.js process for seconds to tens of seconds per call."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-73cb5f8a-88db-d7e0-fdc8-f3ce32a64cda"},{"fingerprints":{"matchBasedId/v1":"afb89fe445ecfae9b155dde9ab362467461f3c825330e0f27a4fa51bdd1ec0bcfe46dfd7760156cd8f061b96c4778b55ee21bcbcc3c0941fb9c3b6d693db95cf_2"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":11622,"snippet":{"text":"    \"node_modules/grunt/node_modules/minimatch\": {"},"startColumn":1,"startLine":11622}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Regular Expression Complexity. `minimatch()` is vulnerable to Regular Expression Denial of Service (ReDoS) when processing attacker-controlled extglob patterns: nested `*()` or `+()` extglobs are compiled into regexes with nested unbounded quantifiers (e.g. `(?:(?:a|b)*)*`), which can trigger catastrophic backtracking in V8 and stall the Node.js event loop for seconds to minutes when matched against a crafted non-matching path string."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-de7e5e44-137c-659f-f78f-f8f8730411b4"},{"fingerprints":{"matchBasedId/v1":"e97b66082dca402ddb09f06732629d9fe743a672bce21ed799b7829b0c48639216e7c9ca5a00b0c8ac2289900f0ddcaceb7bf3550e5736ca7c98673de59b8fce_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":12027,"snippet":{"text":"    \"node_modules/http-cache-semantics\": {"},"startColumn":1,"startLine":12027}}}],"message":{"text":"http-cache-semantics versions before 4.1.1 are vulnerable to Inefficient Regular Expression Complexity leading to Denial of Service. The issue can be exploited via malicious request header values sent to a server, when that server reads the cache policy from the request using this library."},"properties":{"exposure":"reachable"},"ruleId":"ssc-4e59e976-8886-47a3-9b32-abcb3212a6c1"},{"fingerprints":{"matchBasedId/v1":"6288414bb55066f2ad78a4a5a63ab2a7d6cfe368f9bf2dc9c3a8c533a4593cf9028364fbb6162117cf96bf75fb2836ad37d3f2737038155221c8e319aa792ec2_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":15930,"snippet":{"text":"    \"node_modules/jsonwebtoken\": {"},"startColumn":1,"startLine":15930}}}],"message":{"text":"Affected versions of jsonwebtoken are vulnerable to Improper Authentication. Insecure implementation of key retrieval function could lead to Forgeable Public/Private Tokens from RSA to HMAC."},"properties":{"exposure":"reachable"},"ruleId":"ssc-1676dcdc-09e4-4f68-8fa8-5ff232a5b53f"},{"fingerprints":{"matchBasedId/v1":"989e37fdb39f93e7723302c937a60a17fde64f099638d33fda7f2a1a70baeef496cd82667638a97d3a9534ac0ae8ae54a5849b1603485219a6c1299dc283808a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":15930,"snippet":{"text":"    \"node_modules/jsonwebtoken\": {"},"startColumn":1,"startLine":15930}}}],"message":{"text":"Affected versions of jsonwebtoken are vulnerable to Use Of A Broken Or Risky Cryptographic Algorithm. The library could be misconfigured so that legacy, insecure key types are used for signature verification. For example, DSA keys could be used with the RS256 algorithm."},"properties":{"exposure":"reachable"},"ruleId":"ssc-30d12dd5-94ad-46fa-9d32-3d5477d86f3e"},{"fingerprints":{"matchBasedId/v1":"5a73a5e8d570f02f91b1de97fd5f2192e5694d3b8366d8fa69b47eedfc3f45da2346766e19e462d9409ca05649d2a17b7393e0c2d81a3e15822ee86e6f4e73ba_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":16008,"snippet":{"text":"    \"node_modules/jws\": {"},"startColumn":1,"startLine":16008}}}],"message":{"text":"Affected versions of jws are vulnerable to Improper Verification of Cryptographic Signature. When using node-jws's streaming API (jws.createVerify()) with an HMAC algorithm (e.g. HS256), and the application derives the HMAC secret from user-controlled fields in the JWS protected header or payload, an attacker can craft a token that hijacks the secret lookup and bypasses signature verification, allowing arbitrary token forgery."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-0c587c32-681e-1011-91d9-b83299f66ccc"},{"fingerprints":{"matchBasedId/v1":"41bdcc7cdc5e8da5a7471620b6a32386193ac45c8bf3f5dbd98a99092ce807d223893eb030ccf2cd91226b6fa96597ec25adc9432813956e674bb55536d465af_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":16008,"snippet":{"text":"    \"node_modules/jws\": {"},"startColumn":1,"startLine":16008}}}],"message":{"text":"Affected versions of jws are vulnerable to Improper Verification of Cryptographic Signature. When using node-jws's streaming API (jws.createVerify()) with an HMAC algorithm (e.g. HS256), and the application derives the HMAC secret from user-controlled fields in the JWS protected header or payload, an attacker can craft a token that hijacks the secret lookup and bypasses signature verification, allowing arbitrary token forgery."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-794b2581-1eab-4e44-b6f1-7d2f13a20e38"},{"fingerprints":{"matchBasedId/v1":"fc98e98639024f9320ac9adcd7d88ce31f377f16909bcfad10511c0d87485be4afc8ac18a81122e7f7ccbf3e82d9c306c4cd9b5ed45185bc04d4d62ec3ecdc7d_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":16534,"snippet":{"text":"    \"node_modules/lodash.set\": {"},"startColumn":1,"startLine":16534}}}],"message":{"text":"Affected versions of lodash, lodash-es, lodash.pick, lodash.set, lodash.setwith, lodash.update, and lodash.updatewith are vulnerable to Allocation of Resources Without Limits or Throttling / Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution'). The function `zipObjectDeep` allows a malicious user to modify the prototype of Object if the property identifiers are user-supplied. Being affected by this issue requires zipping objects based on user-provided property arrays. This vulnerability causes the addition or modification of an existing property that will exist on all objects and may lead to Denial of Service or Code Execution under specific circumstances. Note that the Lodash per-method packages (lodash.pick, .set, .setWith, .update, .updateWith) have no fix version and cannot be upgraded to fix this vulnerability. Instead, you have to use the main `lodash` package and import your desired methods from that (e.g. `const pick = require(\"lodash/pick\");` or `import { pick } from \"lodash\";`)."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-4d530ee8-c246-47d7-96cc-3117cbac7cd2"},{"fingerprints":{"matchBasedId/v1":"5b6c3f0a90937c4b497e7b14ef1803621dc15b7e45b995adc63c4f60a35ccc3eb3c5d145644e793dc2221144584a23fe1d57bf4bf76daf58543b1f13b03d5196_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":16902,"snippet":{"text":"    \"node_modules/marsdb\": {"},"startColumn":1,"startLine":16902}}}],"message":{"text":"Affected version of marsdb is vulnerable to Improper Neutralization Of Special Elements Used In A Command ('Command Injection') due to unsanitized selectors being passed to a function constructor."},"properties":{"exposure":"reachable"},"ruleId":"ssc-3e3fce71-fce7-4711-bf72-5e337f753066"},{"fingerprints":{"matchBasedId/v1":"83ca8b0fdadef2c6dd563ce6aa61e943da6120f3694b2458bcc8fd2f494ac88318a2ea280784eee10d0f11aafffd1fbb2837c07e36de032b5dacdfdd9299ab1e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17035,"snippet":{"text":"    \"node_modules/micromatch\": {"},"startColumn":1,"startLine":17035}}}],"message":{"text":"Affected versions of micromatch are vulnerable to Inefficient Regular Expression Complexity."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-f66dd5b2b6a3d5520040df0a25f4783c2d5264b5"},{"fingerprints":{"matchBasedId/v1":"fd19c3b1b920a08fd0a0d7e8e8788ed6253cc6f9659d1090739c7559a390f0c3340ded8d600d04cee500155bb72f5c5384bfa2b5cf25e002a27d5a56f4c338be_3"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17120,"snippet":{"text":"    \"node_modules/minimatch\": {"},"startColumn":1,"startLine":17120}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Regular Expression Complexity. `minimatch` is vulnerable to Regular Expression Denial of Service (ReDoS): if an attacker can supply a glob pattern containing many consecutive `*` wildcards followed by a literal that is absent from the target string, the generated `RegExp` (many repeated `[^/]*?` groups) can trigger exponential backtracking in V8, causing a single `minimatch()` call to consume excessive CPU and hang the process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-40d82dae-3e96-1f67-fcf3-417f7f234067"},{"fingerprints":{"matchBasedId/v1":"b58bce8e670e6eb7dcc1cad365c38e0731e5116d87473fdb2cc7b1ad7208b37073db9ae24b4aeec7c599362ae0f633a8a7851f89f3dc9b7acac5a45cbca4d1a5_3"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17120,"snippet":{"text":"    \"node_modules/minimatch\": {"},"startColumn":1,"startLine":17120}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Algorithmic Complexity. `minimatch()` can be forced into extreme CPU usage (event loop starvation / DoS) when matching non‑matching paths against attacker-controlled glob patterns containing multiple non-adjacent `**` (globstar) segments. In `matchOne()`, each globstar triggers unbounded recursive backtracking over all remaining path suffixes, with no memoization or budget limit, causing binomial/exponential growth in work and allowing small crafted patterns to stall a Node.js process for seconds to tens of seconds per call."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-73cb5f8a-88db-d7e0-fdc8-f3ce32a64cda"},{"fingerprints":{"matchBasedId/v1":"afb89fe445ecfae9b155dde9ab362467461f3c825330e0f27a4fa51bdd1ec0bcfe46dfd7760156cd8f061b96c4778b55ee21bcbcc3c0941fb9c3b6d693db95cf_3"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17120,"snippet":{"text":"    \"node_modules/minimatch\": {"},"startColumn":1,"startLine":17120}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Regular Expression Complexity. `minimatch()` is vulnerable to Regular Expression Denial of Service (ReDoS) when processing attacker-controlled extglob patterns: nested `*()` or `+()` extglobs are compiled into regexes with nested unbounded quantifiers (e.g. `(?:(?:a|b)*)*`), which can trigger catastrophic backtracking in V8 and stall the Node.js event loop for seconds to minutes when matched against a crafted non-matching path string."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-de7e5e44-137c-659f-f78f-f8f8730411b4"},{"fingerprints":{"matchBasedId/v1":"ddd29f091c2debf9865089ddea7c3423b9eece4d5c952e05c78a817d3aee65b5bc516549c506d59e433da49dddec1708c2093b7042146c3fc3793e47042a7120_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17537,"snippet":{"text":"    \"node_modules/mocha/node_modules/js-yaml\": {"},"startColumn":1,"startLine":17537}}}],"message":{"text":"Affected versions of js-yaml are vulnerable to Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-cbd46cc5e3fbd5237121198aa2470bfd23161753"},{"fingerprints":{"matchBasedId/v1":"fd19c3b1b920a08fd0a0d7e8e8788ed6253cc6f9659d1090739c7559a390f0c3340ded8d600d04cee500155bb72f5c5384bfa2b5cf25e002a27d5a56f4c338be_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17563,"snippet":{"text":"    \"node_modules/mocha/node_modules/minimatch\": {"},"startColumn":1,"startLine":17563}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Regular Expression Complexity. `minimatch` is vulnerable to Regular Expression Denial of Service (ReDoS): if an attacker can supply a glob pattern containing many consecutive `*` wildcards followed by a literal that is absent from the target string, the generated `RegExp` (many repeated `[^/]*?` groups) can trigger exponential backtracking in V8, causing a single `minimatch()` call to consume excessive CPU and hang the process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-40d82dae-3e96-1f67-fcf3-417f7f234067"},{"fingerprints":{"matchBasedId/v1":"b58bce8e670e6eb7dcc1cad365c38e0731e5116d87473fdb2cc7b1ad7208b37073db9ae24b4aeec7c599362ae0f633a8a7851f89f3dc9b7acac5a45cbca4d1a5_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17563,"snippet":{"text":"    \"node_modules/mocha/node_modules/minimatch\": {"},"startColumn":1,"startLine":17563}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Algorithmic Complexity. `minimatch()` can be forced into extreme CPU usage (event loop starvation / DoS) when matching non‑matching paths against attacker-controlled glob patterns containing multiple non-adjacent `**` (globstar) segments. In `matchOne()`, each globstar triggers unbounded recursive backtracking over all remaining path suffixes, with no memoization or budget limit, causing binomial/exponential growth in work and allowing small crafted patterns to stall a Node.js process for seconds to tens of seconds per call."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-73cb5f8a-88db-d7e0-fdc8-f3ce32a64cda"},{"fingerprints":{"matchBasedId/v1":"efa8c2cf369309b6b2993834e622932cb9e3427d3c290abeb8464dd8c2e8d2cfd79d78324badc241e247c672c0972dd38b1b5a84afa5b9d158bfbd8e6f874415_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17563,"snippet":{"text":"    \"node_modules/mocha/node_modules/minimatch\": {"},"startColumn":1,"startLine":17563}}}],"message":{"text":"minimatch 3.x before 3.0.5 is vulnerable to uncontrolled resource consumption. A user could cause a validation regex to experience catastrophic backtracking if user input is passed to `braceExpand(...)`. Upgrade to minimatch 3.0.5."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-d0cedbca-8368-4baa-9b38-d246afca95e5"},{"fingerprints":{"matchBasedId/v1":"afb89fe445ecfae9b155dde9ab362467461f3c825330e0f27a4fa51bdd1ec0bcfe46dfd7760156cd8f061b96c4778b55ee21bcbcc3c0941fb9c3b6d693db95cf_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17563,"snippet":{"text":"    \"node_modules/mocha/node_modules/minimatch\": {"},"startColumn":1,"startLine":17563}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Regular Expression Complexity. `minimatch()` is vulnerable to Regular Expression Denial of Service (ReDoS) when processing attacker-controlled extglob patterns: nested `*()` or `+()` extglobs are compiled into regexes with nested unbounded quantifiers (e.g. `(?:(?:a|b)*)*`), which can trigger catastrophic backtracking in V8 and stall the Node.js event loop for seconds to minutes when matched against a crafted non-matching path string."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-de7e5e44-137c-659f-f78f-f8f8730411b4"},{"fingerprints":{"matchBasedId/v1":"938e2a48b0dbb799041c055f97353a695e0b5f00611ef24fbac1891e2df403b432e118565314be05834a692fc087ac4a3a0c8a76aecac1ebd1bb79fa7d1956be_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17723,"snippet":{"text":"    \"node_modules/multer\": {"},"startColumn":1,"startLine":17723}}}],"message":{"text":"Affected versions of multer are vulnerable to Missing Release of Resource after Effective Lifetime. Multer's multipart upload handling can be abused to cause a Denial of Service: an attacker can start a file upload and then drop the connection mid-stream, leaving upload parsing/resources (e.g., streams/buffers/file handles) tied up and potentially exhausting server resources."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-7db3f6a7-e1c8-aa6c-a294-e1d4d0ce5576"},{"fingerprints":{"matchBasedId/v1":"02d5aab8659079731895434a2687cf4959b720b2598e5de34b4b93da7427c7b6037068954764ff85ef7358e5a4387e08b1c5ae2ef89ac2c2dc14a4a4e4d08d34_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17723,"snippet":{"text":"    \"node_modules/multer\": {"},"startColumn":1,"startLine":17723}}}],"message":{"text":"Affected versions of multer are vulnerable to Incomplete Cleanup. Improper handling of error states during file upload processing can leave file streams unconsumed, allowing repeated malformed requests to accumulate unreleased resources and potentially exhaust server memory or file descriptors."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-b66ff60e-4e42-40c3-9231-86d7b67282f1"},{"fingerprints":{"matchBasedId/v1":"422dcc7c4700830337fa958f638aabd42fa57cfedca0c063aeb9dce648c6ca460285753d16243c36fc8355b4c3c75815fc2856f705f891d9cd69b2267b82f709_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17723,"snippet":{"text":"    \"node_modules/multer\": {"},"startColumn":1,"startLine":17723}}}],"message":{"text":"Affected versions of multer are vulnerable to Uncontrolled Recursion. Multer's `multipart/form-data` request handling is vulnerable to a denial of service: an attacker can send a malformed multipart upload request that triggers excessive/recursive processing and causes a stack overflow, crashing the Node.js process (or making the service unresponsive)."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-d689b441-460e-4870-9334-5ce1a169bf6f"},{"fingerprints":{"matchBasedId/v1":"a84c70f6212619102214cd1d05e7a6f293f4cc11b15736ce6342466ce6dd9b0f2f9a008bdb427967a96f049465ad407736a87384069295e6d9cf9e9ab7ce4735_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17758,"snippet":{"text":"    \"node_modules/nanoid\": {"},"startColumn":1,"startLine":17758}}}],"message":{"text":"Affected versions of nanoid are vulnerable to Loop with Unreachable Exit Condition ('Infinite Loop')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-1db037c51064e8ea3ee503f6b2c05bd51b27b4b4"},{"fingerprints":{"matchBasedId/v1":"2e912f9f2e922a12f19428256839412fd8f594b013356ca95e0c8b7854be60ba94f75af098ed12074e3f19f7c012d4c8324245494ccab005ab534184e43c4bb0_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":17758,"snippet":{"text":"    \"node_modules/nanoid\": {"},"startColumn":1,"startLine":17758}}}],"message":{"text":"Affected versions of nanoid are vulnerable to Exposure of Sensitive Information to an Unauthorized Actor / Incorrect Type Conversion or Cast."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-492b121300fa3a2eb327c12dd1067f5920c291ce"},{"fingerprints":{"matchBasedId/v1":"38ebf0cac634b63820f67ade61aa217507a583b62aa720f012a87b8efd4704a75e9a4ce21fefe8d47e962fabb871ea462d22792964cf4942fb53c4ea5a717f46_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":18205,"snippet":{"text":"    \"node_modules/node-pre-gyp/node_modules/tar\": {"},"startColumn":1,"startLine":18205}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal'). Node `tar`'s `tar.extract()` can be abused by a malicious tar archive to escape the extraction directory via a symlink + hardlink trick: the archive creates symlinks inside the extract root and then a hardlink whose resolved target points outside the root. Because hardlink target validation is string-based and does not resolve on-disk symlinks, `tar` will create a file inside the extraction directory that is actually a hardlink to an external file, enabling arbitrary file read/write as the extracting user when processing attacker-controlled archives with default options."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-57bed0d1-ff99-ee22-f61c-8b06726885f0"},{"fingerprints":{"matchBasedId/v1":"e5a4259b98e2077d244396270a4341a7dc0952885ff5446871e434bff3055ad834c6bd3dfa504fe46332fbf578a706cf32f9269ae41120386483fa7408c4a8e0_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":18205,"snippet":{"text":"    \"node_modules/node-pre-gyp/node_modules/tar\": {"},"startColumn":1,"startLine":18205}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal'). `tar`'s extractor can be bypassed to create a symlink that escapes the intended extraction root by using a drive-relative Windows-style link target like `C:../../../target.txt`. When such an attacker-controlled tarball is extracted via normal `tar.x({ cwd, file })`, the escape check is performed against the pre-stripped linkpath but the symlink is created with the stripped `../../../target.txt` value, allowing subsequent writes through the extracted symlink to overwrite arbitrary files outside `cwd` with the permissions of the extracting process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-7756a4fb-c6e4-1e33-48ed-f809b32adb6d"},{"fingerprints":{"matchBasedId/v1":"eb80798aba936e272e8de5dc36105d3ce438ea51d2baf442cdcb77628f76775106a9f53a4872e61db2a3137d849a8ac446d1a16736ffdabe60ace310f7627b87_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":18205,"snippet":{"text":"    \"node_modules/node-pre-gyp/node_modules/tar\": {"},"startColumn":1,"startLine":18205}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Handling of Unicode Encoding / Time-of-check Time-of-use (TOCTOU) Race Condition. On macOS APFS/HFS+, node-tar's PathReservations uses NFD Unicode normalization and toLowerCase, but APFS treats \"ß\" and \"ss\" as equivalent. This mismatch lets colliding entries bypass the library's serialization locks during parallel extraction, creating a race condition that an attacker can exploit to overwrite or poison arbitrary files."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-93acdc4b-eb31-9132-0256-b6d198072b35"},{"fingerprints":{"matchBasedId/v1":"53bfef9da74c05511573ac8a739a9c5a24141a9c6514453b976426b5fea042f58ca093bf7075a9999bed2806355d495497f5aa2279eb5b2c5480001c4bb63e6a_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":18205,"snippet":{"text":"    \"node_modules/node-pre-gyp/node_modules/tar\": {"},"startColumn":1,"startLine":18205}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal') / Improper Link Resolution Before File Access ('Link Following'). In node-tar's unpack logic, hardlink entries are validated by normalizing the link path against the entry's parent directory but are actually created by resolving the link path against the extraction root. An attacker can craft a TAR with a hardlink whose linkpath passes the traversal check yet resolves outside the target directory—allowing creation of hardlinks to arbitrary files and enabling read or write access to sensitive host files."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-ab0d68e2-2d7d-dcf8-dd0b-8d2b907409be"},{"fingerprints":{"matchBasedId/v1":"d499f80fd44b71eecf543ab6d3797581c99a41f36e893756f8f6c1ab7746af7f6b56a0e26951ce6834903ca40c5c7f6d6d91af6abb1e702c0bbca599d6191689_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":18205,"snippet":{"text":"    \"node_modules/node-pre-gyp/node_modules/tar\": {"},"startColumn":1,"startLine":18205}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal'). In node-tar's unpack logic, Link (hardlink) and SymbolicLink entries with absolute or \"..\" linkpaths aren't checked against the extraction root when preservePaths is false. An attacker-supplied archive can therefore create a hardlink to any writable file (bypassing the root restriction) to overwrite it, or drop a symlink pointing to a sensitive absolute path, leading to arbitrary file overwrite and symlink poisoning during extraction."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-b6383582-549e-8975-031d-241b64fc5ac4"},{"fingerprints":{"matchBasedId/v1":"b48370541d9638c442b80c061d0aa44cf6629c056334d26852ec2467433b7196b5f6565de2530ba385dc42c3c44d5bbbe42b0dcb7af3188869613d56cba10d6d_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":18205,"snippet":{"text":"    \"node_modules/node-pre-gyp/node_modules/tar\": {"},"startColumn":1,"startLine":18205}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal') / Improper Link Resolution Before File Access ('Link Following'). `node-tar` can be abused during normal `tar.x()` extraction to write files outside the intended `cwd` by crafting a hardlink entry whose `linkpath` uses a drive-relative target like `C:../target.txt`. Because the unpack logic checks for `..` path traversal segments before stripping the absolute root (`C:`), the link target is rewritten to `../target.txt` after validation, allowing the extracted hardlink to resolve outside the extraction directory and enabling arbitrary file overwrite with the extractor's privileges."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-d4117188-df1d-8856-27d7-223751823516"},{"fingerprints":{"matchBasedId/v1":"0c597f881436c66bb3e4aac614dd0ee119256fb3efde825ba98973b396646b8ec752671121f03279a45593091294a100cbbf4d402e34c62bf3f66c9c223539a8_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":18205,"snippet":{"text":"    \"node_modules/node-pre-gyp/node_modules/tar\": {"},"startColumn":1,"startLine":18205}}}],"message":{"text":"Affected versions of node-tar and tar are vulnerable to Uncontrolled Resource Consumption."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-bf3ed6711421da70ed0c75ee079fa70d59120a3c"},{"fingerprints":{"matchBasedId/v1":"52ef7090a6989a21bafd11ffc6a2f5d65786966293a3f27d384c0a0f77fe71152cde08e21ba47c1a8227e96cacf07fad3901f022f2d751552b8229a22a3e480c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":18304,"snippet":{"text":"    \"node_modules/notevil\": {"},"startColumn":1,"startLine":18304}}}],"message":{"text":"Affected versions of argencoders-notevil and notevil are vulnerable to Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-abaa3266ce0b302029925e8f43985ab59830a972"},{"fingerprints":{"matchBasedId/v1":"b35473dc87e766d71d0ce52f1e8664c2b5b99ac1df0e79658396b1ff364d9992be756a4c68fd614cad118600c004b23bf5c31a92968a47b571f00197a6a980a1_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":19311,"snippet":{"text":"    \"node_modules/parseuri\": {"},"startColumn":1,"startLine":19311}}}],"message":{"text":"Affected versions of parse-uri and parseuri are vulnerable to Incorrect Regular Expression / Inefficient Regular Expression Complexity."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-f9c9bc29868808e4062bc05a19f8682abfaec91c"},{"fingerprints":{"matchBasedId/v1":"fd19c3b1b920a08fd0a0d7e8e8788ed6253cc6f9659d1090739c7559a390f0c3340ded8d600d04cee500155bb72f5c5384bfa2b5cf25e002a27d5a56f4c338be_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":20717,"snippet":{"text":"    \"node_modules/replace/node_modules/minimatch\": {"},"startColumn":1,"startLine":20717}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Regular Expression Complexity. `minimatch` is vulnerable to Regular Expression Denial of Service (ReDoS): if an attacker can supply a glob pattern containing many consecutive `*` wildcards followed by a literal that is absent from the target string, the generated `RegExp` (many repeated `[^/]*?` groups) can trigger exponential backtracking in V8, causing a single `minimatch()` call to consume excessive CPU and hang the process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-40d82dae-3e96-1f67-fcf3-417f7f234067"},{"fingerprints":{"matchBasedId/v1":"b58bce8e670e6eb7dcc1cad365c38e0731e5116d87473fdb2cc7b1ad7208b37073db9ae24b4aeec7c599362ae0f633a8a7851f89f3dc9b7acac5a45cbca4d1a5_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":20717,"snippet":{"text":"    \"node_modules/replace/node_modules/minimatch\": {"},"startColumn":1,"startLine":20717}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Algorithmic Complexity. `minimatch()` can be forced into extreme CPU usage (event loop starvation / DoS) when matching non‑matching paths against attacker-controlled glob patterns containing multiple non-adjacent `**` (globstar) segments. In `matchOne()`, each globstar triggers unbounded recursive backtracking over all remaining path suffixes, with no memoization or budget limit, causing binomial/exponential growth in work and allowing small crafted patterns to stall a Node.js process for seconds to tens of seconds per call."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-73cb5f8a-88db-d7e0-fdc8-f3ce32a64cda"},{"fingerprints":{"matchBasedId/v1":"afb89fe445ecfae9b155dde9ab362467461f3c825330e0f27a4fa51bdd1ec0bcfe46dfd7760156cd8f061b96c4778b55ee21bcbcc3c0941fb9c3b6d693db95cf_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":20717,"snippet":{"text":"    \"node_modules/replace/node_modules/minimatch\": {"},"startColumn":1,"startLine":20717}}}],"message":{"text":"Affected versions of minimatch are vulnerable to Inefficient Regular Expression Complexity. `minimatch()` is vulnerable to Regular Expression Denial of Service (ReDoS) when processing attacker-controlled extglob patterns: nested `*()` or `+()` extglobs are compiled into regexes with nested unbounded quantifiers (e.g. `(?:(?:a|b)*)*`), which can trigger catastrophic backtracking in V8 and stall the Node.js event loop for seconds to minutes when matched against a crafted non-matching path string."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-de7e5e44-137c-659f-f78f-f8f8730411b4"},{"fingerprints":{"matchBasedId/v1":"5e33dac1f0a863405a7c001820f1d48245a6ab53b0896a54c8a6e1793d2eb536d95f889e1b0f1445978c0da0ef1b96dc97bb03c50eb27b94a86daf99b87e10a4_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21224,"snippet":{"text":"    \"node_modules/sanitize-html\": {"},"startColumn":1,"startLine":21224}}}],"message":{"text":"Affected versions of sanitize-html are vulnerable to Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-15f565af1a90934442c651d3d4e785fd038c1ee6"},{"fingerprints":{"matchBasedId/v1":"3a6bf3bc24f89c82fe90ef1533b5955c5f7f700727329c1a7eb291e7c2eb0495a13fb3b785dcaed36cd325cbbe46e22292bc5a4bba1e6c4a97c4f43e7453ab86_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21224,"snippet":{"text":"    \"node_modules/sanitize-html\": {"},"startColumn":1,"startLine":21224}}}],"message":{"text":"Affected versions of sanitize-html are vulnerable to Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-2116655b299c20e833dbcfb1bb550db781be3c2f"},{"fingerprints":{"matchBasedId/v1":"2996a3eefc4e7c81db16f2f685bc0f3fc3f2394763793870d8a5d9b63fb04a0cbb862a366ea099501e9581728e6b84fe79bb107a37c97767233cbf34ef8d2141_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21224,"snippet":{"text":"    \"node_modules/sanitize-html\": {"},"startColumn":1,"startLine":21224}}}],"message":{"text":"Affected versions of sanitize-html are vulnerable to Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-a17610b4e3f9c730602473f4a5754655078a737b"},{"fingerprints":{"matchBasedId/v1":"ce97eacabc93ff700d4e1197ce2eab61680a50bc8709134821ceb1884b08508e31efc6e2db76663a1f756664ce5297cb7b33d477a608feb1af47c4c523f27e52_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21224,"snippet":{"text":"    \"node_modules/sanitize-html\": {"},"startColumn":1,"startLine":21224}}}],"message":{"text":"Affected versions of sanitize-html are vulnerable to Improper Input Validation."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-d74328b5afd10e4da18da0bc2305b3fb2912d913"},{"fingerprints":{"matchBasedId/v1":"cad1ae2106067f44908354036c112afc3265857653a4558417092528e118b0d0c6526e3669d934b231f9a64a8f801d2b680804f4888613b131e10f7c0f7d21e2_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21224,"snippet":{"text":"    \"node_modules/sanitize-html\": {"},"startColumn":1,"startLine":21224}}}],"message":{"text":"Affected versions of sanitize-html are vulnerable to Improper Input Validation."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-dd0e66e167e16de33e5e8c5d6473f2de24d64139"},{"fingerprints":{"matchBasedId/v1":"284c8a6cb13994abdac53e932158dc0fd90a8e75387052a4037a6a9d06a501fbbefc0d36e4d7ea03aec1d8f1ff4aaed0ab147085814b375479f15e5f0c058694_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21224,"snippet":{"text":"    \"node_modules/sanitize-html\": {"},"startColumn":1,"startLine":21224}}}],"message":{"text":"Affected versions of sanitize-html are vulnerable to Exposure of Sensitive Information to an Unauthorized Actor / Insertion of Sensitive Information into Externally-Accessible File or Directory."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-f043c1af9896d1bf70e356fdfa91ee45840c9502"},{"fingerprints":{"matchBasedId/v1":"b01b412672deb2ca12d7a6b15d7b899bb05d36613527fbea25d80c7bb983fb6f6a3e85cb18ad97697abcc2a047656867a0c1839e157214e141871cb3ce411ad8_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21282,"snippet":{"text":"    \"node_modules/sanitize-html/node_modules/lodash\": {"},"startColumn":1,"startLine":21282}}}],"message":{"text":"Affected versions of lodash are vulnerable to Uncontrolled Resource Consumption. Vulnerable functions allow a malicious user to cause the addition or modification of an existing proprty that exists on all objects."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-29317a8b-48ec-4715-9dc0-a658e559fa23"},{"fingerprints":{"matchBasedId/v1":"78120ff55d038a0fb6c518694639b3b5f67b1c594b3686626c83bcf80e24e54d0dc556e03e4b0103924842c275d34118e471b81a7d8e970cf6ffe037fe64905e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21282,"snippet":{"text":"    \"node_modules/sanitize-html/node_modules/lodash\": {"},"startColumn":1,"startLine":21282}}}],"message":{"text":"Affected versions of lodash, lodash-amd, lodash-es, and lodash.defaultsdeep are vulnerable to Improper Input Validation / Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution'). The function `defaultsDeep` allows a malicious user to modify the prototype of `Object` via `{constructor: {prototype: {...}}}` causing the addition or modification of an existing property that will exist on all objects."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-a4fd0e64-ce76-449c-8e09-743db9edce4e"},{"fingerprints":{"matchBasedId/v1":"66ce2a764b85160ce147d4b649617992e852159bf0cd5cddced34a5b9340623937c4c5e931ae999faa96716c0937b1d57104d0675427523c41a1c572fb55f0bc_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21282,"snippet":{"text":"    \"node_modules/sanitize-html/node_modules/lodash\": {"},"startColumn":1,"startLine":21282}}}],"message":{"text":"lodash versions prior to 4.17.21 (or lodash.template version 4.6.2) are vulnerable to Command Injection via the template function. Please remediate by updating to version 4.17.21 (or 4.6.2). https://github.com/advisories/GHSA-35jh-r3h4-6jhm"},"properties":{"exposure":"unreachable"},"ruleId":"ssc-c6bc1896-7044-4b22-b31a-753d52070423"},{"fingerprints":{"matchBasedId/v1":"7dd3c5db5549d6e8ded1efaf0afb135909b56dcb39c3eee833e5c0e9ef60b90fc87fc938808039db532190f44f03bd59b09435af177cbd69f48ead057e5f06ca_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21282,"snippet":{"text":"    \"node_modules/sanitize-html/node_modules/lodash\": {"},"startColumn":1,"startLine":21282}}}],"message":{"text":"Affected versions of lodash are vulnerable to Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution') / Modification of Assumed-Immutable Data (MAID)."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-93ce7052914c85569ca454d3b8fab96bf78c1800"},{"fingerprints":{"matchBasedId/v1":"c28052800932b601f7e050b4494b88224d40c7ed0cc6fa3395f7864ffc37d1877c2ebc0dd123a99a6121e5a3a4c3a33844738a2c5b35e4185e1c49ac00356181_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21282,"snippet":{"text":"    \"node_modules/sanitize-html/node_modules/lodash\": {"},"startColumn":1,"startLine":21282}}}],"message":{"text":"Affected versions of lodash, lodash-amd, lodash-es, and lodash.unset are vulnerable to Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-c714e65ad7bc693bac224574cea006373f0e1c0a"},{"fingerprints":{"matchBasedId/v1":"a8846b822c3e0a3840009002b880c0a904259eb329b83a701e9f115fd18356a5dc9de38a56bac12ca1fe29a0668cf1cbb8fd54cd661fd62060678980e09d9c1a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21471,"snippet":{"text":"    \"node_modules/serialize-javascript\": {"},"startColumn":1,"startLine":21471}}}],"message":{"text":"Affected versions of serialize-javascript are vulnerable to Improper Neutralization of Directives in Statically Saved Code ('Static Code Injection'). `serialize-javascript` is vulnerable to code injection when serializing non-plain objects that masquerade as `RegExp` or `Date`. The library sanitizes `RegExp.source` but interpolates `RegExp.flags` (and similarly the result of `Date.prototype.toISOString()`) directly into the generated JavaScript without escaping, allowing an attacker who controls the input to `serialize()` to inject arbitrary JavaScript into the serialized output. If the consumer later evaluates that string (e.g., via `eval`, `new Function`, or embedding in a `<script>` tag), the injected payload executes and can lead to remote code execution in Node.js."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-91463f38-8762-1266-b448-b001465e1611"},{"fingerprints":{"matchBasedId/v1":"aa0ad8a22ad6feb534003a01356a2d5e5be1dfc009a61a04b538c59e4ba5becf5921cf7af8fa217bfa9c75f1bc39f28321ec819dd11051619cd69e8cb034bfbd_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":21471,"snippet":{"text":"    \"node_modules/serialize-javascript\": {"},"startColumn":1,"startLine":21471}}}],"message":{"text":"Affected versions of serialize-javascript are vulnerable to Excessive Iteration / Uncontrolled Resource Consumption."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-4553a5d1293773ae6c24c22040588bce5af6942b"},{"fingerprints":{"matchBasedId/v1":"48b7e4b1aac0bb94200dcbb99bda1cac8961c1961586ea7322651e02bf9bafce82ff7cc22fab5b67e1d4dc9571121bf779b5eb9702f4939f29de2b8ed02e9a78_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":22140,"snippet":{"text":"    \"node_modules/socket.io\": {"},"startColumn":1,"startLine":22140}}}],"message":{"text":"Affected versions of socket.io are vulnerable to Improper Check for Unusual or Exceptional Conditions / Improper Input Validation. A specially crafted Socket.IO packet can trigger an uncaught exception on the Socket.IO server, thus killing the Node.js process. This is valid if a user has NOT explicitly defined a listener for the `error` event."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-f72bbe54-9f89-99bd-d4d5-e299a184467a"},{"fingerprints":{"matchBasedId/v1":"1e36ce1b502c7397850bc7c7e60cce9a85b42dee10ad8eac915166e2a1ce071b09c82cb07b319f693bba8fa04d57d5c0f41d92fc2928ba018ba6ef71c20b3bed_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":22203,"snippet":{"text":"    \"node_modules/socket.io-parser\": {"},"startColumn":1,"startLine":22203}}}],"message":{"text":"socket.io-parser versions >= 4.0.4 before 4.2.3, >= 3.4.0 before 3.4.3 are vulnerable to Improper Check or Handling of Exceptional Conditions. A specially crafted Socket.IO packet can trigger an uncaught exception on the Socket.IO serve during decoding, thus killing the Node.js process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-3f91adfe-244f-49f3-b9b5-f3e516b1bf09"},{"fingerprints":{"matchBasedId/v1":"164055352a25aee412b77b439b09f882eb93baa22b9557590788af0f908cfa2ae71e4cd429b48c133aceba5fda9508d48afd31a72822bea1ecd8dc624b121c32_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":22203,"snippet":{"text":"    \"node_modules/socket.io-parser\": {"},"startColumn":1,"startLine":22203}}}],"message":{"text":"Affected versions of socket.io-parser are vulnerable to Improper Check for Unusual or Exceptional Conditions. A specially crafted packet declaring an unbounded binary attachment count causes the server to buffer attachments indefinitely, leading to memory exhaustion and Denial of Service"},"properties":{"exposure":"unreachable"},"ruleId":"ssc-92dfdaab-e3a4-4dc5-bad7-8b083919e98d"},{"fingerprints":{"matchBasedId/v1":"7eeb10db0d55515eeb8f9f632f8003e3ce8aa2f6d2b17239ecc3b0c238286fc27b3d7374503f88f1ac554845c46d56c79aa679d66e4fdaa3c6807030e0283b7b_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":22528,"snippet":{"text":"    \"node_modules/sqlite3/node_modules/@tootallnate/once\": {"},"startColumn":1,"startLine":22528}}}],"message":{"text":"Affected versions of @tootallnate/once are vulnerable to Incorrect Control Flow Scoping."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-ef9393e8f3acf191d7ee8340cd04188efc8c7443"},{"fingerprints":{"matchBasedId/v1":"38ebf0cac634b63820f67ade61aa217507a583b62aa720f012a87b8efd4704a75e9a4ce21fefe8d47e962fabb871ea462d22792964cf4942fb53c4ea5a717f46_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":23009,"snippet":{"text":"    \"node_modules/sqlite3/node_modules/tar\": {"},"startColumn":1,"startLine":23009}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal'). Node `tar`'s `tar.extract()` can be abused by a malicious tar archive to escape the extraction directory via a symlink + hardlink trick: the archive creates symlinks inside the extract root and then a hardlink whose resolved target points outside the root. Because hardlink target validation is string-based and does not resolve on-disk symlinks, `tar` will create a file inside the extraction directory that is actually a hardlink to an external file, enabling arbitrary file read/write as the extracting user when processing attacker-controlled archives with default options."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-57bed0d1-ff99-ee22-f61c-8b06726885f0"},{"fingerprints":{"matchBasedId/v1":"e5a4259b98e2077d244396270a4341a7dc0952885ff5446871e434bff3055ad834c6bd3dfa504fe46332fbf578a706cf32f9269ae41120386483fa7408c4a8e0_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":23009,"snippet":{"text":"    \"node_modules/sqlite3/node_modules/tar\": {"},"startColumn":1,"startLine":23009}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal'). `tar`'s extractor can be bypassed to create a symlink that escapes the intended extraction root by using a drive-relative Windows-style link target like `C:../../../target.txt`. When such an attacker-controlled tarball is extracted via normal `tar.x({ cwd, file })`, the escape check is performed against the pre-stripped linkpath but the symlink is created with the stripped `../../../target.txt` value, allowing subsequent writes through the extracted symlink to overwrite arbitrary files outside `cwd` with the permissions of the extracting process."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-7756a4fb-c6e4-1e33-48ed-f809b32adb6d"},{"fingerprints":{"matchBasedId/v1":"eb80798aba936e272e8de5dc36105d3ce438ea51d2baf442cdcb77628f76775106a9f53a4872e61db2a3137d849a8ac446d1a16736ffdabe60ace310f7627b87_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":23009,"snippet":{"text":"    \"node_modules/sqlite3/node_modules/tar\": {"},"startColumn":1,"startLine":23009}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Handling of Unicode Encoding / Time-of-check Time-of-use (TOCTOU) Race Condition. On macOS APFS/HFS+, node-tar's PathReservations uses NFD Unicode normalization and toLowerCase, but APFS treats \"ß\" and \"ss\" as equivalent. This mismatch lets colliding entries bypass the library's serialization locks during parallel extraction, creating a race condition that an attacker can exploit to overwrite or poison arbitrary files."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-93acdc4b-eb31-9132-0256-b6d198072b35"},{"fingerprints":{"matchBasedId/v1":"53bfef9da74c05511573ac8a739a9c5a24141a9c6514453b976426b5fea042f58ca093bf7075a9999bed2806355d495497f5aa2279eb5b2c5480001c4bb63e6a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":23009,"snippet":{"text":"    \"node_modules/sqlite3/node_modules/tar\": {"},"startColumn":1,"startLine":23009}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal') / Improper Link Resolution Before File Access ('Link Following'). In node-tar's unpack logic, hardlink entries are validated by normalizing the link path against the entry's parent directory but are actually created by resolving the link path against the extraction root. An attacker can craft a TAR with a hardlink whose linkpath passes the traversal check yet resolves outside the target directory—allowing creation of hardlinks to arbitrary files and enabling read or write access to sensitive host files."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-ab0d68e2-2d7d-dcf8-dd0b-8d2b907409be"},{"fingerprints":{"matchBasedId/v1":"d499f80fd44b71eecf543ab6d3797581c99a41f36e893756f8f6c1ab7746af7f6b56a0e26951ce6834903ca40c5c7f6d6d91af6abb1e702c0bbca599d6191689_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":23009,"snippet":{"text":"    \"node_modules/sqlite3/node_modules/tar\": {"},"startColumn":1,"startLine":23009}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal'). In node-tar's unpack logic, Link (hardlink) and SymbolicLink entries with absolute or \"..\" linkpaths aren't checked against the extraction root when preservePaths is false. An attacker-supplied archive can therefore create a hardlink to any writable file (bypassing the root restriction) to overwrite it, or drop a symlink pointing to a sensitive absolute path, leading to arbitrary file overwrite and symlink poisoning during extraction."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-b6383582-549e-8975-031d-241b64fc5ac4"},{"fingerprints":{"matchBasedId/v1":"b48370541d9638c442b80c061d0aa44cf6629c056334d26852ec2467433b7196b5f6565de2530ba385dc42c3c44d5bbbe42b0dcb7af3188869613d56cba10d6d_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":23009,"snippet":{"text":"    \"node_modules/sqlite3/node_modules/tar\": {"},"startColumn":1,"startLine":23009}}}],"message":{"text":"Affected versions of tar are vulnerable to Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal') / Improper Link Resolution Before File Access ('Link Following'). `node-tar` can be abused during normal `tar.x()` extraction to write files outside the intended `cwd` by crafting a hardlink entry whose `linkpath` uses a drive-relative target like `C:../target.txt`. Because the unpack logic checks for `..` path traversal segments before stripping the absolute root (`C:`), the link target is rewritten to `../target.txt` after validation, allowing the extracted hardlink to resolve outside the extraction directory and enabling arbitrary file overwrite with the extractor's privileges."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-d4117188-df1d-8856-27d7-223751823516"},{"fingerprints":{"matchBasedId/v1":"5638b281c175d641a8be6b1d1e78b414c2a759d49136f1d303c53106aab2807837a6a668f27767a3d90c4e8c29cd56ab6d916d7501c448aa60e4b132071a4997_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":25015,"snippet":{"text":"    \"node_modules/vm2\": {"},"startColumn":1,"startLine":25015}}}],"message":{"text":"vm2 versions before and including 3.9.19 are vulnerable to Sandbox Escape. `Promise` handler sanitization can be bypassed, allowing attackers to escape the sandbox and run arbitrary code."},"properties":{"exposure":"reachable"},"ruleId":"ssc-020778f8-d42f-49f0-88bc-af77d7f9644b"},{"fingerprints":{"matchBasedId/v1":"799ac2f87022e1262802108664c28bd6bec71a837e6fa1c508e883470eb283309587e79d5df070aaf17ac40a01b2854a11103314ad62ab4e90968faa29ac0513_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":25015,"snippet":{"text":"    \"node_modules/vm2\": {"},"startColumn":1,"startLine":25015}}}],"message":{"text":"Affected versions of vm2 are vulnerable to Improper Neutralization Of Special Elements Used In An Os Command ('Os Command Injection')."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-aa66b26b-de8a-4f15-ac57-57c713f557f9"},{"fingerprints":{"matchBasedId/v1":"a1ac73760dc3431338b5b8c4459f0c4fbcd9a74851bda3485dd3c29fdabe270086efb34fcd2a202b19f82182fd897957251302edaa5f5af6b73099e6697f7e3a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":25015,"snippet":{"text":"    \"node_modules/vm2\": {"},"startColumn":1,"startLine":25015}}}],"message":{"text":"Affected versions of vm2 are vulnerable to Improper Control of Dynamically-Managed Code Resources / Improper Control of Generation of Code ('Code Injection') / Protection Mechanism Failure. `Promise.prototype.then`, `Promise.prototype.catch` callback sanitization can be bypassed. This allows attackers to escape the sandbox and run arbitrary code."},"properties":{"exposure":"reachable"},"ruleId":"ssc-e34c7458-920e-4172-a670-bb83d66253a7"},{"fingerprints":{"matchBasedId/v1":"682d76ea3c635a652a2dee16fbab1fe60f5391c76620604597174791d9488fab6052320c69b2d42aa4ccf0575927910df80e6e5f2e8d16ee2a8412b2e27d5e46_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":25015,"snippet":{"text":"    \"node_modules/vm2\": {"},"startColumn":1,"startLine":25015}}}],"message":{"text":"vm2 versions before 3.9.18 are vulnerable to Improper Neutralization Of Special Elements In Output Used By A Downstream Component ('Injection'). A threat actor can bypass the sandbox protections to gain remote code execution rights on the host running the sandbox."},"properties":{"exposure":"reachable"},"ruleId":"ssc-f313bdfc-0f29-4bfd-8089-baf2817fc586"},{"fingerprints":{"matchBasedId/v1":"9ee026b6b6d8a3e760b1c65db5b18d244b754175e515830f1138d1e7fad98d59f31b951f2f339209b5a58339328c5051a5c40e3f5ae1547da522cd5f6e1cb41e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"package-lock.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":25015,"snippet":{"text":"    \"node_modules/vm2\": {"},"startColumn":1,"startLine":25015}}}],"message":{"text":"Affected versions of vm2 are vulnerable to Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-6b886b7bf608b9d7af0777bde92fa0fee5fbe5d1"},{"fingerprints":{"matchBasedId/v1":"e01c731c2550964f89f10f77e5f70699d8ed36b5fcff0d8c6595e6a5df639b25182b951b7c4e9967fc536f0aafeac67bbf4c7004aeb71fd0c3febdfb0e8f3ac2_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"reports/scout-dir.sarif","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1193,"endLine":976,"snippet":{"text":"                \"text\": \"## Description: \\nDuring some analysis today on npm's `node-tar` package I came across the folder creation process, Basicly if you provide node-tar with a path like this `./a/b/c/foo.txt` it would create every folder and sub-folder here a, b and c until it reaches the last folder to create `foo.txt`, In-this case I noticed that there's no validation at all on the amount of folders being created, that said we're actually able to CPU and memory consume the system running node-tar and even crash the nodejs client within few seconds of running it using a path with too many sub-folders inside\\n\\n## Steps To Reproduce:\\nYou can reproduce this issue by downloading the tar file I provided in the resources and using node-tar to extract it, you should get the same behavior as the video\\n\\n## Proof Of Concept:\\nHere's a [video](https://hackerone-us-west-2-production-attachments.s3.us-west-2.amazonaws.com/3i7uojw8s52psar6pg8zkdo4h9io?response-content-disposition=attachment%3B%20filename%3D%22tar-dos-poc.webm%22%3B%20filename%2A%3DUTF-8%27%27tar-dos-poc.webm&response-content-type=video%2Fwebm&X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=ASIAQGK6FURQSWWGDXHA%2F20240312%2Fus-west-2%2Fs3%2Faws4_request&X-Amz-Date=20240312T080103Z&X-Amz-Expires=3600&X-Amz-Security-Token=IQoJb3JpZ2luX2VjEDcaCXVzLXdlc3QtMiJHMEUCID3xYDc6emXVPOg8iVR5dVk0u3gguTPIDJ0OIE%2BKxj17AiEAi%2BGiay1gGMWhH%2F031fvMYnSsa8U7CnpZpxvFAYqNRwgqsQUIQBADGgwwMTM2MTkyNzQ4NDkiDAaj6OgUL3gg4hhLLCqOBUUrOgWSqaK%2FmxN6nKRvB4Who3LIyzswFKm9LV94GiSVFP3zXYA480voCmAHTg7eBL7%2BrYgV2RtXbhF4aCFMCN3qu7GeXkIdH7xwVMi9zXHkekviSKZ%2FsZtVVjn7RFqOCKhJl%2FCoiLQJuDuju%2FtfdTGZbEbGsPgKHoILYbRp81K51zeRL21okjsOehmypkZzq%2BoGrXIX0ynPOKujxw27uqdF4T%2BF9ynodq01vGgwgVBEjHojc4OKOfr1oW5b%2FtGVV59%2BOBVI1hqIKHRG0Ed4SWmp%2BLd1hazGuZPvp52szmegnOj5qr3ubppnKL242bX%2FuAnQKzKK0HpwolqXjsuEeFeM85lxhqHV%2B1BJqaqSHHDa0HUMLZistMRshRlntuchcFQCR6HBa2c8PSnhpVC31zMzvYMfKsI12h4HB6l%2FudrmNrvmH4LmNpi4dZFcio21DzKj%2FRjWmxjH7l8egDyG%2FIgPMY6Ls4IiN7aR