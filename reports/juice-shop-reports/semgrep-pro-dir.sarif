})\"]]},\"engine_kind\":\"PRO\"}},{\"check_id\":\"javascript.express.security.audit.express-detect-notevil-usage.express-detect-notevil-usage\",\"path\":\"routes/b2bOrder.ts\",\"start\":{\"line\":23,\"col\":9,\"offset\":907},\"end\":{\"line\":23,\"col\":80,\"offset\":978},\"extra\":{\"metavars\":{\"$EVAL\":{\"start\":{\"line\":9,\"col\":10,\"offset\":303},\"end\":{\"line\":9,\"col\":14,\"offset\":307},\"abstract_content\":\"eval\"},\"$VM\":{\"start\":{\"line\":23,\"col\":9,\"offset\":907},\"end\":{\"line\":23,\"col\":11,\"offset\":909},\"abstract_content\":\"vm\"},\"$CMD\":{\"start\":{\"line\":23,\"col\":26,\"offset\":924},\"end\":{\"line\":23,\"col\":50,\"offset\":948},\"abstract_content\":\"safeEval(orderLinesData)\"}},\"message\":\"Detected usage of the `notevil` package, which is unmaintained and has vulnerabilities. Using any sort of `eval()` functionality can be very dangerous, but if you must, the `eval` package is an up to date alternative. Be sure that only trusted input reaches an `eval()` function.\",\"metadata\":{\"category\":\"security\",\"references\":[\"https://github.com/mmckegg/notevil\"],\"cwe\":[\"CWE-1104: Use of Unmaintained Third Party Components\"],\"owasp\":[\"A06:2021 - Vulnerable and Outdated Components\",\"A03:2025 - Software Supply Chain Failures\"],\"technology\":[\"javascript\",\"typescript\"],\"subcategory\":[\"audit\"],\"likelihood\":\"LOW\",\"impact\":\"HIGH\",\"confidence\":\"LOW\",\"license\":\"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license\",\"vulnerability_class\":[\"Other\"],\"source\":\"https://semgrep.dev/r/javascript.express.security.audit.express-detect-notevil-usage.express-detect-notevil-usage\",\"shortlink\":\"https://sg.run/W70E\",\"semgrep.dev\":{\"rule\":{\"origin\":\"community\",\"r_id\":22553,\"rule_id\":\"OrUX9K\",\"rv_id\":1263136,\"url\":\"https://semgrep.dev/playground/r/e1TyjGl/javascript.express.security.audit.express-detect-notevil-usage.express-detect-notevil-usage\",\"version_id\":\"e1TyjGl\"}}},\"severity\":\"WARNING\",\"fingerprint\":\"33bcc5132b4d5bffcecb8598c170e17a15f89c2092dd6ac354d71d432263db9379d18abe26db25cbef08dd1f3324f3517cfe64c9c2d43696f9fcdea1d1e1a045_0\",\"lines\":\"        vm.runInContext('safeEval(orderLinesData)', sandbox, { timeout: 2000 })\",\"is_ignored\":false,\"validation_state\":\"NO_VALIDATOR\",\"engine_kind\":\"PRO\"}},{\"check_id\":\"javascript.browser.security.eval-detected.eval-detected\",\"path\":\"routes/captcha.ts\",\"start\":{\"line\":22,\"col\":20,\"offset\":874},\"end\":{\"line\":22,\"col\":36,\"offset\":890},\"extra\":{\"metavars\":{},\"message\":\"Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources.\",\"metadata\":{\"cwe\":[\"CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')\"],\"owasp\":[\"A03:2021 - Injection\",\"A05:2025 - Injection\"],\"asvs\":{\"control_id\":\"5.2.4 Dynamic Code Execution Features\",\"control_url\":\"https://github.com/OWASP/ASVS/blob/master/4.0/en/0x13-V5-Validation-Sanitization-Encoding.md#v52-sanitization-and-sandboxing\",\"section\":\"V5 Validation, Sanitization and Encoding\",\"version\":\"4\"},\"category\":\"security\",\"technology\":[\"browser\"],\"subcategory\":[\"audit\"],\"likelihood\":\"LOW\",\"impact\":\"MEDIUM\",\"confidence\":\"LOW\",\"references\":[\"https://owasp.org/Top10/A03_2021-Injection\"],\"license\":\"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license\",\"vulnerability_class\":[\"Code Injection\"],\"source\":\"https://semgrep.dev/r/javascript.browser.security.eval-detected.eval-detected\",\"shortlink\":\"https://sg.run/7ope\",\"semgrep.dev\":{\"rule\":{\"origin\":\"community\",\"r_id\":9238,\"rule_id\":\"GdU7dw\",\"rv_id\":1263117,\"url\":\"https://semgrep.dev/playground/r/l4TJR2y/javascript.browser.security.eval-detected.eval-detected\",\"version_id\":\"l4TJR2y\"}}},\"severity\":\"WARNING\",\"fingerprint\":\"30e76aaa5bef79d7d1e08ea08a077f36bd5d9208a7539558327aaa05a7eeef20a0ebbda2e94cc6c562cdde67be2b6ab108bdfa8ceb90fa79d57cd6dff4c9bfee_0\",\"lines\":\"    const answer = eval(expression).toString() // eslint-disable-line no-eval\",\"is_ignored\":false,\"validation_state\":\"NO_VALIDATOR\",\"engine_kind\":\"PRO\"}},{\"check_id\":\"javascript.express.security.audit.remote-property-injection.remote-property-injection\",\"path\":\"routes/currentUser.ts\",\"start\":{\"line\":31,\"col\":15,\"offset\":1260},\"end\":{\"line\":31,\"col\":76,\"offset\":1321},\"extra\":{\"metavars\":{\"$RES\":{\"start\":{\"line\":12,\"col\":25,\"offset\":391},\"end\":{\"line\":12,\"col\":28,\"offset\":394},\"abstract_content\":\"res\"},\"$REQ\":{\"start\":{\"line\":18,\"col\":48,\"offset\":658},\"end\":{\"line\":18,\"col\":51,\"offset\":661},\"abstract_content\":\"req\"},\"$OBJ\":{\"start\":{\"line\":31,\"col\":15,\"offset\":1260},\"end\":{\"line\":31,\"col\":23,\"offset\":1268},\"abstract_content\":\"baseUser\"},\"$INDEX\":{\"start\":{\"line\":31,\"col\":15,\"offset\":1260},\"end\":{\"line\":31,\"col\":76,\"offset\":1321},\"abstract_content\":\"baseUser[field]=user?.?.data[field as keyof typeof user.data]\"}},\"message\":\"Bracket object notation with user input is present, this might allow an attacker to access all properties of the object and even it's prototype. Use literal values for object properties.\",\"metadata\":{\"confidence\":\"LOW\",\"owasp\":[\"A02:2017 - Broken Authentication\",\"A04:2021 - Insecure Design\",\"A06:2025 - Insecure Design\"],\"cwe\":[\"CWE-522: Insufficiently Protected Credentials\"],\"category\":\"security\",\"technology\":[\"express\"],\"references\":[\"https://github.com/nodesecurity/eslint-plugin-security/blob/3c7522ca1be800353513282867a1034c795d9eb4/docs/the-dangers-of-square-bracket-notation.md\"],\"cwe2021-top25\":true,\"subcategory\":