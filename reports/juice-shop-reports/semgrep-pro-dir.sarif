ions":[{"physicalLocation":{"artifactLocation":{"uri":"routes/verify.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":7,"endLine":123,"snippet":{"text":"    jwt.verify(token, security.publicKey, (err: jwt.VerifyErrors | null) => {\n      if (err === null) {\n        challengeUtils.solveIf(challenge, () => {\n          return hasAlgorithm(token, algorithm) && hasEmail(decoded as { data: { email: string } }, email)\n        })\n      }\n    })"},"startColumn":5,"startLine":117}}}],"message":{"text":"Affected versions of jsonwebtoken are vulnerable to Improper Authentication / Use Of A Broken Or Risky Cryptographic Algorithm / Improper Verification Of Cryptographic Signature. The lack of algorithm definition and a falsy secret or key in the `jwt.verify()` function can lead to signature validation bypass due to defaulting to the `none` algorithm for signature verification. Users are affected only if ALL of the following conditions are true for the `jwt.verify()` function: 1. A token with no signature is received. 2. No algorithms are specified. 3. A falsy (e.g., null, false, undefined) secret or key is passed."},"properties":{"exposure":"reachable"},"ruleId":"ssc-1803e88e-a31c-43e2-99d5-f0b14e50ba0e"},{"fingerprints":{"matchBasedId/v1":"7ef49a26cba5bbbe54aec944103d9dd3df343c47da3b9c74d62b863dab2c228c90a5f1fcaf163a22fa6666575fa770c1e3c9939cfb2e33742217162f5d6e50f5_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"routes/verify.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":7,"endLine":123,"snippet":{"text":"    jwt.verify(token, security.publicKey, (err: jwt.VerifyErrors | null) => {\n      if (err === null) {\n        challengeUtils.solveIf(challenge, () => {\n          return hasAlgorithm(token, algorithm) && hasEmail(decoded as { data: { email: string } }, email)\n        })\n      }\n    })"},"startColumn":5,"startLine":117}}}],"message":{"text":"Affected version of jsonwebtoken are vulnerable to Improper Input Validation leading to a verification bypass vulnerability. This is a result of weak validation of the JWT algorithm type, occuring when an attacker is allowed to arbitrarily specify the JWT algorithm."},"properties":{"exposure":"reachable"},"ruleId":"ssc-e273f1fa-8f9b-44e0-82f3-c1011e9bd632"},{"fingerprints":{"matchBasedId/v1":"e4b02808f1038a915ab7df4473e7c597698ea1457a76d1f78398678d11b9ead64f6e3acee2f93e5a31b40d2ae234bdfa608e03426cd5bf8e7d0bb76c60ddbcb1_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"routes/videoHandler.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":94,"endLine":58,"snippet":{"text":"      challengeUtils.solveIf(challenges.videoXssChallenge, () => { return utils.contains(subs, '</script><script>alert(`xss`)</script>') })"},"startColumn":90,"startLine":58}}}],"message":{"text":"Cannot determine what 'subs' is and it is used with a '<script>' tag. This could be susceptible to cross-site scripting (XSS). Ensure 'subs' is not externally controlled, or sanitize this data."},"properties":{},"ruleId":"javascript.lang.security.audit.unknown-value-with-script-tag.unknown-value-with-script-tag"},{"fingerprints":{"matchBasedId/v1":"fde17572f3af182fa82133427aa273d2a1448e390f9c14557d65eab9120e1cb862201465a25eb17cc7e5426f93bf534e942e56742437bb896fb0b32f8e25b6b0_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"routes/videoHandler.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":169,"endLine":71,"snippet":{"text":"      compiledTemplate = compiledTemplate.replace('<script id=\"subtitle\"></script>', '<script id=\"subtitle\" type=\"text/vtt\" data-label=\"English\" data-lang=\"en\">' + subs + '</script>')"},"startColumn":165,"startLine":71}}}],"message":{"text":"Cannot determine what 'subs' is and it is used with a '<script>' tag. This could be susceptible to cross-site scripting (XSS). Ensure 'subs' is not externally controlled, or sanitize this data."},"properties":{},"ruleId":"javascript.lang.security.audit.unknown-value-with-script-tag.unknown-value-with-sc