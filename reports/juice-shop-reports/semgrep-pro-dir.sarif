E9\",\"rv_id\":1263104,\"url\":\"https://semgrep.dev/playground/r/l4TJR1L/javascript.audit.detect-replaceall-sanitization.detect-replaceall-sanitization\",\"version_id\":\"l4TJR1L\"}}},\"severity\":\"INFO\",\"fingerprint\":\"9fa5d4f9ee838f516fa47960eb756794dfa777c774e9b39aded42ac966208474faecc33edc588d26a35971045219cf6f2c9258803477f4060d0b970fff080f7f_0\",\"lines\":\"      tableData[i].description = tableData[i].description.replaceAll('<', '&lt;').replaceAll('>', '&gt;')\",\"is_ignored\":false,\"validation_state\":\"NO_VALIDATOR\",\"engine_kind\":\"PRO\"}},{\"check_id\":\"javascript.audit.detect-replaceall-sanitization.detect-replaceall-sanitization\",\"path\":\"data/static/codefixes/restfulXssChallenge_2.ts\",\"start\":{\"line\":49,\"col\":34,\"offset\":1827},\"end\":{\"line\":49,\"col\":106,\"offset\":1899},\"extra\":{\"metavars\":{\"$1\":{\"start\":{\"line\":1,\"col\":1,\"offset\":0},\"end\":{\"line\":1,\"col\":8,\"offset\":7},\"abstract_content\":\"replace\"},\"$STR\":{\"start\":{\"line\":49,\"col\":34,\"offset\":1827},\"end\":{\"line\":49,\"col\":82,\"offset\":1875},\"abstract_content\":\"tableData[i].description.replaceAll('<''&lt;')\"},\"$FUNC\":{\"start\":{\"line\":49,\"col\":83,\"offset\":1876},\"end\":{\"line\":49,\"col\":93,\"offset\":1886},\"abstract_content\":\"replaceAll\"}},\"message\":\"Detected a call to `replaceAll()` in an attempt to HTML escape the string `tableData[i].description.replaceAll('<', '&lt;')`. Manually sanitizing input through a manually built list can be circumvented in many situations, and it's better to use a well known sanitization library such as `sanitize-html` or `DOMPurify`.\",\"metadata\":{\"category\":\"security\",\"technology\":[\"javascript\",\"typescript\"],\"owasp\":[\"A07:2017 - Cross-Site Scripting (XSS)\",\"A03:2021 - Injection\",\"A05:2025 - Injection\"],\"cwe\":[\"CWE-79: Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')\"],\"references\":[\"https://www.npmjs.com/package/dompurify