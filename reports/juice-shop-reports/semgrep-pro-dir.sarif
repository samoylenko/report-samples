ource::url-path-params::express\",\"web::source::url-query-string::express\"],\"owasp\":[\"A01:2017 - Injection\",\"A03:2021 - Injection\",\"A05:2025 - Injection\"],\"references\":[\"https://owasp.org/Top10/2025/A05_2025-Injection/\",\"https://owasp.org/Top10/A03_2021-Injection\"],\"supersedes\":[\"javascript.sequelize.security.audit.sequelize-injection-express.express-sequelize-injection\",\"javascript.sequelize.security.audit.sequelize-raw-query.sequelize-raw-query\"],\"technology\":[\"express\",\"nodejs\",\"sequelize\",\"web\"],\"license\":\"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license\",\"vulnerability_class\":[\"SQL Injection\"],\"source\":\"https://semgrep.dev/r/javascript.express.db.sequelize-express.sequelize-express\",\"shortlink\":\"https://sg.run/6JKdw\",\"semgrep.dev\":{\"rule\":{\"origin\":\"pro_rules\",\"r_id\":146159,\"rule_id\":\"lBU4EeD\",\"rv_id\":1236612,\"url\":\"https://semgrep.dev/playground/r/NdTzE7y/javascript.express.db.sequelize-express.sequelize-express\",\"version_id\":\"NdTzE7y\"}}},\"severity\":\"CRITICAL\",\"fingerprint\":\"000a8a8919de9202c38c2cc6d090878fd720120effdccc32891f6267497ba6bcc15e213d7eeb70292eebb68f5dab506a3597c6cb0f37b2f2403f90a3cae6f9cd_0\",\"lines\":\"    models.sequelize.query(`SELECT * FROM Users WHERE email = '${req.body.email || ''}' AND password = '${security.hash(req.body.password || '')}' AND deletedAt IS NULL`, { model: UserModel, plain: true }) // vuln-code-snippet vuln-line loginAdminChallenge loginBenderChallenge loginJimChallenge\",\"is_ignored\":false,\"validation_state\":\"NO_VALIDATOR\",\"dataflow_trace\":{\"taint_source\":[\"CliLoc\",[{\"path\":\"routes/login.ts\",\"start\":{\"line\":34,\"col\":66,\"offset\":1497},\"end\":{\"line\":34,\"col\":69,\"offset\":1500}},\"req\"]],\"intermediate_vars\":[],\"taint_sink\":[\"CliLoc\",[{\"path\":\"routes/login.ts\",\"start\":{\"line\":34,\"col\":28,\"offset\":1459},\"end\":{\"line\":34,\"col\":169,\"offset\":1600}},\"`SELECT * 