on\"],\"references\":[\"https://owasp.org/www-pdf-archive/GOD16-NOSQL.pdf\"],\"technology\":[\"express\",\"nodejs\",\"mongodb\"],\"license\":\"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license\",\"vulnerability_class\":[\"Improper Validation\"],\"source\":\"https://semgrep.dev/r/javascript.express.mongodb.express-mongo-nosqli.express-mongo-nosqli\",\"shortlink\":\"https://sg.run/Qqxq\",\"semgrep.dev\":{\"rule\":{\"origin\":\"pro_rules\",\"r_id\":28086,\"rule_id\":\"WAUqgq\",\"rv_id\":1152332,\"url\":\"https://semgrep.dev/playground/r/rxT4BDn/javascript.express.mongodb.express-mongo-nosqli.express-mongo-nosqli\",\"version_id\":\"rxT4BDn\"}}},\"severity\":\"CRITICAL\",\"fingerprint\":\"8e3b44dc7f576cef89b53e810ccdcabfb4bc7f7f233cdf7f7538dd6d558d21710d5ab86d21e6416592bc5e19b41ae3a1247e9a032fe714745bf18fc9127ec25a_0\",\"lines\":\"    await ordersCollection.update({ _id: req.params.id }, { $set: { delivered: deliveryStatus, eta } })\",\"is_ignored\":false,\"validation_state\":\"NO_VALIDATOR\",\"dataflow_trace\":{\"taint_source\":[\"CliLoc\",[{\"path\":\"routes/orderHistory.ts\",\"start\":{\"line\":36,\"col\":42,\"offset\":1388},\"end\":{\"line\":36,\"col\":52,\"offset\":1398}},\"req.params\"]],\"intermediate_vars\":[],\"taint_sink\":[\"CliLoc\",[{\"path\":\"routes/orderHistory.ts\",\"start\":{\"line\":36,\"col\":35,\"offset\":1381},\"end\":{\"line\":36,\"col\":57,\"offset\":1403}},\"{ _id: req.params.id }\"]]},\"engine_kind\":\"PRO\"}},{\"check_id\":\"javascript.express.file.fs-express.fs-express\",\"path\":\"routes/profileImageFileUpload.ts\",\"start\":{\"line\":43,\"col\":26,\"offset\":1528},\"end\":{\"line\":43,\"col\":34,\"offset\":1536},\"extra\":{\"metavars\":{\"$1\":{\"start\":{\"line\":1,\"col\":1,\"offset\":0},\"end\":{\"line\":1,\"col\":6,\"offset\":5},\"abstract_content\":\"write\"},\"$EXPRESS\":{\"start\":{\"line\":16,\"col\":22,\"offset\":490},\"end\":{\"line\":16,\"col\":29,\"offset\":497},\"abstract_content\":\"Request\"},\"$REQ\":{\"start\":{\"line\":35,\"col\":58,\"offset\":1225},\"end\":{\"line\":35,\"col\":61,\"offset\":1228},\"abstract_content\":\"req\"},\"$PKG\":{\"start\":{\"line\":43,\"col\":13,\"offset\":1515},\"end\":{\"line\":43,\"col\":15,\"offset\":1517},\"abstract_content\":\"fs\"},\"$FUNC\":{\"start\":{\"line\":43,\"col\":16,\"offset\":1518},\"end\":{\"line\":43,\"col\":25,\"offset\":1527},\"abstract_content\":\"writeFile\"},\"$SINK\":{\"start\":{\"line\":43,\"col\":26,\"offset\":1528},\"end\":{\"line\":43,\"col\":34,\"offset\":1536},\"abstract_content\":\"filePath\",\"propagated_value\":{\"svalue_start\":{\"line\":41,\"col\":22,\"offset\":1391},\"svalue_end\":{\"line\":41,\"col\":121,\"offset\":1490},\"svalue_abstract_content\":\"`frontend/dist/frontend/assets/public/images/uploads/loggedInUser.data.id.uploadedFileType.ext\"}}},\"message\":\"The application builds a file path from potentially untrusted data, which can lead to a path traversal vulnerability. An attacker can manipulate the path which the application uses to access files. If the application does not validate user input and sanitize file paths, sensitive files such as configuration or user data can be accessed, potentially creating or overwriting files. To prevent this vulnerability, validate and sanitize any input that is used to create references to file paths. Also, enforce strict file access controls. For example, choose privileges allowing public-facing applications to access only the required files.\",\"metadata\":{\"likelihood\":\"MEDIUM\",\"impact\":\"HIGH\",\"confidence\":\"HIGH\",\"category\":\"security\",\"subcategory\":[\"vuln\"],\"cwe\":[\"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')\"],\"cwe2020-top25\":true,\"cwe2021-top25\":true,\"cwe2022-top25\":true,\"display-name\":\"Path Traversal in fs with Express\",\"functional-categories\":[\"file::sink::file-access::fs\",\"file::sink::file-access::fs/promises\",\"file::sink::file-access::node:fs\",\"file::