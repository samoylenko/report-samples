-value.detected-aws-access-key-id-value"},{"fingerprints":{"matchBasedId/v1":"b6f9e8272977da84e82418b9545be0cbb720a1a2f17ce0275d8e8b42294d4a6c3444c6eb85421d2316ccddd028cce51c9aed2f4fbabc065b78af9021d1dc139c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"reports/semgrep-oss-dir.json","uriBaseId":"%SRCROOT%"},"region":{"endColumn":40244,"endLine":1,"snippet":{"text":"{\"version\":\"1.157.0\",\"results\":[{\"check_id\":\"javascript.node-stdlib.cryptography.crypto-weak-algorithm.crypto-weak-algorithm\",\"path\":\"Gruntfile.js\",\"start\":{\"line\":77,\"col\":37,\"offset\":2372},\"end\":{\"line\":77,\"col\":42,\"offset\":2377},\"extra\":{\"metavars\":{\"$1\":{\"start\":{\"line\":1,\"col\":1,\"offset\":0},\"end\":{\"line\":1,\"col\":5,\"offset\":4},\"abstract_content\":\"'md5\"},\"$CRYPTO\":{\"start\":{\"line\":77,\"col\":19,\"offset\":2354},\"end\":{\"line\":77,\"col\":25,\"offset\":2360},\"abstract_content\":\"crypto\",\"propagated_value\":{\"svalue_start\":{\"line\":74,\"col\":20,\"offset\":2214},\"svalue_end\":{\"line\":74,\"col\":42,\"offset\":2236},\"svalue_abstract_content\":\"require('node:crypto')\"}},\"$ALG\":{\"start\":{\"line\":77,\"col\":37,\"offset\":2372},\"end\":{\"line\":77,\"col\":42,\"offset\":2377},\"abstract_content\":\"'md5'\"},\"$SINK\":{\"start\":{\"line\":77,\"col\":37,\"offset\":2372},\"end\":{\"line\":77,\"col\":42,\"offset\":2377},\"abstract_content\":\"'md5'\"}},\"message\":\"The use of a weak cryptographic algorithm (e.g., SHA-1 or MD5) has been identified. These algorithms are considered insecure due to vulnerabilities that make them susceptible to collision attacks, allowing attackers to compromise data integrity or security. Replace SHA-1 or MD5 with secure hashing algorithms, such as: SHA-256 or higher (e.g., SHA-3).\",\"metadata\":{\"likelihood\":\"LOW\",\"impact\":\"HIGH\",\"confidence\":\"HIGH\",\"category\":\"security\",\"subcategory\":[\"vuln\"],\"cwe\":[\"CWE-327: Use of a Broken or Risky Cryptographic Algorithm\"],\"display-name\":\"Use of a Broken or Risky Cryptographic Algorithm\",\"functional-categories\":[\"crypto::search::randomness::crypto\",\"crypto::search::randomness::webcrypto\"],\"owasp\":[\"A02:2021 - Cryptographic Failures\",\"A03:2017 - Sensitive Data Exposure\",\"A04:2025 - Cryptographic Failures\"],\"references\":[\"https://owasp.org/Top10/2025/A04_2025-Cryptographic_Failures/\",\"https://owasp.org/Top10/A02_2021-Cryptographic_Failures\"],\"technology\":[\"WebCryptoAPI\",\"crypto\",\"node\",\"webcrypto\"],\"license\":\"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license\",\"vulnerability_class\":[\"Cryptographic Issues\"],\"source\":\"https://semgrep.dev/r/javascript.node-stdlib.cryptography.crypto-weak-algorithm.crypto-weak-algorithm\",\"shortlink\":\"https://sg.run/nJgp1\",\"semgrep.dev\":{\"rule\":{\"origin\":\"pro_rules\",\"r_id\":156180,\"rule_id\":\"ZqUQAnR\",\"rv_id\":1236788,\"url\":\"https://semgrep.dev/playground/r/PkTRK33/javascript.node-stdlib.cryptography.crypto-weak-algorithm.crypto-weak-algorithm\",\"version_id\":\"PkTRK33\"}}},\"severity\":\"WARNING\",\"fingerprint\":\"71b091f459723c0b5f482f5d7fb999766d6265920cae18280ddbfedba320654e228219c08e72aa6dfe5629ab05f3440435777658f03afd38fa2fed576db17791_0\",\"lines\":\"      const md5 = crypto.createHash('md5')\",\"is_ignored\":false,\"validation_state\":\"NO_VALIDATOR\",\"dataflow_trace\":{\"taint_source\":[\"CliLoc\",[{\"path\":\"Gruntfile.js\",\"start\":{\"line\":77,\"col\":37,\"offset\":2372},\"end\":{\"line\":77,\"col\":42,\"offset\":2377}},\"'md5'\"]],\"intermediate_vars\":[],\"taint_sink\":[\"CliLoc\",[{\"path\":\"Gruntfile.js\",\"start\":{\"line\":77,\"col\":37,\"offset\":2372},\"end\":{\"line\":77,\"col\":42,\"offset\":2377}},\"'md5'\"]]},\"engine_kind\":\"PRO\"}},{\"check_id\":\"javascript.express.db.sequelize-express.sequelize-express\",\"path\":\"data/static/codefixes/dbSchemaChallenge_1.ts\",\"start\":{\"line\":5,\"col\":28,\"offset\":284},\"end\":{\"line\":5,\"col\":162,\"offset\":418},\"extra\":{\"metavars\":{\"$REQ\":{\"start\":{\"line\":3,\"col\":60,\"offset\":159},\"end\":{\"line\":3,\"col\":63,\"offset\":162},\"abstract_content\":\"req\"},\"$DB\":{\"start\":{\"line\":5,\"col\":5,\"offset\":261},\"end\":{\"line\":5,\"col\":11,\"offset\":267},\"abstract_content\":\"models\"},\"$SINK\":{\"start\":{\"line\":5,\"col\":28,\"offset\":284},\"end\":{\"line\":5,\"col\":162,\"offset\":418},\"abstract_content\":\"\\\"SELECT * FROM Products WHERE ((name LIKE '%\\\"+criteria+\\\"%' OR description LIKE '%\\\"+criteria+\\\"%') AND deletedAt IS NULL) ORDER BY name\\\"\"}},\"message\":\"Untrusted input might be used to build a database query, which can lead to a SQL injection vulnerability. An attacker can execute malicious SQL statements and gain unauthorized access to sensitive data, modify, delete data, or execute arbitrary system commands. To prevent this vulnerability, use prepared statements that do not concatenate user-controllable strings and use parameterized queries where SQL commands and user data are strictly separated. Also, consider using an object-relational (ORM) framework to operate with safer abstractions.\",\"metadata\":{\"likelihood\":\"HIGH\",\"impact\":\"HIGH\",\"confidence\":\"HIGH\",\"category\":\"security\",\"subcategory\":[\"vuln\"],\"cwe\":[\"CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')\"],\"cwe2020-top25\":true,\"cwe2021-top25\":true,\"cwe2022-top25\":true,\"display-name\":\"SQL Injection in Sequelize with Express\",\"functional-categories\":[\"db::sink::query::sequelize\",\"web::source::cookie::express\",\"web::source::form-data::express\",\"web::source::header::express\",\"web::source::http-body::express\",\"web::source::url-path-params::express\",\"web::source::url-query-string::express\"],\"owasp\":[\"A01:2017 - Injection\",\"A03:2021 - Injection\",\"A05:2025 - Injection\"],\"references\":[\"https://owasp.org/Top10/2025/A05_2025-Injection/\",\"https://owasp.org/Top10/A03_2021-Injection\"],\"supersedes\":[\"javascript.sequelize.security.audit.sequelize-injection-express.express-sequelize-injection\",\"javascript.sequelize.security.audit.sequelize-raw-query.sequelize-raw-query\"],\"technology\":[\"express\",\"nodejs\",\"sequelize\",\"web\"],\"license\":\"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license\",\"vulnerability_class\":[\"SQL Injection\"],\"source\":\"https://semgrep.dev/r/javascript.express.db.sequelize-express.sequelize-express\",\"shortlink\":\"https://sg.run/6JKdw\",\"semgrep.dev\":{\"rule\":{\"origin\":\"pro_rules\",\"r_id\":146159,\"rule_id\":\"lBU4EeD\",\"rv_id\":1236612,\"url\":\"https://semgrep.dev/playground/r/NdTzE7y/javascript.express.db.sequelize-express.sequelize-express\",\"version_id\":\"NdTzE7y\"}}},\"severity\":\"CRITICAL\",\"fingerprint\":\"d2b695bb65c0170aeb8faad17663e522ce7b44a45a9390fec15469762f4c92cd8dad8218ec051302ecceb97c0091d19f3580a6c7651c544fa287d0fdb679fb43_0\",\"lines\":\"    models.sequelize.query(\\\"SELECT * FROM Products WHERE ((name LIKE '%\\\"+criteria+\\\"%' OR description LIKE '%\\\"+criteria+\\\"%') AND deletedAt IS NULL) ORDER BY name\\\")\",\"is_ignored\":false,\"validation_state\":\"NO_VALIDATOR\",\"dataflow_trace\":{\"taint_source\":[\"CliLoc\",[{\"path\":\"data/static/codefixes/dbSchemaChallenge_1.ts\",\"start\":{\"line\":3,\"col\":60,\"offset\":159},\"end\":{\"line\":3,\"col\":63,\"offset\":162}},\"req\"]],\"intermediate_vars\":[{\"location\":{\"path\":\"data/static/codefixes/dbSchemaChallenge_1.ts\",\"start\":{\"line\":3,\"col\":9,\"offset\":108},\"end\":{\"line\":3,\"col\":17,\"offset\":116}},\"content\":\"criteria\"},{\"location\":{\"path\":\"data/static/codefixes/dbSchemaChallenge_1.ts\",\"start\":{\"line\":4,\"col\":5,\"offset\":181},\"end\":{\"line\":4,\"col\":13,\"offset\":189}},\"content\":\"criteria\"}],\"taint_sink\":[\"CliLoc\",[{\"path\":\"data/static/codefixes/dbSchemaChallenge_1.ts\",\"start\":{\"line\":5,\"col\"