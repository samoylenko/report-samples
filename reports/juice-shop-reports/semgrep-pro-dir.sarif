 const hmac = (data: string) => crypto.createHmac('sha256', 'pa4qacea4VK9t9nGv7yZtwmj').update(data).digest('hex')\",\"is_ignored\":false,\"validation_state\":\"NO_VALIDATOR\",\"engine_kind\":\"PRO\"}},{\"check_id\":\"javascript.jsonwebtoken.security.jwt-hardcode.hardcoded-jwt-secret\",\"path\":\"lib/insecurity.ts\",\"start\":{\"line\":56,\"col\":56,\"offset\":2827},\"end\":{\"line\":56,\"col\":66,\"offset\":2837},\"extra\":{\"metavars\":{\"$X\":{\"start\":{\"line\":23,\"col\":7,\"offset\":815},\"end\":{\"line\":23,\"col\":17,\"offset\":825},\"abstract_content\":\"privateKey\"},\"$Y\":{\"start\":{\"line\":23,\"col\":21,\"offset\":829},\"end\":{\"line\":23,\"col\":901,\"offset\":1709},\"abstract_content\":\"-----BEGIN RSA PRIVATE KEY-----\\\\r\\\\\\\\r\\\\n-----END RSA PRIVATE KEY-----\"},\"$JWT\":{\"start\":{\"line\":56,\"col\":41,\"offset\":2812},\"end\":{\"line\":56,\"col\":44,\"offset\":2815},\"abstract_content\":\"jwt\"},\"$DATA\":{\"start\":{\"line\":56,\"col\":50,\"offset\":2821},\"end\":{\"line\":56,\"col\":54,\"offset\":2825},\"abstract_content\":\"user\"},\"$VALUE\":{\"start\":{\"line\":56,\"col\":56,\"offset\":2827},\"end\":{\"line\":56,\"col\":66,\"offset\":2837},\"abstract_content\":\"privateKey\",\"propagated_value\":{\"svalue_start\":{\"line\":23,\"col\":20,\"offset\":828},\"svalue_end\":{\"line\":23,\"col\":902,\"offset\":1710},\"svalue_abstract_content\":\"'-----BEGIN RSA PRIVATE KEY-----\\\\r\\\\\\\\r\\\\n-----END RSA PRIVATE KEY-----'\"}}},\"message\":\"A hard-coded credential was detected. It is not recommended to store credentials in source-code, as this risks secrets being leaked and used by either an internal or external malicious adversary. It is recommended to use environment variables to securely provide credentials or retrieve credentials from a secure vault or HSM (Hardware Security Module).\",\"metadata\":{\"cwe\":[\"CWE-798: Use of Hard-coded Credentials\"],\"references\":[\"https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Manageme