          "message": {
            "text": "Vulnerability    :CVE-2025-13465                                                       \nSeverity         :MEDIUM                                                               \nPackage          :pkg:npm/lodash@4.17.20                                               \nAffected range   :>=4.0.0,<=4.17.22                                                    \nFixed version    :4.17.23                                                              \nCVSS Score       :6.9                                                                  \nCVSS Vector      :CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:L/VA:L/SC:H/SI:H/SA:H/E:P  \nEPSS Score       :0.000250                                                             \nEPSS Percentile  :0.067010                                                             \n"
