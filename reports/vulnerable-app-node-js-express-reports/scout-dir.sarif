          "message": {
            "text": "Vulnerability    :CVE-2020-28500                                \nSeverity         :MEDIUM                                        \nPackage          :pkg:npm/lodash@4.17.20                        \nAffected range   :>=4.0.0,<4.17.21                              \nFixed version    :4.17.21                                       \nCVSS Score       :5.3                                           \nCVSS Vector      :CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L  \nEPSS Score       :0.002450                                      \nEPSS Percentile  :0.474840                                      \n"
          },
